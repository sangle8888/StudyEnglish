@model StudyEnglish.Models.Vocabulary.StudentVocabIndexViewModel
@{
    ViewData["Title"] = "Từ vựng - Vocabulary";
    Layout = "~/Views/Shared/_LayoutSidebar.cshtml";

    var learnedWords = Model?.LearnedWords ?? 0;
    var totalWords = Model?.TotalWords ?? 4514;
    var learningWords = Model?.LearningWords ?? 0;
    var masteredWords = Model?.MasteredWords ?? 0;
    var globalPercent = totalWords > 0 ? (int)Math.Round((double)learnedWords * 100 / totalWords) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/Vocabulary/vocabulary-main.css" asp-append-version="true" />
}

      <main id="dashboardMain" class="flex-1 flex flex-col gap-5 min-w-0">
        <!-- [MAIN 1/8] TIÊU ĐỀ TRANG + THỐNG KÊ NHANH -->
        <div class="flex flex-col gap-2 px-1">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span
                class="topic-card-icon grid h-9 w-9 place-items-center rounded-xl bg-fuchsia-500 text-white shadow-md shadow-fuchsia-500/25"><svg
                  xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="lucide lucide-book-open"><path d="M12 7v14"></path><path
                    d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span>
              <h2
                class="text-2xl font-extrabold text-slate-900 dark:text-white">Từ
                vựng</h2>
            </div>
            <p id="vocabGlobalStatsText" class="text-xs font-semibold text-slate-500 dark:text-slate-400">Đã
              học <strong id="vocabStatLearned" class="text-fuchsia-600 dark:text-fuchsia-400">@learnedWords/@totalWords
                từ</strong> · Đang học <span id="vocabStatLearning">@learningWords</span> · Đã thuộc <span id="vocabStatMastered">@masteredWords</span></p>
          </div>
          <!-- Thanh kinh nghiệm / tiến độ tổng -->
          <div class="w-full h-1.5 overflow-hidden rounded-full bg-slate-200/80 dark:bg-slate-700/80">
            <div id="vocabGlobalProgressBar"
              class="h-full rounded-full bg-gradient-to-r from-fuchsia-500 to-pink-500 transition-all duration-500"
              style="width: @globalPercent%"></div>
          </div>
        </div>

        <!-- [MAIN 2/8] 3 THẺ TỔNG QUAN -->
        <section class="grid grid-cols-2 gap-3 lg:grid-cols-3"
          aria-label="Tổng quan từ vựng">
          <article
            class="order-first col-span-2 flex min-w-0 flex-col gap-3 rounded-[24px] border-2 border-vocab-review/40 bg-card/95 p-4 shadow-soft sm:p-5 lg:order-none lg:col-span-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class="inline-flex min-w-0 items-center gap-2 font-display text-base font-bold text-foreground">
                <span
                  class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-vocab-review-soft text-vocab-review">
                  <i data-lucide="repeat" aria-hidden="true"></i>
                </span>
                <span class="truncate">Ôn tập</span>
              </span>
              <span
                class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-bold text-foreground dark:bg-slate-700 dark:text-slate-100">Nên
                làm trước</span>
            </div>
            <div id="reviewDueSummary"
              class="min-w-0 flex-1 text-xs text-muted-foreground sm:text-sm">
              @if ((Model?.DueReviewCount ?? 0) > 0)
              {
                <span class="font-bold text-amber-600 dark:text-amber-400">Có @(Model?.DueReviewCount) từ cần ôn lại</span>
              }
              else
              {
                <span>Không có từ đã học cần ôn</span>
              }
            </div>
            <button id="startReviewButton" type="button"
              class="inline-flex items-center justify-center gap-2 whitespace-nowrap transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 active:scale-[0.98] motion-reduce:active:scale-100 [&_svg]:size-4 [&_svg]:shrink-0 hover:bg-primary/90 h-11 px-6 text-base min-h-11 w-full rounded-2xl font-bold bg-spectrum text-white shadow-playful hover:opacity-95"
              @((Model?.DueReviewCount ?? 0) == 0 ? "disabled" : "")>Ôn
              tập
              ngay</button>
          </article>
          <article
            class="flex min-w-0 flex-col gap-3 rounded-[24px] border-2 border-vocab-learn/45 bg-card/95 p-4 shadow-soft sm:p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class="inline-flex min-w-0 items-center gap-2 font-display text-base font-bold text-foreground">
                <span
                  class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-vocab-learn-soft text-vocab-learn">
                  <i data-lucide="sparkles"
                    aria-hidden="true"></i>
                </span>
                <span class="truncate">Học từ mới</span>
              </span>
            </div>
            <div
              class="min-w-0 flex-1 text-xs text-muted-foreground sm:text-sm">
              <span class="block" id="learnNewTodayCount">@(Model?.NewWordsToday ?? 0)/@(Model?.NewWordsGoal ?? 10) từ mới hôm nay</span>
              <span class="block truncate" id="learnNextTopicText">Tiếp theo: @(Model?.NextTopicTitle ?? "Contracts")</span>
            </div>
            <button type="button" data-scroll-topics id="startLearnNewButton"
              class="inline-flex h-11 min-h-11 w-full items-center justify-center gap-2 rounded-2xl bg-gradient-vocab-learn px-6 text-base font-bold text-white shadow-lg shadow-vocab-learn/25 transition-all hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Học
              tiếp</button>
          </article>
          <article
            class="flex min-w-0 flex-col gap-3 rounded-[24px] border-2 border-vocab-notebook/45 bg-card/95 p-4 shadow-soft sm:p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class="inline-flex min-w-0 items-center gap-2 font-display text-base font-bold text-foreground">
                <span
                  class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-vocab-notebook-soft text-vocab-notebook">
                  <i data-lucide="bookmark" aria-hidden="true"></i>
                </span>
                <span class="truncate">Sổ tay</span>
              </span>
            </div>
            <div
              class="min-w-0 flex-1 text-xs text-muted-foreground sm:text-sm">
              @if ((Model?.SavedNotebookCount ?? 0) > 0)
              {
                <span class="font-bold text-amber-600 dark:text-amber-400">Đã lưu @(Model?.SavedNotebookCount) từ</span>
              }
              else
              {
                <span>Chưa lưu từ nào</span>
              }
            </div>
            <button type="button" data-open-tab="notebook"
              class="inline-flex h-11 min-h-11 w-full items-center justify-center gap-2 rounded-2xl bg-gradient-vocab-notebook px-6 text-base font-bold text-white shadow-lg shadow-vocab-notebook/25 transition-all hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Mở
              sổ tay</button>
          </article>
        </section>

        @if (!string.IsNullOrEmpty(Model?.BannerNotice))
        {
          <!-- Banner thông điệp học tập do Admin thiết lập -->
          <div class="flex items-center gap-3 rounded-2xl border border-fuchsia-200/80 bg-fuchsia-50/80 p-3 text-xs sm:text-sm text-fuchsia-900 shadow-sm dark:border-fuchsia-900/50 dark:bg-fuchsia-950/40 dark:text-fuchsia-200">
            <i data-lucide="megaphone" class="text-fuchsia-600 dark:text-fuchsia-400 text-base"></i>
            <span class="font-semibold">@Model.BannerNotice</span>
          </div>
        }

        <!-- [MAIN 3/8] THANH CÔNG CỤ: 4 TAB + Ô TÌM KIẾM + BỘ LỌC -->
        <section
          class="rounded-[26px] border border-slate-200/70 bg-white/95 p-1.5 shadow-soft dark:border-slate-700/70 dark:bg-slate-900/90"
          aria-label="Công cụ học từ vựng">
          <div class="grid grid-cols-4 gap-1.5"
            role="tablist" aria-label="Các mục của Từ vựng">
            <button type="button"
              class="vocab-tab flex min-w-0 min-h-12 flex-col items-center justify-center gap-0.5 rounded-2xl border border-emerald-500/60 bg-gradient-to-br from-emerald-50 to-emerald-100/60 px-1 py-1.5 text-[11px] font-bold text-slate-800 shadow-sm shadow-emerald-500/20 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:from-emerald-500/20 dark:to-emerald-900/20 dark:text-white sm:flex-row sm:gap-2 sm:px-3 sm:text-sm"
              data-tab="flashcards" role="tab" aria-selected="true"
              aria-label="Học thẻ">
              <i
                data-lucide="layers" class="shrink-0 text-emerald-600 dark:text-emerald-300"
                aria-hidden="true"></i>
              <span class="max-w-full truncate">Học thẻ</span>
            </button>
            <button type="button"
              class="vocab-tab flex min-w-0 min-h-12 flex-col items-center justify-center gap-0.5 rounded-2xl border border-cyan-500/25 bg-cyan-50 px-1 py-1.5 text-[11px] font-semibold text-slate-800 transition hover:bg-cyan-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:bg-cyan-500/10 dark:text-slate-100 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm"
              data-tab="phrases" role="tab" aria-selected="false"
              aria-label="Ghép cụm từ">
              <i
                data-lucide="link" class="shrink-0 text-cyan-600 dark:text-cyan-300"
                aria-hidden="true"></i>
              <span class="truncate sm:hidden">Ghép</span><span
                class="hidden truncate sm:inline">Ghép cụm từ</span>
            </button>
            <button type="button"
              class="vocab-tab flex min-w-0 min-h-12 flex-col items-center justify-center gap-0.5 rounded-2xl border border-fuchsia-500/25 bg-fuchsia-50 px-1 py-1.5 text-[11px] font-semibold text-slate-800 transition hover:bg-fuchsia-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:bg-fuchsia-500/10 dark:text-slate-100 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm"
              data-tab="learned" role="tab" aria-selected="false"
              aria-label="Sổ từ đã học (@learnedWords)">
              <i
                data-lucide="save" class="shrink-0 text-fuchsia-600 dark:text-fuchsia-300"
                aria-hidden="true"></i>
              <span class="truncate sm:hidden">Đã học</span><span
                class="hidden truncate sm:inline">Sổ từ đã học</span>
              <span
                class="hidden rounded-full bg-white/80 px-1.5 text-[11px] font-bold tabular-nums text-slate-800 sm:inline dark:bg-slate-800 dark:text-white">@learnedWords</span>
            </button>
            <button type="button"
              class="vocab-tab flex min-w-0 min-h-12 flex-col items-center justify-center gap-0.5 rounded-2xl border border-amber-500/25 bg-amber-50 px-1 py-1.5 text-[11px] font-semibold text-slate-800 transition hover:bg-amber-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:bg-amber-500/10 dark:text-slate-100 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm"
              data-tab="notebook" role="tab" aria-selected="false"
              aria-label="Sổ tay từ vựng (@(Model?.SavedNotebookCount ?? 0))">
              <i
                data-lucide="bookmark" class="shrink-0 text-amber-600 dark:text-amber-300"
                aria-hidden="true"></i>
              <span class="truncate sm:hidden">Sổ tay</span><span
                class="hidden truncate sm:inline">Sổ tay từ vựng</span>
              <span
                class="hidden rounded-full bg-white/80 px-1.5 text-[11px] font-bold tabular-nums text-slate-800 sm:inline dark:bg-slate-800 dark:text-white">@(Model?.SavedNotebookCount ?? 0)</span>
            </button>
          </div>
          <div id="vocabCatalogFilters"
            class="mt-1.5 border-t border-slate-200/70 px-1.5 pb-1.5 pt-3 dark:border-slate-700/70 sm:px-2.5">
            <div
              class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
              <div
                class="flex min-w-0 items-start gap-2 lg:w-full lg:max-w-[420px]">
                <label class="relative min-w-0 flex-1">
                  <span class="sr-only">Tìm từ vựng</span>
                  <i
                    data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                    aria-hidden="true"></i>
                  <input id="vocabSearch" type="search"
                    placeholder="Tìm từ vựng..."
                    class="h-11 w-full rounded-2xl border border-slate-200 bg-white/80 pl-10 pr-4 text-sm text-slate-700 outline-none transition-colors placeholder:text-slate-400 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100 dark:focus:ring-emerald-900/40 sm:h-12">
                </label>
                <button id="vocabFilterToggle" type="button"
                  aria-expanded="false" aria-controls="vocabFilterOptions"
                  class="inline-flex h-11 shrink-0 items-center gap-1.5 rounded-2xl border border-slate-200 bg-white/80 px-3 text-sm font-semibold text-slate-800 shadow-sm transition-colors dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100 sm:h-12 lg:hidden">
                  <i data-lucide="sliders-horizontal" aria-hidden="true"></i><span>Bộ
                    lọc</span>
                </button>
              </div>
              <div id="vocabFilterOptions"
                class="hidden flex-wrap items-center gap-2 lg:flex">
                <label><span class="sr-only">Kỳ thi</span><select
                    class="h-11 cursor-pointer rounded-2xl border border-slate-200 bg-white/85 px-3.5 text-sm font-semibold text-slate-700 outline-none dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 sm:h-12"><option>TOEIC</option><option>IELTS</option></select></label>
                <label><span class="sr-only">Kiểu từ vựng</span><select
                    class="h-11 cursor-pointer rounded-2xl border border-slate-200 bg-white/85 px-3.5 text-sm font-semibold text-slate-700 outline-none dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 sm:h-12"><option>TOEIC
                      theo chủ đề</option><option>TOEIC thường
                      gặp</option></select></label>
                <label><span class="sr-only">Nhóm từ vựng</span><select
                    id="vocabTopicFilter"
                    class="h-11 max-w-full cursor-pointer rounded-2xl border border-slate-200 bg-white/85 px-3.5 text-sm font-semibold text-slate-700 outline-none dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 sm:h-12">
                    <option value="all">Tất cả nhóm</option>
                    @if (Model?.Groups != null)
                    {
                      foreach (var g in Model.Groups)
                      {
                        <option value="@g.GroupCode">@g.GroupName</option>
                      }
                    }
                  </select></label>
              </div>
            </div>
          </div>
        </section>

        <!-- [MAIN 4/8] DANH SÁCH BỘ TỪ THEO CHỦ ĐỀ  #vocabTopics → Partial: _VocabGroupList
             Cấu trúc lặp 2 tầng (sinh bằng foreach):
               foreach group in Model.Groups  →  <section.vocab-group data-group="...">  (tiêu đề + "N bộ từ")
                 foreach set in group.Sets    →  <article.vocab-card>  (xem chú thích bên dưới)
             Nhóm hiện có: business · toeic · finance · health · travel · dining
             (Chú ý: topic "office" được JS gộp vào filter "business"). -->
        <section id="vocabTopics" class="space-y-5" aria-label="Các chủ đề từ vựng">
        @if (Model?.Groups == null || Model.Groups.Count == 0)
        {
          <div class="rounded-3xl border border-dashed border-slate-300 p-8 text-center text-slate-500">
            Chưa có bộ từ vựng nào trong hệ thống.
          </div>
        }
        else
        {
          @foreach (var group in Model.Groups)
          {
            var grpColor = string.IsNullOrEmpty(group.Color) ? "fuchsia" : group.Color.ToLower();
            <section class="vocab-group" data-group="@group.GroupCode" aria-labelledby="heading-@group.GroupCode">
              <div class="mb-3 flex flex-wrap items-baseline gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-@grpColor-500" aria-hidden="true"></span>
                <h3 id="heading-@group.GroupCode" class="text-lg font-extrabold text-slate-900 dark:text-white">@group.GroupName</h3>
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">@group.Sets.Count bộ từ</span>
              </div>
              <div id="vocabCardGrid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var set in group.Sets)
                {
                  var cardColor = string.IsNullOrEmpty(set.Color) ? grpColor : set.Color.ToLower();
                  var setIcon = string.IsNullOrEmpty(set.Icon) ? "book-open" : set.Icon;
                  var (accentHex, accentSoftHex) = cardColor switch
                  {
                    "amber" or "orange" => ("#ea580c", "rgba(234, 88, 12, 0.12)"),
                    "emerald" or "green" => ("#059669", "rgba(5, 150, 105, 0.12)"),
                    "rose" or "red" => ("#e11d48", "rgba(225, 29, 72, 0.12)"),
                    "cyan" => ("#0891b2", "rgba(8, 145, 178, 0.12)"),
                    "indigo" => ("#4f46e5", "rgba(79, 70, 229, 0.12)"),
                    "primary" or "blue" => ("#2563eb", "rgba(37, 99, 235, 0.12)"),
                    "purple" => ("#9333ea", "rgba(147, 51, 234, 0.12)"),
                    _ => ("#c026d3", "rgba(192, 38, 211, 0.12)") // default fuchsia
                  };
                  int percent = set.TotalCount > 0 ? (int)Math.Round((double)set.LearnedCount * 100 / set.TotalCount) : 0;
                  bool isFinished = percent >= 100;
                  <article class="learning-surface group card-interactive pad-card relative flex h-full flex-col overflow-hidden border text-left rounded-[24px] border-border/60 bg-card/95 p-5 shadow-soft transition hover:-translate-y-0.5 hover:border-border vocab-card cursor-pointer"
                           style="--topic-accent: @accentHex; --topic-accent-soft: @accentSoftHex;"
                           data-topic="@set.GroupCode"
                           data-learned="@(set.LearnedCount > 0 ? "true" : "false")"
                           data-title="@set.Title"
                           data-id="@set.TopicId">
                    <span class="absolute inset-y-0 left-0 w-1 rounded-l-2xl" style="background-color: var(--topic-accent);" aria-hidden="true"></span>
                    <div class="flex items-start gap-2.5 sm:gap-3 pr-24 sm:pr-28">
                      <span class="flex size-9 shrink-0 items-center justify-center rounded-xl sm:size-10" style="background-color: var(--topic-accent-soft); color: var(--topic-accent);">
                        <span class="topic-card-icon" aria-hidden="true">
                          <i data-lucide="@setIcon" style="width: 20px; height: 20px;"></i>
                        </span>
                      </span>
                      <div class="min-w-0 flex-1 space-y-0.5 sm:space-y-1">
                        <h3 class="font-display text-[15px] font-semibold leading-snug sm:text-base" style="color: var(--topic-accent);">@set.Title</h3>
                        <div class="line-clamp-2 text-[11px] font-medium text-muted-foreground sm:hidden">
                          <span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-semibold vocab-card-count-mobile" style="background-color: var(--topic-accent-soft); color: var(--topic-accent);">
                            <i data-lucide="layers" class="size-3"></i>@set.LearnedCount/@set.TotalCount từ
                          </span>
                        </div>
                      </div>
                    </div>
                    <div class="absolute right-4 top-4 flex items-center gap-1.5">
                      <span class="shrink-0 vocab-card-status">
                        @if (isFinished)
                        {
                          <span class="inline-flex items-center border px-2.5 py-0.5 transition-colors [&_svg]:size-3 gap-1 rounded-full border-transparent bg-success/10 text-xs font-bold text-success">
                            <i data-lucide="check" class="size-3" aria-hidden="true"></i>Xong
                          </span>
                        }
                        else if (percent > 0)
                        {
                          <span class="inline-flex items-center gap-1 border px-2.5 py-0.5 transition-colors [&_svg]:size-3 rounded-full border-transparent bg-amber-500/15 text-xs font-bold text-amber-600 dark:text-amber-400">
                            <i data-lucide="loader-2" class="size-3" aria-hidden="true"></i>Đang học
                          </span>
                        }
                        else
                        {
                          <span class="inline-flex items-center gap-1 border px-2.5 py-0.5 transition-colors [&_svg]:size-3 rounded-full border-transparent bg-muted text-xs font-bold text-muted-foreground">
                            Mới
                          </span>
                        }
                      </span>
                    </div>
                    <div class="mt-auto pt-3 space-y-1.5">
                      <div class="flex items-center justify-between text-xs font-semibold">
                        <span class="font-medium text-muted-foreground">Đã học trong bộ</span>
                        <span class="font-bold tabular-nums vocab-card-percent" style="color: var(--topic-accent);">@percent%</span>
                      </div>
                      <div role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" class="relative w-full h-1.5 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                        <div class="h-full rounded-full transition-all duration-500 vocab-card-progressbar" style="background-color: var(--topic-accent); width: @percent%;"></div>
                      </div>
                    </div>
                    <div class="mt-3.5 flex min-h-7 items-center justify-between gap-3 border-t border-border/40 pt-3">
                      <div class="min-w-0 text-xs font-medium text-muted-foreground">
                        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold vocab-card-count" style="background-color: var(--topic-accent-soft); color: var(--topic-accent);">
                          <i data-lucide="layers" class="size-3.5"></i>@set.LearnedCount/@set.TotalCount từ
                        </span>
                      </div>
                      <div class="flex shrink-0 items-center gap-2">
                        <button type="button" class="study-set inline-flex h-7 shrink-0 items-center gap-1 rounded-full px-3 text-xs font-semibold transition group-hover:translate-x-0.5 text-white cursor-pointer hover:brightness-110" style="background-color: var(--topic-accent);">
                          @(percent > 0 && percent < 100 ? "Học tiếp" : "Học bài")
                          <i data-lucide="arrow-right" class="size-3.5" aria-hidden="true"></i>
                        </button>
                      </div>
                    </div>
                  </article>
                }
              </div>
            </section>
          }
        }
