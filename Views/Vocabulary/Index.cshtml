                  </button>
                  <button type="button" class="lesson-complete-btn-secondary" id="lessonCompleteRestartBtn">
                    Ôn lại cả bộ <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                  </button>
                </div>
                <button type="button" class="lesson-complete-btn-back" id="lessonCompleteBackBtn">
                  Về Từ vựng
                </button>
              </div>
              <button type="button" class="lesson-complete-btn-next" id="lessonCompleteNextTopicBtn">
                Chủ đề tiếp theo <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <p id="lessonLiveMessage" class="sr-only" aria-live="polite"></p>
        </section>

        <!-- [MAIN 8/8] POPUP HỌC NHANH  #vocabStudyModal (modal đơn giản: 1 từ + nút Lưu / Từ tiếp theo). Hiện chưa dùng nhiều. -->
        <section id="vocabStudyModal"
          class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/50 p-4 backdrop-blur-sm"
          role="dialog" aria-modal="true" aria-labelledby="studyModalTitle">
          <div
            class="glass-card w-full max-w-md rounded-3xl bg-white p-6 dark:bg-slate-900">
            <div class="flex items-start justify-between gap-4"><div><p
                  class="text-xs font-bold uppercase tracking-wide text-fuchsia-600 dark:text-fuchsia-300">Bộ
                  từ vựng</p><h3 id="studyModalTitle"
                  class="mt-1 text-xl font-extrabold text-slate-900 dark:text-white">Contracts</h3></div><button
                type="button" id="closeStudyModal"
                class="grid h-9 w-9 place-items-center rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-200"
                aria-label="Đóng"><i class="fa-solid fa-xmark"
                  aria-hidden="true"></i></button></div>
            <div
              class="my-6 rounded-2xl bg-fuchsia-50 p-6 text-center dark:bg-fuchsia-500/10"><p
                id="studyWord"
                class="text-2xl font-extrabold text-fuchsia-700 dark:text-fuchsia-300">contract</p><p
                id="studyMeaning"
                class="mt-2 text-sm text-slate-600 dark:text-slate-300">hợp
                đồng</p></div>
            <div class="flex items-center justify-between gap-3"><button
                type="button" id="saveStudyWord"
                class="rounded-xl border border-fuchsia-200 px-4 py-2 text-xs font-bold text-fuchsia-700 dark:border-fuchsia-500/30 dark:text-fuchsia-300"><i
                  class="fa-regular fa-bookmark mr-1" aria-hidden="true"></i>Lưu
                từ</button><button type="button" id="nextStudyWord"
                class="rounded-xl bg-fuchsia-600 px-4 py-2 text-xs font-bold text-white">Từ
                tiếp theo <i class="fa-solid fa-arrow-right ml-1"
                  aria-hidden="true"></i></button></div>
          </div>
        </section>
        <!-- # [MVC][VIEW] Views/Vocabulary/Index.cshtml — KẾT THÚC KHU VỰC MAIN  # -->
      </main>

