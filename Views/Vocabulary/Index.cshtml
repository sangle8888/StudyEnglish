@{
    ViewData["Title"] = "Từ vựng - Vocabulary";
    Layout = "~/Views/Shared/_LayoutSidebar.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/Vocabulary/vocabulary-main.css" asp-append-version="true" />
}

      <main id="dashboardMain" class="flex-1 flex flex-col gap-5 min-w-0">
        <!-- [MAIN 1/8] TIÊU ĐỀ TRANG + THỐNG KÊ NHANH
             Model: LearnedWords / TotalWords ("10/4514 từ"), LearningWords ("Đang học 0"), MasteredWords ("Đã thuộc 0") -->
        <!-- [MAIN 1/8] TIÊU ĐỀ TRANG + THỐNG KÊ NHANH -->
        <div class="flex flex-col gap-2 px-1">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span
                class="topic-card-icon grid h-9 w-9 place-items-center rounded-xl bg-fuchsia-500 text-white shadow-md shadow-fuchsia-500/25"><svg
                  xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="lucide lucide-book-open"><path d="M12 7v14"></path><path
                    d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span>
              <h2
                class="text-2xl font-extrabold text-slate-900 dark:text-white">Từ
                vựng</h2>
            </div>
            <p id="vocabGlobalStatsText" class="text-xs font-semibold text-slate-500 dark:text-slate-400">Đã
              học <strong id="vocabStatLearned" class="text-fuchsia-600 dark:text-fuchsia-400">0/4514
                từ</strong> · Đang học <span id="vocabStatLearning">0</span> · Đã thuộc <span id="vocabStatMastered">0</span></p>
          </div>
          <!-- Thanh kinh nghiệm / tiến độ tổng -->
          <div class="w-full h-1.5 overflow-hidden rounded-full bg-slate-200/80 dark:bg-slate-700/80">
            <div id="vocabGlobalProgressBar"
              class="h-full rounded-full bg-gradient-to-r from-fuchsia-500 to-pink-500 transition-all duration-500"
              style="width: 0%"></div>
          </div>
        </div>

        <!-- [MAIN 2/8] 3 THẺ TỔNG QUAN → Partial: _VocabOverview
             Thẻ 1 "Ôn tập"     : DueReviewCount; nút disabled khi = 0       (JS: chưa gắn hành động)
             Thẻ 2 "Học từ mới" : NewWordsToday/NewWordsGoal + NextTopicTitle; nút [data-scroll-topics] cuộn tới #vocabTopics
             Thẻ 3 "Sổ tay"     : SavedNotebookCount; nút [data-open-tab="notebook"] chuyển sang tab Sổ tay -->
        <section class="grid grid-cols-2 gap-3 lg:grid-cols-3"
          aria-label="Tổng quan từ vựng">
          <article
            class="order-first col-span-2 flex min-w-0 flex-col gap-3 rounded-[24px] border-2 border-vocab-review/40 bg-card/95 p-4 shadow-soft sm:p-5 lg:order-none lg:col-span-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class="inline-flex min-w-0 items-center gap-2 font-display text-base font-bold text-foreground">
                <span
                  class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-vocab-review-soft text-vocab-review">
                  <i class="fa-solid fa-repeat" aria-hidden="true"></i>
                </span>
                <span class="truncate">Ôn tập</span>
              </span>
              <span
                class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-bold text-foreground dark:bg-slate-700 dark:text-slate-100">Nên
                làm trước</span>
            </div>
            <div id="reviewDueSummary"
              class="min-w-0 flex-1 text-xs text-muted-foreground sm:text-sm">Không
              có từ đã học cần ôn</div>
            <button id="startReviewButton" type="button"
              class="inline-flex items-center justify-center gap-2 whitespace-nowrap transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 active:scale-[0.98] motion-reduce:active:scale-100 [&_svg]:size-4 [&_svg]:shrink-0 hover:bg-primary/90 h-11 px-6 text-base min-h-11 w-full rounded-2xl font-bold bg-spectrum text-white shadow-playful hover:opacity-95">Ôn
              tập
              ngay</button>
          </article>
          <article
            class="flex min-w-0 flex-col gap-3 rounded-[24px] border-2 border-vocab-learn/45 bg-card/95 p-4 shadow-soft sm:p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class="inline-flex min-w-0 items-center gap-2 font-display text-base font-bold text-foreground">
                <span
                  class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-vocab-learn-soft text-vocab-learn">
                  <i class="fa-solid fa-wand-magic-sparkles"
                    aria-hidden="true"></i>
                </span>
                <span class="truncate">Học từ mới</span>
              </span>
            </div>
            <div
              class="min-w-0 flex-1 text-xs text-muted-foreground sm:text-sm">
              <span class="block" id="learnNewTodayCount">0/10 từ mới hôm nay</span>
              <span class="block truncate" id="learnNextTopicText">Tiếp theo: Business Planning</span>
            </div>
            <button type="button" data-scroll-topics id="startLearnNewButton"
              class="inline-flex h-11 min-h-11 w-full items-center justify-center gap-2 rounded-2xl bg-gradient-vocab-learn px-6 text-base font-bold text-white shadow-lg shadow-vocab-learn/25 transition-all hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Học
              tiếp</button>
          </article>
          <article
            class="flex min-w-0 flex-col gap-3 rounded-[24px] border-2 border-vocab-notebook/45 bg-card/95 p-4 shadow-soft sm:p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span
                class="inline-flex min-w-0 items-center gap-2 font-display text-base font-bold text-foreground">
                <span
                  class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-vocab-notebook-soft text-vocab-notebook">
                  <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
                </span>
                <span class="truncate">Sổ tay</span>
              </span>
            </div>
            <div
              class="min-w-0 flex-1 text-xs text-muted-foreground sm:text-sm">Chưa
              lưu từ nào</div>
            <button type="button" data-open-tab="notebook"
              class="inline-flex h-11 min-h-11 w-full items-center justify-center gap-2 rounded-2xl bg-gradient-vocab-notebook px-6 text-base font-bold text-white shadow-lg shadow-vocab-notebook/25 transition-all hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Mở
              sổ tay</button>
          </article>
        </section>

        <!-- [MAIN 3/8] THANH CÔNG CỤ: 4 TAB + Ô TÌM KIẾM + BỘ LỌC → Partial: _VocabToolbar
             4 tab (.vocab-tab, thuộc tính data-tab):
                flashcards = Học thẻ   | phrases = Ghép cụm từ | learned = Sổ từ đã học (badge = số từ đã học) | notebook = Sổ tay từ vựng (badge = số từ đã lưu)
             Bộ lọc: #vocabSearch (tìm theo data-title), #vocabTopicFilter (lọc theo data-topic).
             2 <select> đầu (Kỳ thi / Kiểu từ vựng) hiện CHƯA có JS → sau này là query string ?exam=&type= gửi lên Controller.
             Hiện lọc phía client (JS filterCards); khi có nhiều dữ liệu nên chuyển sang lọc phía server / API. -->
        <section
          class="rounded-[26px] border border-slate-200/70 bg-white/95 p-1.5 shadow-soft dark:border-slate-700/70 dark:bg-slate-900/90"
          aria-label="Công cụ học từ vựng">
          <div class="grid grid-cols-4 gap-1.5"
            role="tablist" aria-label="Các mục của Từ vựng">
            <button type="button"
              class="vocab-tab flex min-w-0 min-h-12 flex-col items-center justify-center gap-0.5 rounded-2xl border border-emerald-500/60 bg-gradient-to-br from-emerald-50 to-emerald-100/60 px-1 py-1.5 text-[11px] font-bold text-slate-800 shadow-sm shadow-emerald-500/20 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:from-emerald-500/20 dark:to-emerald-900/20 dark:text-white sm:flex-row sm:gap-2 sm:px-3 sm:text-sm"
              data-tab="flashcards" role="tab" aria-selected="true"
              aria-label="Học thẻ">
              <i
                class="fa-solid fa-layer-group shrink-0 text-emerald-600 dark:text-emerald-300"
                aria-hidden="true"></i>
              <span class="max-w-full truncate">Học thẻ</span>
            </button>
            <button type="button"
              class="vocab-tab flex min-w-0 min-h-12 flex-col items-center justify-center gap-0.5 rounded-2xl border border-cyan-500/25 bg-cyan-50 px-1 py-1.5 text-[11px] font-semibold text-slate-800 transition hover:bg-cyan-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:bg-cyan-500/10 dark:text-slate-100 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm"
              data-tab="phrases" role="tab" aria-selected="false"
              aria-label="Ghép cụm từ">
              <i
                class="fa-solid fa-link shrink-0 text-cyan-600 dark:text-cyan-300"
                aria-hidden="true"></i>
              <span class="truncate sm:hidden">Ghép</span><span
                class="hidden truncate sm:inline">Ghép cụm từ</span>
            </button>
            <button type="button"
              class="vocab-tab flex min-w-0 min-h-12 flex-col items-center justify-center gap-0.5 rounded-2xl border border-fuchsia-500/25 bg-fuchsia-50 px-1 py-1.5 text-[11px] font-semibold text-slate-800 transition hover:bg-fuchsia-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:bg-fuchsia-500/10 dark:text-slate-100 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm"
              data-tab="learned" role="tab" aria-selected="false"
              aria-label="Sổ từ đã học (10)">
              <i
                class="fa-regular fa-floppy-disk shrink-0 text-fuchsia-600 dark:text-fuchsia-300"
                aria-hidden="true"></i>
              <span class="truncate sm:hidden">Đã học</span><span
                class="hidden truncate sm:inline">Sổ từ đã học</span>
              <span
                class="hidden rounded-full bg-white/80 px-1.5 text-[11px] font-bold tabular-nums text-slate-800 sm:inline dark:bg-slate-800 dark:text-white">10</span>
            </button>
            <button type="button"
              class="vocab-tab flex min-w-0 min-h-12 flex-col items-center justify-center gap-0.5 rounded-2xl border border-amber-500/25 bg-amber-50 px-1 py-1.5 text-[11px] font-semibold text-slate-800 transition hover:bg-amber-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:bg-amber-500/10 dark:text-slate-100 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm"
              data-tab="notebook" role="tab" aria-selected="false"
              aria-label="Sổ tay từ vựng (0)">
              <i
                class="fa-regular fa-bookmark shrink-0 text-amber-600 dark:text-amber-300"
                aria-hidden="true"></i>
              <span class="truncate sm:hidden">Sổ tay</span><span
                class="hidden truncate sm:inline">Sổ tay từ vựng</span>
              <span
                class="hidden rounded-full bg-white/80 px-1.5 text-[11px] font-bold tabular-nums text-slate-800 sm:inline dark:bg-slate-800 dark:text-white">0</span>
            </button>
          </div>
          <div id="vocabCatalogFilters"
            class="mt-1.5 border-t border-slate-200/70 px-1.5 pb-1.5 pt-3 dark:border-slate-700/70 sm:px-2.5">
            <div
              class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
              <div
                class="flex min-w-0 items-start gap-2 lg:w-full lg:max-w-[420px]">
                <label class="relative min-w-0 flex-1">
                  <span class="sr-only">Tìm từ vựng</span>
                  <i
                    class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                    aria-hidden="true"></i>
                  <input id="vocabSearch" type="search"
                    placeholder="Tìm từ vựng..."
                    class="h-11 w-full rounded-2xl border border-slate-200 bg-white/80 pl-10 pr-4 text-sm text-slate-700 outline-none transition-colors placeholder:text-slate-400 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100 dark:focus:ring-emerald-900/40 sm:h-12">
                </label>
                <button id="vocabFilterToggle" type="button"
                  aria-expanded="false" aria-controls="vocabFilterOptions"
                  class="inline-flex h-11 shrink-0 items-center gap-1.5 rounded-2xl border border-slate-200 bg-white/80 px-3 text-sm font-semibold text-slate-800 shadow-sm transition-colors dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100 sm:h-12 lg:hidden">
                  <i class="fa-solid fa-sliders" aria-hidden="true"></i><span>Bộ
                    lọc</span>
                </button>
              </div>
              <div id="vocabFilterOptions"
                class="hidden flex-wrap items-center gap-2 lg:flex">
                <label><span class="sr-only">Kỳ thi</span><select
                    class="h-11 cursor-pointer rounded-2xl border border-slate-200 bg-white/85 px-3.5 text-sm font-semibold text-slate-700 outline-none dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 sm:h-12"><option>TOEIC</option><option>IELTS</option></select></label>
                <label><span class="sr-only">Kiểu từ vựng</span><select
                    class="h-11 cursor-pointer rounded-2xl border border-slate-200 bg-white/85 px-3.5 text-sm font-semibold text-slate-700 outline-none dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 sm:h-12"><option>TOEIC
                      theo chủ đề</option><option>TOEIC thường
                      gặp</option></select></label>
                <label><span class="sr-only">Nhóm từ vựng</span><select
                    id="vocabTopicFilter"
                    class="h-11 max-w-full cursor-pointer rounded-2xl border border-slate-200 bg-white/85 px-3.5 text-sm font-semibold text-slate-700 outline-none dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100 sm:h-12"><option
                      value="all">Tất cả nhóm</option><option
                      value="business">Business &amp; Workplace</option><option
                      value="office">Office</option><option value="toeic">TOEIC
                      theo chủ đề</option><option value="finance">Finance &amp;
                      Operations</option><option
                      value="health">Health</option><option
                      value="travel">Travel</option><option
                      value="dining">Dining &amp;
                      Entertainment</option></select></label>
              </div>
            </div>
          </div>
        </section>

        <!-- [MAIN 4/8] DANH SÁCH BỘ TỪ THEO CHỦ ĐỀ  #vocabTopics → Partial: _VocabGroupList
             Cấu trúc lặp 2 tầng (sinh bằng foreach):
               foreach group in Model.Groups  →  <section.vocab-group data-group="...">  (tiêu đề + "N bộ từ")
                 foreach set in group.Sets    →  <article.vocab-card>  (xem chú thích bên dưới)
             Nhóm hiện có: business · toeic · finance · health · travel · dining
             (Chú ý: topic "office" được JS gộp vào filter "business"). -->
        <section id="vocabTopics" class="space-y-5"
          aria-label="Các chủ đề từ vựng">
          <section class="vocab-group" data-group="business"
            aria-labelledby="topicHeading">
            <div class="mb-3 flex flex-wrap items-baseline gap-2"><span
                class="h-2.5 w-2.5 rounded-full bg-fuchsia-500"
                aria-hidden="true"></span><h3 id="topicHeading"
                class="text-lg font-extrabold text-slate-900 dark:text-white">Business
                &amp; Workplace</h3> <span
                class="text-xs font-medium text-slate-500 dark:text-slate-400">10
                bộ từ</span></div>
            <div id="vocabCardGrid"
              class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              <!-- [MVC][PARTIAL] _VocabCard.cshtml — 1 THẺ BỘ TỪ (mẫu, các thẻ sau y hệt)
                   Model VocabSet: { Title, Topic, Color, IsLearned, LearnedCount, TotalCount, Percent }
                     data-title   ← Title          (JS dùng để tìm kiếm + mở bài học)
                     data-topic   ← Topic          (JS dùng để lọc)
                     data-learned ← "true" nếu đã học ít nhất 1 từ (tab "Sổ từ đã học")
                     thanh tiến độ: style="width:{Percent}%"  |  "12/12 từ" ← LearnedCount/TotalCount
                     nút ".study-set": đã học >0 và <100% → "Học tiếp", ngược lại "Học bài"; badge "Mới" khi Percent = 0
                   Màu theo nhóm (CSS class): fuchsia=business, amber=toeic, emerald=finance, rose=health, cyan=travel, orange=dining -->
              <article
                class="vocab-card glass-card rounded-3xl border-l-4 border-fuchsia-500 p-4"
                data-topic="business" data-learned="true"
                data-title="Contracts">
                <div class="mb-3 flex items-start justify-between gap-2"><div
                    class="flex items-center gap-2.5"><span
                      class="grid h-9 w-9 place-items-center rounded-2xl bg-fuchsia-100 text-fuchsia-600 dark:bg-fuchsia-500/15 dark:text-fuchsia-300"><span class="topic-card-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span></span><h4
                      class="text-sm font-extrabold text-fuchsia-600 dark:text-fuchsia-300">Contracts</h4></div><span
                    class="rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-bold text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-300"><i
                      class="fa-solid fa-check mr-1" aria-hidden="true"></i>Xong</span></div>
                <div
                  class="flex items-center justify-between text-[10px] font-semibold text-slate-500 dark:text-slate-400"><span>Đã
                    học trong bộ</span><span
                    class="text-fuchsia-600 dark:text-fuchsia-300">100%</span></div><div
                  class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><div
                    class="h-full rounded-full bg-fuchsia-500"
                    style="width:100%"></div></div>
                <div
                  class="mt-3 flex items-center justify-between border-t border-slate-100 pt-2.5 dark:border-slate-700"><span
                    class="rounded-full bg-fuchsia-100 px-2 py-1 text-[10px] font-bold text-fuchsia-600 dark:bg-fuchsia-500/15 dark:text-fuchsia-300"><i
                      class="fa-solid fa-layer-group mr-1"
                      aria-hidden="true"></i>12/12 từ</span><button
                    type="button"
                    class="study-set rounded-full bg-fuchsia-500 px-3 py-1.5 text-[10px] font-extrabold text-white transition hover:bg-fuchsia-600">Học
                    bài <i class="fa-solid fa-arrow-right ml-1"
                      aria-hidden="true"></i></button></div>
              </article>
              <article
                class="vocab-card glass-card rounded-3xl border-l-4 border-fuchsia-500 p-4"
                data-topic="business" data-learned="true" data-title="Business Planning">
                <div class="mb-3 flex items-start justify-between gap-2"><div
                    class="flex items-center gap-2.5"><span
                      class="grid h-9 w-9 place-items-center rounded-2xl bg-fuchsia-100 text-fuchsia-600 dark:bg-fuchsia-500/15 dark:text-fuchsia-300"><span class="topic-card-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span></span><h4
                      class="text-sm font-extrabold text-fuchsia-600 dark:text-fuchsia-300">Business
                      Planning</h4></div><span
                    class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-500 dark:bg-slate-700 dark:text-slate-300">Mới</span></div>
                <div
                  class="flex items-center justify-between text-[10px] font-semibold text-slate-500 dark:text-slate-400"><span>Đã
                    học trong bộ</span><span
                    class="text-fuchsia-600 dark:text-fuchsia-300">8%</span></div><div
                  class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><div
                    class="h-full rounded-full bg-fuchsia-500"
                    style="width:8%"></div></div>
                <div
                  class="mt-3 flex items-center justify-between border-t border-slate-100 pt-2.5 dark:border-slate-700"><span
                    class="rounded-full bg-fuchsia-100 px-2 py-1 text-[10px] font-bold text-fuchsia-600 dark:bg-fuchsia-500/15 dark:text-fuchsia-300"><i
                      class="fa-solid fa-layer-group mr-1"
                      aria-hidden="true"></i>1/12 từ</span><button type="button"
                    class="study-set rounded-full bg-fuchsia-500 px-3 py-1.5 text-[10px] font-extrabold text-white transition hover:bg-fuchsia-600">Học
                    tiếp <i class="fa-solid fa-arrow-right ml-1"
                      aria-hidden="true"></i></button></div>
              </article>
              <article
                class="vocab-card glass-card rounded-3xl border-l-4 border-fuchsia-500 p-4"
                data-topic="business" data-title="Conferences">
