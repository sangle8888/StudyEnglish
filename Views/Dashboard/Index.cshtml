@section Modals {
    <!-- GOAL MODAL -->
    <div id="goalModal" class="goal-modal-overlay" hidden>
      <section class="goal-modal" role="dialog" aria-modal="true"
        aria-labelledby="goalModalTitle"
        aria-describedby="goalModalDescription">
        <header class="goal-modal-header">
          <span class="goal-modal-icon" aria-hidden="true">
            <i class="fa-solid fa-trophy"></i>
          </span>
          <h2 class="goal-modal-title" id="goalModalTitle">Mục tiêu kỳ thi</h2>
          <button class="goal-modal-close" id="goalModalClose" type="button"
            aria-label="Đóng">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </header>
        <form class="goal-modal-form" id="goalForm">
          <p id="goalModalDescription" class="sr-only">Chọn kỳ thi, điểm TOEIC
            mục tiêu và ngày thi dự kiến.</p>
          <div class="goal-field">
            <span class="goal-field-label">Kỳ thi</span>
            <div class="goal-exam-options" role="group"
              aria-label="Chọn kỳ thi">
              <button class="goal-exam-option" type="button"
                aria-pressed="true">TOEIC</button>
              <button class="goal-exam-option" type="button" disabled>VSTEP ·
                Chưa hỗ trợ</button>
            </div>
          </div>
          <label class="goal-field" for="goalScoreInput">
            <span class="goal-field-label">Điểm mục tiêu TOEIC</span>
            <input class="goal-input" id="goalScoreInput" name="score"
              type="number" min="10" max="990" step="5" value="650" required>
          </label>
          <label class="goal-field" for="goalDateInput">
            <span class="goal-field-label">Ngày thi dự kiến</span>
            <input class="goal-input" id="goalDateInput" name="date"
              type="date" required>
          </label>
          <div class="goal-modal-actions">
            <button class="goal-cancel" id="goalCancelButton"
              type="button">Hủy</button>
            <button class="goal-save" id="goalSaveButton" type="submit"
              disabled>Lưu mục tiêu</button>
          </div>
        </form>
      </section>
    </div>

    <!-- DAILY GOAL MODAL -->
    <div id="dailyGoalModal" class="daily-goal-modal-overlay" hidden>
      <section class="daily-goal-modal" role="dialog" aria-modal="true"
        aria-labelledby="dailyGoalModalTitle"
        aria-describedby="dailyGoalModalDescription">
        <header class="daily-goal-modal-header">
          <h2 class="daily-goal-modal-title" id="dailyGoalModalTitle">Mục tiêu hằng ngày</h2>
          <button class="daily-goal-modal-close" id="dailyGoalModalClose" type="button" aria-label="Đóng">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </header>
        <p id="dailyGoalModalDescription" class="sr-only">Chỉnh sửa số câu và từ vựng mục tiêu cần hoàn thành mỗi ngày.</p>
        <form id="dailyGoalForm" class="daily-goal-form">
          <div class="daily-goal-rows">
            <!-- Row 1: Ngữ pháp -->
            <div class="daily-goal-row">
              <label for="dailyGoalGrammar" class="daily-goal-label">Ngữ pháp</label>
              <div class="daily-goal-input-wrap">
                <input type="number" id="dailyGoalGrammar" name="grammar" class="daily-goal-input" min="1" max="100" value="20" required>
                <span class="daily-goal-unit">câu</span>
              </div>
            </div>

            <!-- Row 2: Từ vựng mới -->
            <div class="daily-goal-row">
              <label for="dailyGoalVocab" class="daily-goal-label">Từ vựng mới</label>
              <div class="daily-goal-input-wrap">
                <input type="number" id="dailyGoalVocab" name="vocab" class="daily-goal-input" min="1" max="100" value="10" required>
                <span class="daily-goal-unit">từ</span>
              </div>
            </div>

            <!-- Row 3: Nghe -->
            <div class="daily-goal-row">
              <label for="dailyGoalListening" class="daily-goal-label">Nghe</label>
              <div class="daily-goal-input-wrap">
                <input type="number" id="dailyGoalListening" name="listening" class="daily-goal-input" min="1" max="100" value="10" required>
                <span class="daily-goal-unit">câu</span>
              </div>
            </div>

            <!-- Row 4: Đọc -->
            <div class="daily-goal-row">
              <label for="dailyGoalReading" class="daily-goal-label">Đọc</label>
              <div class="daily-goal-input-wrap">
                <input type="number" id="dailyGoalReading" name="reading" class="daily-goal-input" min="1" max="100" value="10" required>
                <span class="daily-goal-unit">câu</span>
              </div>
            </div>
          </div>

          <div class="daily-goal-actions">
            <button type="button" id="dailyGoalCancelBtn" class="daily-goal-btn-cancel">Hủy</button>
            <button type="submit" id="dailyGoalSaveBtn" class="daily-goal-btn-save">Lưu thay đổi</button>
          </div>
        </form>
      </section>
    </div>

    <!-- SKILL DETAIL MODAL -->
    <div id="skillDetailModal" class="skill-modal-overlay" hidden>
      <section class="skill-modal" role="dialog" aria-modal="true"
        aria-labelledby="skillDetailModalTitle"
        aria-describedby="skillDetailModalDescription">
        <header class="skill-modal-header">
          <span class="skill-modal-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a10 10 0 0 1 10 10"></path>
              <circle cx="12" cy="12" r="4"></circle>
            </svg>
          </span>
          <h2 class="skill-modal-title" id="skillDetailModalTitle">Chi tiết tiến độ kỹ năng</h2>
          <button class="skill-modal-close" id="skillDetailModalClose" type="button"
            aria-label="Đóng">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </header>

        <div class="skill-modal-body" id="skillDetailModalDescription">
          <div class="skill-detail-grid">
            
            <!-- Ngữ pháp -->
            <div class="skill-detail-card skill-detail-card--grammar">
              <div class="skill-detail-head">
                <span class="skill-detail-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 7v14"></path>
                    <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path>
                  </svg>
                </span>
                <div class="skill-detail-info">
                  <div class="skill-detail-title">Ngữ pháp</div>
                  <div class="skill-detail-subtitle">Đã học 3/1500</div>
                </div>
              </div>
              <div class="skill-detail-metrics">
                <div class="skill-metric-box">
                  <span class="skill-metric-label">Tiến độ học</span>
                  <span class="skill-metric-val">0%</span>
                </div>
                <div class="skill-metric-box">
                  <span class="skill-metric-label">Độ chính xác</span>
                  <span class="skill-metric-val">0%</span>
                  <span class="skill-metric-sub">Đúng 0/3</span>
                </div>
              </div>
            </div>

            <!-- Từ vựng -->
            <div class="skill-detail-card skill-detail-card--vocab">
              <div class="skill-detail-head">
                <span class="skill-detail-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path>
                    <path d="m8 13 4-7 4 7"></path>
                    <path d="M9.1 11h5.7"></path>
                  </svg>
                </span>
                <div class="skill-detail-info">
                  <div class="skill-detail-title">Từ vựng</div>
                  <div class="skill-detail-subtitle">Đã học 55/4514</div>
                </div>
              </div>
              <div class="skill-detail-metrics">
                <div class="skill-metric-box">
                  <span class="skill-metric-label">Tiến độ học</span>
                  <span class="skill-metric-val">1%</span>
                </div>
                <div class="skill-metric-box">
                  <span class="skill-metric-label">Độ chính xác</span>
                  <span class="skill-metric-val">32%</span>
                  <span class="skill-metric-sub">Đúng 7/22</span>
                </div>
              </div>
            </div>

            <!-- Nghe -->
            <div class="skill-detail-card skill-detail-card--listening">
              <div class="skill-detail-head">
                <span class="skill-detail-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 14v-3a9 9 0 0 1 18 0v3"></path>
                    <path d="M5 14h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2Z"></path>
                    <path d="M17 14h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2Z"></path>
                  </svg>
                </span>
                <div class="skill-detail-info">
                  <div class="skill-detail-title">Nghe</div>
                  <div class="skill-detail-subtitle">Đã học 1/2100</div>
                </div>
              </div>
              <div class="skill-detail-metrics">
                <div class="skill-metric-box">
                  <span class="skill-metric-label">Tiến độ học</span>
                  <span class="skill-metric-val">0%</span>
                </div>
                <div class="skill-metric-box">
                  <span class="skill-metric-label">Độ chính xác</span>
                  <span class="skill-metric-val">100%</span>
                  <span class="skill-metric-sub">Đúng 1/1</span>
                </div>
              </div>
            </div>

            <!-- Đọc -->
            <div class="skill-detail-card skill-detail-card--reading">
              <div class="skill-detail-head">
                <span class="skill-detail-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <path d="M14 2v6h6"></path>
                    <path d="M8 13h8"></path>
                    <path d="M8 17h8"></path>
                    <path d="M8 9h2"></path>
                  </svg>
                </span>
                <div class="skill-detail-info">
                  <div class="skill-detail-title">Đọc</div>
                  <div class="skill-detail-subtitle">Đã học 10/2100</div>
                </div>
              </div>
              <div class="skill-detail-metrics">
                <div class="skill-metric-box">
                  <span class="skill-metric-label">Tiến độ học</span>
                  <span class="skill-metric-val">0%</span>
                </div>
                <div class="skill-metric-box">
                  <span class="skill-metric-label">Độ chính xác</span>
                  <span class="skill-metric-val">20%</span>
                  <span class="skill-metric-sub">Đúng 2/10</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>
    </div>
}

@section Scripts {
    <script src="~/assets/js/Dashboard/dashboard-main.js" asp-append-version="true"></script>
}
