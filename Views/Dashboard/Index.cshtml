@model StudyEnglish.Models.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "Hôm nay - Dashboard";
    Layout = "~/Views/Shared/_LayoutSidebar.cshtml";
    var fullName = Model.FullName;
    var email = Model.Email;
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/Dashboard/dashboard-main.css" asp-append-version="true" />
}

<!-- MAIN CONTENT AREA -->
<main id="dashboardMain"
  class="mx-auto w-full px-4 sm:px-6 pb-safe pt-0 pb-4 lg:px-6 [--pad-safe:2rem] max-w-[1420px] flex-1 flex min-w-0 flex-col gap-5 lg:pt-0 lg:pb-6">

  <!-- HEADER BAR -->
  <header
    class="glass-card relative z-30 rounded-3xl p-4 sm:px-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="min-w-0 flex-1 space-y-0.5">
      <h1
        class="dashboard-greeting flex flex-wrap items-center gap-x-2 text-xl tracking-tight sm:text-[1.45rem] lg:text-[1.7rem]">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true"><path
            d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path
            d="M20 3v4"></path><path d="M22 5h-4"></path><path
            d="M4 17v2"></path><path d="M5 18H3"></path></svg>
        <span>Tập trung phần đang yếu nhé, <span
            class="dashboard-greeting-name">@fullName</span>!👋</span>
      </h1>
      <div class="dashboard-mobile-actions">
        <a class="dashboard-continue-link" asp-controller="Vocabulary" asp-action="Index">Tiếp tục học
          · Ôn tập từ vựng
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true"><path
              d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <span class="dashboard-mobile-xp"><svg
            xmlns="http://www.w3.org/2000/svg" width="24" height="24"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true"><path
              d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path
              d="M20 3v4"></path><path d="M22 5h-4"></path><path
              d="M4 17v2"></path><path d="M5 18H3"></path></svg> +0 XP hôm
          nay</span>
      </div>
    </div>

    <!-- Right Stats Pills & Profile -->
    <div id="headerActions"
      class="header-actions flex items-center flex-wrap justify-end w-full md:w-auto">
      <!-- Streak Pill -->
      <div
        class="header-stat-pill text-amber-600 dark:text-amber-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="size-4 animate-flame-pulse fill-current"
          aria-hidden="true"><path
            d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
        <span id="streakCountHeader">0 ngày</span>
      </div>

      <!-- XP Pill -->
      <div
        class="header-stat-pill text-violet-600 dark:text-violet-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="size-4 fill-current" aria-hidden="true"><path
            d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path
            d="M20 3v4"></path><path d="M22 5h-4"></path><path
            d="M4 17v2"></path><path d="M5 18H3"></path></svg>
        <span id="xpCountHeader">+0 XP</span>
      </div>

      <!-- Notification Bell -->
      <div class="notification-wrap relative">
        <button id="notificationButton" type="button" aria-label="Thông báo"
          aria-haspopup="true" aria-expanded="false"
          class="header-icon-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="size-5" aria-hidden="true"><path
              d="M10.268 21a2 2 0 0 0 3.464 0"></path><path
              d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg>
          <span id="notificationBadge"
            class="absolute top-2 right-2 w-2 h-2 rounded-full bg-red-500"></span>
        </button>

        <!-- Notification Dropdown -->
        <div id="notificationDropdown" class="notification-dropdown" hidden>
          <div class="notification-header">
            <h3 class="notification-title">Thông báo</h3>
            <div class="notification-actions">
              <button type="button" id="markAllReadBtn" class="notification-read-all-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                <span>Đã đọc tất cả</span>
              </button>
              <button type="button" id="notificationCloseBtn" class="notification-close-btn" aria-label="Đóng thông báo">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <div class="notification-body">
            <p class="notification-empty">Bạn chưa có thông báo nào.</p>
          </div>
        </div>
      </div>

      <!-- User Profile Pill -->
      <div class="profile-menu-wrap">
        <button id="profileMenuTrigger" class="profile-trigger"
          type="button"
          aria-label="Tài khoản"
          aria-haspopup="true" aria-expanded="false"
          aria-controls="profileMenu">
          <span class="profile-avatar">
            <img src="~/assets/images/Dashboard/study-buddy-owl.webp" asp-append-version="true" alt>
          </span>
          <span class="profile-trigger-copy">
            <span class="profile-trigger-name">@fullName</span>
            <span class="profile-trigger-caption">Xem hồ sơ</span>
          </span>
        </button>
        <div id="profileMenu" class="profile-menu" role="menu" hidden>
          <div class="profile-menu-account">
            <div class="profile-menu-name">@fullName</div>
            <div class="profile-menu-email">@email</div>
          </div>
          <div class="profile-menu-divider" role="separator"></div>
          <a class="profile-menu-item" href="#"
            role="menuitem">
            <i class="fa-regular fa-user" aria-hidden="true"></i>
            <span>Tài khoản</span>
          </a>
          <a class="profile-menu-item" href="#settings"
            role="menuitem">
            <i class="fa-solid fa-gear" aria-hidden="true"></i>
            <span>Cài đặt</span>
          </a>
          <button class="profile-menu-item" id="profileFeedbackButton"
            type="button" role="menuitem">
            <i class="fa-regular fa-square-plus" aria-hidden="true"></i>
            <span>Góp ý cho TART</span>
          </button>
          <a class="profile-menu-item logout" asp-controller="Login" asp-action="Logout"
            role="menuitem">
            <i class="fa-solid fa-arrow-right-from-bracket"
              aria-hidden="true"></i>
            <span>Đăng xuất</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- TOP METRIC CARDS & STREAK ROW -->
  <div id="metricsGrid"
    class="grid grid-cols-2 gap-2.5 lg:grid-cols-12">

    <!-- Daily learning metrics -->
    <article class="metric-stat-card metric-stat-card--goal">
      <svg
        class="metric-sparkle pointer-events-none absolute right-3 top-2.5 size-4 text-white/95 dark:hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24" aria-hidden="true"><path
          d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path
          d="M20 3v4M22 5h-4M4 17v2M5 18H3"></path></svg>
      <div class="metric-stat-head metric-goal-head">
        <span class="metric-stat-icon metric-goal-icon"><svg
            xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            aria-hidden="true"><path
              d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg></span>
        <div class="metric-stat-label">Mục tiêu</div>
        <button id="goalSettingsButton" type="button"
          aria-label="Cài đặt mục tiêu"
          class="metric-settings-button"><svg
            xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            aria-hidden="true"><path
              d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle
              cx="12" cy="12" r="3"></circle></svg></button>
      </div>
      <div class="metric-goal-summary"><button type="button"
          class="metric-goal-link"
          onclick="document.getElementById('goalSettingsButton').click()"
          id="goalSummaryTitle">Thiết lập mục tiêu</button><p
          id="goalSummaryDetails">Chọn điểm và ngày thi dự kiến</p></div>
    </article>

    <article class="metric-stat-card metric-stat-card--vocabulary">
      <svg class="metric-sparkle" xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24" aria-hidden="true"><path
          d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path
          d="M20 3v4M22 5h-4M4 17v2M5 18H3"></path></svg>
      <div class="metric-stat-head"><span class="metric-stat-icon"><svg
            xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            aria-hidden="true"><path
              d="M12 21V7M22 6V4a1 1 0 0 0-1-1h-5a4 4 0 0 0-4 4 4 4 0 0 0-4-4H3a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h6a3 3 0 0 1 3 3 3 3 0 0 1 3-3h6a1 1 0 0 0 1-1v-1.3"></path><path
              d="m16 12 2 2 4-4"></path></svg></span><div
          class="metric-stat-label">Từ vựng đã học</div></div>
      <div class="metric-stat-value">17<span>từ</span></div>
      <p class="metric-stat-note">Chưa học từ mới tuần này</p>
    </article>

    <article id="metricAccuracyCard"
      class="metric-stat-card metric-stat-card--accuracy animate-card-up group relative min-h-[7.75rem] overflow-hidden rounded-[1.25rem] border border-fuchsia-200/90 bg-gradient-to-br from-white via-fuchsia-50 to-purple-100 px-4 py-3 shadow-soft transition hover:-translate-y-0.5 hover:shadow-playful dark:border-fuchsia-500/25 dark:from-card dark:via-card dark:to-card">
      <svg class="metric-sparkle" xmlns="http://www.w3.org/2000/svg"
        width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round"
        stroke-linejoin="round" aria-hidden="true"><path
          d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path
          d="M20 3v4M22 5h-4M4 17v2M5 18H3"></path></svg>
      <div class="metric-stat-head relative flex items-start gap-3"><span
          class="metric-stat-icon flex size-12 shrink-0 items-center justify-center rounded-[1.1rem] border border-fuchsia-200 bg-card/90 text-violet-500 shadow-sm dark:border-fuchsia-500/25 dark:bg-fuchsia-500/10 dark:text-fuchsia-400"><svg
            xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"><circle cx="12" cy="12"
              r="10"></circle><circle cx="12" cy="12"
              r="6"></circle><circle cx="12" cy="12"
              r="2"></circle></svg></span><div
          class="min-w-0 flex-1 pt-0.5"><div class="metric-stat-label">Độ
            chính xác</div>
          <div
            class="metric-stat-value font-display text-3xl font-extrabold leading-none tabular-nums">19<span>%</span></div></div></div>
      <div class="metric-progress-wrap relative mt-2.5"><div
          class="metric-progress mt-3 h-2 overflow-hidden rounded-full"><span
            style="width:19%"></span></div></div>
      <p class="metric-stat-note">4/21 câu đúng</p>
    </article>

    <article class="metric-stat-card metric-stat-card--time">
      <svg class="metric-sparkle" xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24" aria-hidden="true"><path
          d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path
          d="M20 3v4M22 5h-4M4 17v2M5 18H3"></path></svg>
      <div class="metric-stat-head"><span
          class="metric-stat-icon metric-stat-icon--time"><svg
            xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
            aria-hidden="true"><circle cx="12" cy="12"
              r="10"></circle><polyline
              points="12 6 12 12 16.5 12"></polyline></svg></span><div
          class="metric-stat-label">Thời gian học</div></div>
      <div class="metric-stat-value">1h 43m</div>
      <p class="metric-stat-note">Hôm nay: chưa học</p>
    </article>

    <!-- Weekly streak -->
    <div id="streakCard"
      class="text-card-foreground card-tinted card-warm order-2 min-h-0 overflow-hidden rounded-[1.4rem] border-border bg-card shadow-soft xl:order-none xl:col-span-4 xl:h-full xl:min-h-[6.6rem]">
      <div
        class="streak-card-heading space-y-1.5 p-6 flex flex-row items-center justify-between px-5 pb-1.5 pt-3.5">
        <h3
          class="tracking-tight flex items-center gap-1.5 text-base font-extrabold text-foreground">Streak
          0 ngày
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5 fill-current text-amber-500 animate-flame-pulse"
            aria-hidden="true"><path
              d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
        </h3>
      </div>
      <div class="p-6 pt-0 px-5 pb-3.5">
        <div class="space-y-2.5">
          <div
            class="streak-week flex items-center justify-between gap-2">
            <div
              class="streak-day-column flex flex-1 flex-col items-center gap-1.5"><span
                class="streak-day"></span><span
                class="streak-day-label">T2</span></div>
            <div
              class="streak-day-column flex flex-1 flex-col items-center gap-1.5"><span
                class="streak-day"></span><span
                class="streak-day-label">T3</span></div>
            <div
              class="streak-day-column flex flex-1 flex-col items-center gap-1.5"><span
                class="streak-day"></span><span
                class="streak-day-label">T4</span></div>
            <div
              class="streak-day-column flex flex-1 flex-col items-center gap-1.5"><span
                class="streak-day streak-active">✓</span><span
                class="streak-day-label">T5</span></div>
            <div
              class="streak-day-column flex flex-1 flex-col items-center gap-1.5"><span
                class="streak-day"></span><span
                class="streak-day-label">T6</span></div>
            <div
              class="streak-day-column flex flex-1 flex-col items-center gap-1.5"><span
                class="streak-day"></span><span
                class="streak-day-label">T7</span></div>
            <div
              class="streak-day-column flex flex-1 flex-col items-center gap-1.5"><span
                class="streak-day"></span><span
                class="streak-day-label">CN</span></div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- MIDDLE BENTO GRID: TASKS & SKILL ACCURACY -->
  <div id="middleGrid" class="grid grid-cols-1 lg:grid-cols-12 gap-5">

    <!-- LEFT MAIN COLUMN: Nhiệm vụ hôm nay -->
    <div id="taskCard"
      class="task-arena-card lg:col-span-7 glass-card rounded-3xl flex flex-col justify-between">
      <div class="task-card-content">
        <!-- Tasks Header -->
        <div
          class="task-card-header flex flex-row items-center justify-between gap-3 space-y-0">
          <div class="min-w-0">
            <h3
              class="tracking-tight text-lg font-extrabold text-skill-speaking dark:text-skill-speaking">
              Nhiệm vụ hôm nay
            </h3>
            <p class="text-xs font-bold text-muted-foreground"
              id="taskCounterText">0/5 nhiệm vụ đã xong</p>
          </div>
          <div class="flex items-center gap-2">
            <span
              class="task-card-xp inline-flex items-center gap-1 border border-transparent text-reward-xp rounded-full bg-card/76 shadow-sm px-2.5 py-0.5 text-xs font-bold transition-colors">
              +50 XP
            </span>
            <button type="button" aria-label="Cài đặt mục tiêu hằng ngày"
              title="Cài đặt mục tiêu hằng ngày" id="dailyGoalSettingsButton"
              class="task-settings-button inline-flex items-center justify-center size-11 rounded-full bg-card/70 hover:bg-accent hover:text-accent-foreground lg:size-9">
              <svg xmlns="http://www.w3.org/2000/svg" width="24"
                height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"
                class="size-4" aria-hidden="true">
                <path
