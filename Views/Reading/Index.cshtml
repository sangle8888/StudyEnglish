@section Modals {
  <div id="goalModal" class="goal-modal-overlay" hidden>
    <section class="goal-modal" role="dialog" aria-modal="true" aria-labelledby="goalModalTitle" aria-describedby="goalModalDescription">
      <header class="goal-modal-header">
        <span class="goal-modal-icon" aria-hidden="true">
          <i class="fa-solid fa-trophy"></i>
        </span>
        <h2 class="goal-modal-title" id="goalModalTitle">Mục tiêu kỳ thi</h2>
        <button class="goal-modal-close" id="goalModalClose" type="button" aria-label="Đóng">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </header>
      <form class="goal-modal-form" id="goalForm">
        <p id="goalModalDescription" class="sr-only">Chọn kỳ thi, điểm TOEIC mục tiêu và ngày thi dự kiến.</p>
        <div class="goal-field">
          <span class="goal-field-label">Kỳ thi</span>
          <div class="goal-exam-options" role="group" aria-label="Chọn kỳ thi">
            <button class="goal-exam-option" type="button" aria-pressed="true">TOEIC</button>
            <button class="goal-exam-option" type="button" disabled>VSTEP · Chưa hỗ trợ</button>
          </div>
        </div>
        <label class="goal-field" for="goalScoreInput">
          <span class="goal-field-label">Điểm mục tiêu TOEIC</span>
          <input class="goal-input" id="goalScoreInput" name="score" type="number" min="10" max="990" step="5" value="650" required>
        </label>
        <label class="goal-field" for="goalDateInput">
          <span class="goal-field-label">Ngày thi dự kiến</span>
          <input class="goal-input" id="goalDateInput" name="date" type="date" required>
        </label>
        <div class="goal-modal-actions">
          <button class="goal-cancel" id="goalCancelButton" type="button">Hủy</button>
          <button class="goal-save" id="goalSaveButton" type="submit" disabled>Lưu mục tiêu</button>
        </div>
      </form>
    </section>
  </div>
}

@section Scripts {
  <script src="~/assets/js/Reading/reading-main.js" asp-append-version="true"></script>
}
