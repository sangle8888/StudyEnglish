            <span>Đã lưu vào sổ tay cá nhân</span>
          </div>
          <button id="grammarTheoryClose" type="button" aria-label="Đóng">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
          </button>
        </header>

        <div class="grammar-theory-scroll premium-scrollbar">
          <div class="grammar-theory-content">
            <!-- Hero section: Golden rules, Quick tips, Mascot -->
            <section class="grammar-theory-hero">
              <article class="grammar-theory-card grammar-theory-golden">
                <div class="grammar-theory-golden-decor" aria-hidden="true"></div>
                <div class="grammar-theory-card-badge">
                  <span class="grammar-theory-badge-icon badge-golden">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-quote"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path></svg>
                  </span>
                  <span class="grammar-theory-badge-text text-golden">Quy tắc vàng:</span>
                </div>
                <div class="grammar-theory-golden-rules" id="theoryGoldenRules">
                  <p><span>S + V(s/es)</span></p>
                  <p><span>S + am/is/are + V-ing</span></p>
