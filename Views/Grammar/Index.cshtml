            </div>
          </div>
        </section>
      </main>

@section Modals {
    <!-- Grammar dialogs (outside #dashboardLayout because the JS makes the layout inert while the question map is open) -->
    <div id="grammarTheoryDialog" role="dialog" aria-modal="true" aria-label="Lý thuyết" tabindex="-1" hidden>
      <div class="grammar-theory-window">
        <header class="grammar-theory-header">
          <div class="grammar-theory-header-left">
            <span class="grammar-theory-header-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>
            </span>
            <div class="grammar-theory-header-copy">
              <h2 id="grammarTheoryDialogTitle">Lý thuyết</h2>
              <p id="grammarTheoryDialogSubtitle">Các thì hiện tại</p>
            </div>
          </div>
          <div id="theoryToast" class="theory-toast" hidden>
