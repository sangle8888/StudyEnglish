@model StudyEnglish.Services.GrammarPageDto
@{
    ViewData["Title"] = "Ngữ Pháp - Grammar";
    Layout = "~/Views/Shared/_LayoutSidebar.cshtml"; 

    var answeredCount = Model?.State?.AnsweredTotal ?? 0;
    var totalTopics = Model?.Groups?.Sum(g => g.Topics.Count) ?? 0;
    var weakCount = Model?.State?.TopicStats?.Values.Count(s => s.Wrong > 0) ?? 0;
    var accuracy = answeredCount > 0 ? (int)Math.Round((double)((Model?.State?.CorrectTotal ?? 0) * 100) / answeredCount) : 0;
    var bookmarkCount = (Model?.State?.Bookmarks?.Count ?? 0) + (Model?.State?.Notes?.Count ?? 0);
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/Grammar/grammar-main.css" asp-append-version="true" />
}

      <!-- MAIN CONTENT AREA -->
      <main id="grammarPage">
        <div id="grammarCatalog">
          <section class="grammar-hero" aria-labelledby="pageTitle">
            <div class="grammar-hero-content">
              <div class="grammar-hero-top">
                <div class="grammar-hero-copy">
                  <div class="grammar-title-row">
                    <span class="grammar-title-icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24"
                        height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-book-open"><path
                          d="M12 7v14"></path><path
                          d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path>
                        </svg>
                    </span>
                    <div class="grammar-title-copy">
                      <h1 id="pageTitle">Các chủ đề ngữ pháp</h1>
                      <p class="grammar-subtitle">Luyện tập các chủ đề ngữ pháp
                        trọng tâm cho TOEIC &amp; VSTEP.</p>
                    </div>
                  </div>
                </div>
                <div class="grammar-stats" aria-label="Thống kê học tập">
                  <div class="grammar-stat">
                    <div class="grammar-stat-label">
                      <span class="grammar-stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                      </span>
                      <span>Câu đã làm</span>
                    </div>
                    <div class="grammar-stat-value" id="answeredCount">@answeredCount</div>
                  </div>
                  <div class="grammar-stat">
                    <div class="grammar-stat-label">
                      <span class="grammar-stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>
                      </span>
                      <span>Chủ đề</span>
                    </div>
                    <div class="grammar-stat-value" id="topicCount">@totalTopics</div>
                  </div>
                  <div class="grammar-stat">
                    <div class="grammar-stat-label">
                      <span class="grammar-stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                      </span>
                      <span>Điểm yếu</span>
                    </div>
                    <div class="grammar-stat-value" id="weakCount">@weakCount</div>
                  </div>
                </div>
              </div>
              <div class="grammar-progress-wrap">
                <div class="grammar-progress-label">
                  <span>Độ chính xác tổng</span>
                  <span class="grammar-progress-value" id="accuracyValue">@(accuracy)%</span>
                </div>
                <div class="grammar-progress-track" role="progressbar"
                  aria-label="Độ chính xác tổng" aria-valuemin="0"
                  aria-valuemax="100" aria-valuenow="@accuracy">
                  <div class="grammar-progress-fill" id="accuracyFill" style="width: @(accuracy)%"></div>
                </div>
              </div>
            </div>
            <img class="grammar-mascot" src="~/assets/images/Grammar/grammar-list-buddy-owl.webp" asp-append-version="true"
              alt="Cú TART đang học ngữ pháp" width="192" height="192"
              decoding="async">
          </section>

          <div class="grammar-tabs" role="tablist"
            aria-label="Danh mục ngữ pháp">
            <button class="grammar-tab" id="learningTab"
              type="button" role="tab"
              aria-selected="true" aria-controls="topicSections">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="lucide lucide-book-open size-4" aria-hidden="true"><path
                  d="M12 7v14"></path><path
                  d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>
              Học tập
            </button>
            <button class="grammar-tab" id="notebookTab"
              type="button" role="tab"
              aria-selected="false" aria-controls="topicSections">
              <i class="fa-regular fa-bookmark"
                aria-hidden="true"></i>
              Sổ tay cá nhân (<span class="grammar-tab-count" id="bookmarkCount">@bookmarkCount</span>)
            </button>
          </div>

          <section class="grammar-tools"
            aria-label="Tìm và lọc chủ đề">
            <div class="grammar-tools-left">
              <label class="grammar-search">
                <i class="fa-solid fa-magnifying-glass"
                  aria-hidden="true"></i>
                <input id="topicSearch" type="search"
                  placeholder="Tìm chủ đề..."
                  autocomplete="off"
                  aria-label="Tìm chủ đề ngữ pháp">
              </label>
              <button class="tool-button" id="filterToggle"
                type="button"
                aria-expanded="false"
                aria-controls="filterPanel">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                  viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-sliders-horizontal size-4"
                  aria-hidden="true"><line x1="21" x2="14" y1="4"
                    y2="4"></line><line x1="10" x2="3" y1="4"
                    y2="4"></line><line x1="21" x2="12" y1="12"
                    y2="12"></line><line x1="8" x2="3" y1="12"
                    y2="12"></line><line x1="21" x2="16" y1="20"
                    y2="20"></line><line x1="12" x2="3" y1="20"
                    y2="20"></line><line x1="14" x2="14" y1="2"
                    y2="6"></line><line x1="8" x2="8" y1="10"
                    y2="14"></line><line x1="16" x2="16" y1="18"
                    y2="22"></line></svg> Bộ lọc
              </button>
            </div>
            <div class="grammar-tools-right">
              <div class="segmented-control"
                aria-label="Lọc theo kỳ thi">
                <button type="button" data-exam="all"
                  aria-pressed="true">Tất
                  cả</button>
                <button type="button" data-exam="TOEIC"
                  aria-pressed="false">TOEIC</button>
                <button type="button" data-exam="VSTEP"
                  aria-pressed="false">VSTEP</button>
              </div>
              <div class="segmented-control"
                aria-label="Sắp xếp chủ đề">
                <button type="button" data-sort="default"
                  aria-pressed="true">Mặc
                  định</button>
                <button type="button" data-sort="weak"
                  aria-pressed="false">Điểm
                  yếu trước</button>
              </div>
            </div>
          </section>
          <div id="filterBackdrop" class="filter-backdrop" aria-hidden="true"
            hidden></div>
          <aside id="filterPanel" class="filter-drawer" aria-label="Bộ lọc"
            aria-modal="true" role="dialog" tabindex="-1" hidden>
            <header class="filter-drawer-header">
              <span class="filter-drawer-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                  viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round"><line x1="4" x2="4" y1="21"
                    y2="14"></line><line x1="4" x2="4" y1="10"
                    y2="3"></line><line x1="12" x2="12" y1="21"
                    y2="12"></line><line x1="12" x2="12" y1="8"
                    y2="3"></line><line x1="20" x2="20" y1="21"
                    y2="16"></line><line x1="20" x2="20" y1="12"
                    y2="3"></line><line x1="2" x2="6" y1="14"
                    y2="14"></line><line x1="10" x2="14" y1="8"
                    y2="8"></line><line x1="18" x2="22" y1="16"
                    y2="16"></line></svg>
              </span>
              <div class="filter-drawer-title"><strong>Bộ lọc</strong><span>Lọc
                  và sắp xếp danh sách</span></div>
              <button type="button" id="filterClose" class="filter-close"
                aria-label="Đóng bộ lọc" title="Đóng">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                  viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true"><path
                    d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
              </button>
            </header>
            <div class="filter-drawer-content">
              <section class="filter-group"
                aria-label="Lọc theo nhóm chủ đề ngữ pháp">
                <h2>LỌC THEO NHÓM CHỦ ĐỀ NGỮ PHÁP</h2>
                <div class="filter-options" id="categoryFilters">
                  <button class="category-filter filter-option" type="button"
                    data-category="all" aria-pressed="true">Tất cả chủ đề</button>
                  @if (Model?.Groups != null)
                  {
                    foreach (var group in Model.Groups)
                    {
                      <button class="category-filter filter-option" type="button"
                        data-category="@group.Id" aria-pressed="false">@group.Title</button>
                    }
                  }
                </div>
              </section>
              <section class="filter-group" aria-label="Kỳ thi">
                <h2>KỲ THI</h2>
                <div class="filter-options">
                  <button class="filter-option" type="button" data-exam="all"
                    aria-pressed="true">Tất cả</button>
                  <button class="filter-option" type="button" data-exam="TOEIC"
                    aria-pressed="false">TOEIC</button>
                  <button class="filter-option" type="button" data-exam="VSTEP"
                    aria-pressed="false">VSTEP</button>
                </div>
              </section>
              <section class="filter-group" aria-label="Sắp xếp">
                <h2>SẮP XẾP</h2>
                <div class="filter-options">
                  <button class="filter-option" type="button"
                    data-sort="default" aria-pressed="true">Mặc định</button>
                  <button class="filter-option" type="button" data-sort="weak"
                    aria-pressed="false">Điểm yếu trước</button>
                </div>
              </section>
            </div>
            <footer class="filter-drawer-footer">
              <button type="button" id="filterReset" class="filter-reset"
                disabled>Xóa bộ
                lọc</button>
            </footer>
          </aside>

          <div id="topicSections" role="tabpanel" aria-labelledby="learningTab">
          @if (Model?.Groups != null)
          {
              foreach (var group in Model.Groups)
              {
                  <section class="topic-section" data-group="@group.Id">
                    <div class="topic-section-heading">
                      <div>
                        <h2>@group.Title</h2>
                        <p>@group.Description</p>
                      </div>
                      <span class="topic-section-count">@group.Topics.Count chủ đề</span>
                    </div>
                    <div class="topic-grid">
                      @foreach (var topic in group.Topics)
                      {
                          var stat = Model.State.TopicStats != null && Model.State.TopicStats.TryGetValue(topic.Id, out var s) ? s : null;
                          var done = stat?.Done ?? 0;
                          var correct = stat?.Correct ?? 0;
                          var wrong = stat?.Wrong ?? 0;
                          var topicAcc = done > 0 ? (int)Math.Round((double)(correct * 100) / done) : 0;
                          var isWeak = done > 0 && topicAcc < 50;
                          var totalQ = topic.Questions.Count;
                          var answeredInTopic = topic.Questions.Count(q => Model.State.AnsweredQuestions.Contains(q.Id));

                          <article class="topic-card @(isWeak ? "is-weak" : "")"
                                   data-topic-id="@topic.Id"
                                   data-group="@group.Id"
                                   data-exam="@topic.Exam"
                                   data-title="@topic.Title.ToLowerInvariant()"
                                   data-wrong="@wrong">
                            <div class="topic-card-top">
                              <span class="topic-card-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>
                              </span>
                              <span class="topic-card-title">@topic.Title</span>
                              @if (done > 0)
                              {
                                <button class="topic-bookmark" type="button" data-reset-topic="@topic.Id"
                                        aria-label="Làm lại từ đầu chủ đề @topic.Title"
                                        title="Làm lại từ đầu">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                                </button>
                              }
                              <span class="topic-exam-badge">@topic.Exam</span>
                            </div>
                            <div class="topic-progress">
                              <div class="topic-progress-heading">
                                <span>Mức độ chính xác</span>
                                <strong class="@(isWeak ? "text-weak" : "")">@(topicAcc)%</strong>
                              </div>
                              <div class="topic-progress-track">
                                <div class="topic-progress-fill @(isWeak ? "fill-weak" : "")" style="width:@(topicAcc)%"></div>
                              </div>
                            </div>
                            <div class="topic-card-footer">
                              <span class="topic-question-count">@answeredInTopic/@totalQ câu</span>
                              @if (totalQ > 0)
                              {
                                <button class="practice-button" type="button" data-practice="@topic.Id">
                                  Luyện ngay <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                </button>
                              }
                              else
                              {
                                <button class="practice-button" type="button" disabled style="opacity: 0.65; cursor: not-allowed; background: #94a3b8;" title="Chủ đề đang được cập nhật câu hỏi">
                                  Đang cập nhật
                                </button>
                              }
                            </div>
                          </article>
                      }

                      <article class="topic-utility-card topic-card-review" data-utility-card="review" data-group="@group.Id" data-exam="all">
                        <div class="utility-content">
                          <div class="utility-heading">
                            <span class="utility-icon" aria-hidden="true">
                              <i class="fa-solid fa-shuffle"></i>
                            </span>
                            <h3 class="utility-title">Ôn tập ngẫu nhiên</h3>
                          </div>
                          <p class="utility-description">Luyện câu hỏi ngẫu nhiên từ các chủ đề trong <strong>@group.Title</strong>.</p>
                          <div class="utility-footer">
                            <div class="choice-pills" data-size-group="review" role="group" aria-label="Số câu ôn tập">
                              <button type="button" data-size="20" aria-pressed="true"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>20 câu</button>
                              <button type="button" data-size="30" aria-pressed="false">30 câu</button>
                              <button type="button" data-size="50" aria-pressed="false">50 câu</button>
                            </div>
                            <button class="practice-button" type="button" data-start-group="@group.Id" data-mode="review">
                              Bắt đầu ôn tập <i class="fa-solid fa-arrow-right ms-1"></i>
                            </button>
                          </div>
                        </div>
                      </article>

                      @if (group == Model.Groups.FirstOrDefault())
                      {
                        <article class="topic-utility-card test-card topic-card-mini-test" data-utility-card="mini-test" data-group="@group.Id" data-exam="all">
                          <div class="utility-content">
                            <div class="utility-heading">
                              <span class="utility-icon" aria-hidden="true">
                                <i class="fa-regular fa-clipboard"></i>
                              </span>
                              <h3 class="utility-title">Mini Test</h3>
                              <div class="utility-actions">
                                <button class="topic-bookmark" type="button" data-start-group="@group.Id" data-mode="test" aria-label="Làm lại Mini Test" title="Làm lại Mini Test">
                                  <i class="fa-solid fa-rotate-right"></i>
                                </button>
                                <span class="topic-exam-badge">TOEIC</span>
                              </div>
                            </div>
                            <p class="utility-description">Bài kiểm tra các chủ đề trong <strong>@group.Title</strong>, đếm ngược thời gian làm cho từng câu.</p>
                            <div class="utility-footer">
                              <div class="choice-pills">
                                <button type="button" aria-pressed="true"><i class="fa-regular fa-clock me-1"></i>1p</button>
                                <button type="button" aria-pressed="false"><i class="fa-regular fa-clock me-1"></i>30s</button>
                              </div>
                              <button class="practice-button minitest-btn" type="button" data-start-group="@group.Id" data-mode="test">
                                Làm tiếp <i class="fa-solid fa-arrow-right ms-1"></i>
                              </button>
                            </div>
                          </div>
                        </article>
                      }
                    </div>
                  </section>
              }
          }
          </div>
          <div id="emptyState">
            <i class="fa-solid fa-magnifying-glass mb-2 text-xl"
              aria-hidden="true"></i>
            <p class="m-0 font-bold">Không tìm thấy chủ đề phù
              hợp.</p>
            <p class="mb-0 mt-1 text-xs">Thử đổi từ khóa hoặc bộ lọc
              nhé.</p>
          </div>
        </div>
        <section id="practicePage" class="practice-page" hidden
          aria-labelledby="practiceTitle">
          <div class="practice-content">
            <nav aria-label="Breadcrumb" class="practice-breadcrumb">
              <a class="practice-breadcrumb-link" aria-label="Trang chủ" href="/">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house size-3.5"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
              </a>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3.5 shrink-0 text-muted-foreground/60" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
              <span class="practice-breadcrumb-item">
                <a class="practice-breadcrumb-link" href="/Grammar">Ngữ pháp</a>
              </span>
              <span class="practice-breadcrumb-item" id="practiceTopicCrumbWrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3.5 shrink-0 text-muted-foreground/60" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                <span class="practice-breadcrumb-link" id="practiceTopicCrumb">Các thì hiện tại</span>
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3.5 shrink-0 text-muted-foreground/60" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
              <span class="practice-breadcrumb-current" id="practiceBreadcrumbTitle" aria-current="page">Luyện</span>
            </nav>
            <header class="practice-session-header">
              <div class="mini-test-status" id="miniTestStatus" style="display: none !important;" hidden>
                <span id="miniTestQuestionNumber">1</span>
              </div>
              <div class="practice-header-main">
                <button class="practice-dialog-close"
                  id="practiceClose" type="button"
                  aria-label="Quay lại danh sách chủ đề">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                </button>
                <div class="practice-heading">
                  <h2 id="practiceTitle">Luyện tập ngữ pháp</h2>
                  <div id="practiceProgress"
                    aria-live="polite"></div>
                </div>
                <div class="practice-actions"
                  aria-label="Công cụ luyện tập">
                  <button class="practice-action"
                    id="practiceTheoryToggle"
                    type="button" aria-pressed="false"
                    aria-controls="grammarTheoryDialog">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open">
                      <path d="M12 7v14"></path>
