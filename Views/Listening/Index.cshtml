@{
    ViewData["Title"] = "Luyện Nghe - Listening";
    Layout = "~/Views/Shared/_LayoutSidebar.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/Listening/listening-main.css" asp-append-version="true" />
}

      <main id="basicListeningPage" class="basic-listening-page" hidden aria-labelledby="basicListeningTitle">
        <div class="basic-page-content">
          <nav class="basic-breadcrumbs" aria-label="Đường dẫn">
            <a href="/Dashboard" class="inline-flex items-center text-slate-500 hover:text-cyan-600 transition" aria-label="Trang chủ Dashboard">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house size-3.5"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
            </a>
            <span aria-hidden="true">›</span>
            <a href="/Listening" id="basicBreadcrumbListening" class="hover:text-cyan-600 transition font-medium">Nghe</a>
            <span aria-hidden="true">›</span>
            <strong>Nghe cơ bản (A1 - B1)</strong>
          </nav>
          <header class="basic-page-heading">
            <div>
              <p class="basic-eyebrow">NGHE HIỂU CƠ BẢN (ELLLO)</p>
              <h1 id="basicListeningTitle" tabindex="-1">Listening Basic A1 - B1</h1>
              <p>Luyện nghe từ cơ bản đến trung cấp với hội thoại thực tế, ngữ pháp và từ vựng theo chủ đề.</p>
            </div>
            <aside class="basic-tip">
              <img src="~/assets/images/Listening/listening-basic-buddy-owl.webp" asp-append-version="true" alt="Cú TART">
              <div><strong>Mẹo từ TART</strong><p>Nghe từng câu và đọc transcript song ngữ để nắm nội dung tốt hơn nhé!</p></div>
            </aside>
          </header>
          <div class="basic-page-toolbar">
            <div class="basic-levels" role="group" aria-label="Trình độ">
              <button class="basic-level" type="button" aria-pressed="true">A1 Beginner</button>
              <button class="basic-level" type="button" aria-pressed="false">A2 Elementary</button>
              <button class="basic-level" type="button" aria-pressed="false">B1 Intermediate</button>
            </div>
            <button id="basicListeningBack" class="basic-back" type="button"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Quay lại luyện thi</button>
          </div>
          <section class="basic-topic-row" aria-label="Chủ đề nghe">
            <button class="basic-topic" type="button" aria-pressed="true" data-topic="short"><span class="basic-topic-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square size-5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            </span><span class="basic-topic-copy"><strong>Hội thoại ngắn</strong><span>Độc thoại &amp; hội thoại đơn giản</span></span><span class="basic-topic-count">2 bài</span></button>
            <button class="basic-topic" type="button" aria-pressed="false" data-topic="grammar"><span class="basic-topic-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open size-5"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>
            </span><span class="basic-topic-copy"><strong>Hội thoại ngữ pháp</strong><span>Ngữ pháp trong giao tiếp</span></span><span class="basic-topic-count">25 bài</span></button>
            <button class="basic-topic" type="button" aria-pressed="false"><span class="basic-topic-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers size-5"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg>
            </span><span class="basic-topic-copy"><strong>Từ vựng theo chủ đề</strong><span>Bài nghe theo chủ điểm</span></span><span class="basic-topic-count">0 bài</span></button>
          </section>
          <section class="basic-study-grid" aria-label="Bài nghe">
            <div class="basic-study-left">
              <div>
                <div id="basicGoalCard" class="basic-goal-card">
                <h3 id="basicGoalTitle" class="basic-goal-title">MỤC TIÊU BÀI HỌC</h3>
                <p id="basicGoalDesc" class="basic-goal-desc">Luyện nghe độc thoại giới thiệu bản thân sử dụng thì hiện tại đơn với động từ Be.</p>
              </div>
              <p class="basic-section-label"><span>TRÌNH PHÁT BÀI NGHE</span><span class="basic-topic-count">A1</span></p>
                <div class="basic-player">
                  <div class="basic-player-main">
                    <button id="basicPlayButton" class="basic-player-button" type="button" aria-label="Phát bài nghe"><i class="fa-solid fa-play" aria-hidden="true"></i></button>
                    <div class="basic-player-track"><input id="basicProgress" type="range" min="0" max="72" value="0" aria-label="Vị trí bài nghe"><div class="basic-player-times"><span id="basicCurrentTime">00:00</span><span id="basicDuration">01:12</span></div></div>
                  </div>
                  <div class="basic-player-tools"><button type="button" data-seek="-5" aria-label="Tua lùi 5 giây"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> 5s</button><button type="button" data-seek="5" aria-label="Tua tới 5 giây"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> 5s</button><label><i class="fa-solid fa-volume-high" aria-hidden="true"></i><input type="range" min="0" max="100" value="75" aria-label="Âm lượng"></label></div>
                </div>
              </div>
              <div class="basic-lesson-nav"><button id="basicPrevLesson" type="button" disabled><i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Bài trước</button><button id="basicNextLesson" type="button">Bài tiếp theo <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button></div>
              <section class="basic-lesson-list" aria-label="Danh sách bài học">
                <h2 id="basicLessonListHeader">DANH SÁCH BÀI HỌC (1 / 2)</h2>
                <div id="basicLessonItemsContainer">
                  <button class="basic-lesson-item" type="button" aria-current="true" data-lesson-id="1"><span class="basic-lesson-item-number"><i class="fa-solid fa-play" aria-hidden="true"></i></span><span>Beginner English - 1 - Ten Things about Me!</span></button>
                  <button class="basic-lesson-item" type="button" aria-current="false" data-lesson-id="2"><span class="basic-lesson-item-number">2</span><span>Beginner English - 2 - Where Are You From?</span></button>
                </div>
              </section>
            </div>
            <div class="basic-study-right">
              <div class="basic-current-heading">
                <h2 id="basicCurrentLessonHeading">Beginner English - 1 - Ten Things about Me!</h2>
                <div class="flex items-center gap-2">
                  <button id="basicTranslateButton" class="basic-translate" type="button" aria-pressed="true"><i class="fa-solid fa-language" aria-hidden="true"></i> Dịch song ngữ</button>
                  <button id="basicExpandButton" class="basic-translate" style="width:36px;min-width:36px;padding:0;display:grid;place-items:center;" type="button" title="Phóng to"><i class="fa-solid fa-expand" aria-hidden="true"></i></button>
                </div>
              </div>
              <div id="basicSectionsBar" class="basic-sections-bar mt-2 mb-2" hidden role="tablist" aria-label="Chọn đoạn hội thoại">
                <button class="basic-section-tab" type="button" role="tab" aria-selected="true" data-section-idx="0">Đoạn 1</button>
                <button class="basic-section-tab" type="button" role="tab" aria-selected="false" data-section-idx="1">Đoạn 2</button>
                <button class="basic-section-tab" type="button" role="tab" aria-selected="false" data-section-idx="2">Đoạn 3</button>
                <button class="basic-section-tab" type="button" role="tab" aria-selected="false" data-section-idx="3">Đoạn 4</button>
              </div>
              <div class="basic-transcript-tabs" role="tablist" aria-label="Nội dung bài nghe"><button class="basic-tab" type="button" role="tab" aria-selected="true" data-transcript-tab="content">Nội dung</button><button class="basic-tab" type="button" role="tab" aria-selected="false" data-transcript-tab="notes">Ghi chú</button></div>
              <div id="basicTranscriptList" class="basic-transcript-list">
                <article class="basic-transcript-card"><div class="basic-transcript-meta"><span>00:00</span><button class="basic-transcript-play" type="button" data-speak="Hi, my name is Sarah and I will say 10 things about myself using present simple with Be."><i class="fa-solid fa-play" aria-hidden="true"></i> Play</button></div><p class="basic-transcript-en">Hi, my name is Sarah and I will say 10 things about myself using present simple with Be.</p><p class="basic-transcript-vi">Xin chào, tên tôi là Sarah và tôi sẽ nói 10 điều về bản thân bằng cách sử dụng thì hiện tại đơn với Be.</p></article>
                <article class="basic-transcript-card"><div class="basic-transcript-meta"><span>00:06</span><button class="basic-transcript-play" type="button" data-speak="My name is Sarah. I am a mother. I am also a teacher. I am not a farmer. I am not shy. My daughter is seven years old. She is brave. My son is five years old. He is kind. My children are friendly. They are happy, too. My family is from the USA. We are American."><i class="fa-solid fa-play" aria-hidden="true"></i> Play</button></div><p class="basic-transcript-en">My name is Sarah. I am a mother. I am also a teacher. I am not a farmer. I am not shy. My daughter is seven years old. She is brave. My son is five years old. He is kind. My children are friendly. They are happy, too. My family is from the USA. We are American.</p><p class="basic-transcript-vi">Tên tôi là Sarah. Tôi là một người mẹ. Tôi cũng là một giáo viên. Tôi không phải là nông dân. Tôi không nhút nhát. Con gái tôi bảy tuổi. Con bé dũng cảm. Con trai tôi năm tuổi. Con bé tốt bụng. Các con tôi thân thiện và vui vẻ. Gia đình tôi đến từ Mỹ. Chúng tôi là người Mỹ.</p></article>
                <article class="basic-transcript-card"><div class="basic-transcript-meta"><span>00:12</span><button class="basic-transcript-play" type="button" data-speak="How about you?"><i class="fa-solid fa-play" aria-hidden="true"></i> Play</button></div><p class="basic-transcript-en">How about you?</p><p class="basic-transcript-vi">Còn bạn thì sao?</p></article>
                <article class="basic-transcript-card"><div class="basic-transcript-meta"><span>00:18</span><button class="basic-transcript-play" type="button" data-speak="Can you say 10 things using simple present with Be? You should try."><i class="fa-solid fa-play" aria-hidden="true"></i> Play</button></div><p class="basic-transcript-en">Can you say 10 things using simple present with Be? You should try.</p><p class="basic-transcript-vi">Bạn có thể nói 10 điều bằng thì hiện tại đơn với Be không? Bạn nên thử.</p></article>
              </div>
              <section id="basicNotes" class="basic-notes-card" hidden aria-label="Ghi chú của tôi">
                <h3 class="basic-notes-card-title">GHI CHÚ CỦA TÔI</h3>
                <textarea id="basicNotesInput" class="basic-notes-textarea" placeholder="Ghi lại từ mới, ý chính hoặc câu khó..." spellcheck="false"></textarea>
                <div class="basic-notes-footer">
                  <span id="basicNotesStatus" class="basic-notes-status" aria-live="polite"></span>
                  <span id="basicNotesWordCount">0 ký tự</span>
                </div>
              </section>
            </div>
          </section>
        </div>
        <footer class="basic-rating"><p><strong>BẠN ĐÁNH GIÁ BÀI NGHE NÀY THẾ NÀO?</strong>Chọn một mức độ để đánh dấu đã học.</p><div class="basic-rating-actions"><button type="button" aria-pressed="false">Dễ 😊</button><button type="button" aria-pressed="false">Đã hiểu 👍</button><button type="button" aria-pressed="false">Khó 😟</button></div></footer>
      </main>

      <!-- MAIN CONTENT AREA -->
      <main id="dashboardMain" class="flex-1 flex flex-col gap-4 min-w-0">
        <section
          class="glass-card relative overflow-hidden rounded-3xl border border-cyan-200/80 bg-gradient-to-br from-cyan-50/90 via-teal-50/80 to-emerald-100/90 p-4 shadow-lg dark:border-cyan-500/20 dark:from-cyan-950/50 dark:via-slate-900/80 dark:to-emerald-950/40 sm:p-5"
          aria-labelledby="listeningTitle">
          <div
            class="listening-hero-main relative z-10 flex flex-wrap items-start justify-between gap-4 pr-0">
            <div class="flex min-w-0 items-center gap-2.5 sm:gap-3">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-xl shadow-soft [&_svg]:size-[18px] sm:size-11 sm:rounded-2xl sm:[&_svg]:size-5 bg-skill-listening text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg>
              </span>
              <div class="min-w-0 flex-1">
                <h1 id="listeningTitle" class="text-page-title truncate text-foreground">Luyện nghe theo Chủ đề</h1>
              </div>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center lg:shrink-0">
              <div class="-mx-1 flex scroll-strip gap-2 px-1 sm:mx-0 sm:flex-wrap sm:justify-end sm:overflow-x-visible sm:px-0">
                <div class="min-w-[6.75rem] rounded-xl border border-border/70 bg-card/70 px-2.5 py-1.5 shadow-sm backdrop-blur sm:min-w-[7.5rem] sm:px-3 sm:py-2">
                  <div class="flex items-center gap-1.5 whitespace-nowrap text-[11px] font-medium text-muted-foreground sm:text-xs">
                    <span class="[&_svg]:size-3.5 text-skill-listening">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                    </span>Phần đã luyện
                  </div>
                  <div class="mt-0.5 truncate font-display text-[15px] font-bold leading-5 tracking-tight tabular-nums text-foreground sm:text-base">1/4</div>
                </div>
                <div class="min-w-[6.75rem] rounded-xl border border-border/70 bg-card/70 px-2.5 py-1.5 shadow-sm backdrop-blur sm:min-w-[7.5rem] sm:px-3 sm:py-2">
                  <div class="flex items-center gap-1.5 whitespace-nowrap text-[11px] font-medium text-muted-foreground sm:text-xs">
                    <span class="[&_svg]:size-3.5 text-skill-listening">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg>
                    </span>Phút luyện
                  </div>
                  <div class="mt-0.5 truncate font-display text-[15px] font-bold leading-5 tracking-tight tabular-nums text-foreground sm:text-base">0 phút</div>
                </div>
                <div class="min-w-[6.75rem] rounded-xl border border-border/70 bg-card/70 px-2.5 py-1.5 shadow-sm backdrop-blur sm:min-w-[7.5rem] sm:px-3 sm:py-2">
                  <div class="flex items-center gap-1.5 whitespace-nowrap text-[11px] font-medium text-muted-foreground sm:text-xs">
                    <span class="[&_svg]:size-3.5 text-skill-listening">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg>
                    </span>Câu đã làm
                  </div>
                  <div class="mt-0.5 truncate font-display text-[15px] font-bold leading-5 tracking-tight tabular-nums text-foreground sm:text-base">1/2100</div>
                </div>
                <div class="min-w-[6.75rem] rounded-xl border border-border/70 bg-card/70 px-2.5 py-1.5 shadow-sm backdrop-blur sm:min-w-[7.5rem] sm:px-3 sm:py-2">
                  <div class="flex items-center gap-1.5 whitespace-nowrap text-[11px] font-medium text-muted-foreground sm:text-xs">
                    <span class="[&_svg]:size-3.5 text-skill-listening">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </span>Thời gian/câu
                  </div>
                  <div class="mt-0.5 truncate font-display text-[15px] font-bold leading-5 tracking-tight tabular-nums text-foreground sm:text-base">3s/câu</div>
                </div>
              </div>
            </div>
          </div>
          <img src="~/assets/images/Listening/tart-listening-owl-3d.webp" asp-append-version="true" alt="Cú TART luyện nghe"
            class="listening-hero-mascot">
          <div class="relative mt-11 space-y-1 sm:pr-36 lg:pr-44 xl:pr-52"><div class="flex items-center justify-between text-xs"><span class="font-medium text-muted-foreground">Độ phủ ngân hàng câu nghe</span><span class="font-semibold text-skill-listening">0%</span></div><div role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" class="relative h-2 w-full overflow-hidden rounded-full bg-muted-foreground/15"><div class="h-full rounded-full transition-all duration-500 bg-skill-listening" style="width: 0%;"></div></div></div>
        </section>
        <a id="basicListeningButton" class="glass-card group flex items-center justify-between gap-3 rounded-2xl px-4 py-2.5 sm:px-5 sm:py-3 border border-border/70 dark:border-slate-700/80 shadow-sm transition hover:shadow-md cursor-pointer mx-[75px]" href="/listening/basic" aria-label="Luyện nghe cơ bản">
          <div class="flex min-w-0 items-center gap-2.5 sm:gap-3">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-cyan-600 dark:bg-cyan-500/15 dark:text-cyan-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones size-4.5"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg>
            </span>
            <div class="min-w-0">
              <p class="text-[10px] font-extrabold uppercase tracking-wide text-skill-listening">Mới bắt đầu · A1-B1</p>
              <h2 class="truncate text-xs sm:text-sm font-extrabold text-slate-800 dark:text-white">Luyện nghe cơ bản (Elllo A1 - B1)</h2>
            </div>
          </div>
          <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-skill-listening px-4 py-2 text-xs font-extrabold text-white shadow-md transition hover:brightness-105 group-hover:translate-x-0.5">
            Học ngay <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right size-3.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </span>
        </a>
        <div id="topicModeControl" class="flex items-center justify-end gap-2 px-1"><label
            id="topicModeLabel"
            for="topicModeToggle"
            class="cursor-pointer text-[11px] font-bold text-slate-600 dark:text-slate-300">Luyện nghe theo Chủ đề</label><button type="button" id="topicModeToggle"
            role="switch" aria-checked="false"
            aria-label="Chuyển chế độ luyện nghe theo Part hoặc Chủ đề"
            class="relative h-7 w-12 rounded-full bg-slate-300 dark:bg-slate-700 p-1 transition"><span
              class="block h-5 w-5 translate-x-0 rounded-full bg-white shadow transition-transform flex-shrink-0"></span></button></div>

        <!-- Chế độ Luyện nghe theo Part (Lưới 2x2 rút gọn khi toggle TẮT) -->
        <section id="partOverviewGrid" hidden class="grid-cols-1 gap-4 lg:grid-cols-2" aria-label="Luyện nghe theo Part">
          <!-- Part 1 Overview -->
          <section class="glass-card relative overflow-hidden rounded-3xl border-t-4 border-violet-500 p-4 sm:p-5 flex flex-col justify-between" aria-labelledby="part-grid-1-title">
            <div>
              <div class="relative flex items-start justify-between gap-3">
