            <div class="listening-feedback-options" data-feedback-options="report" role="radiogroup" aria-label="Loại lỗi"><button type="button" data-feedback-category="Sai đáp án" aria-pressed="true">Sai đáp án</button><button type="button" data-feedback-category="Lỗi chính tả / diễn đạt" aria-pressed="false">Lỗi chính tả / diễn đạt</button><button type="button" data-feedback-category="Lỗi khác" aria-pressed="false">Lỗi khác</button></div>
            <div class="listening-feedback-options" data-feedback-options="feedback" role="radiogroup" aria-label="Loại góp ý" hidden><button type="button" data-feedback-category="Đề xuất tính năng mới" aria-pressed="true">Đề xuất tính năng mới</button><button type="button" data-feedback-category="Giao diện khó dùng" aria-pressed="false">Giao diện khó dùng</button><button type="button" data-feedback-category="Nội dung học" aria-pressed="false">Nội dung học</button><button type="button" data-feedback-category="Khác" aria-pressed="false">Khác</button></div>
            <label id="listeningFeedbackDescriptionLabel" class="listening-feedback-label" for="listeningFeedbackDescription">MÔ TẢ THÊM <span>(không bắt buộc)</span></label>
            <textarea id="listeningFeedbackDescription" class="listening-feedback-description" maxlength="1000" placeholder="Ví dụ: đáp án C mới đúng vì..."></textarea>
            <div id="listeningFeedbackCount" class="listening-feedback-count" hidden>0/1000</div>
            <p id="listeningFeedbackError" class="listening-feedback-error" role="alert"></p>
          </div>
          <footer class="listening-feedback-actions"><button id="cancelListeningFeedback" type="button">Hủy</button><button id="submitListeningFeedback" type="submit">Gửi báo lỗi</button></footer>
        </form>
      </div>
      <div id="listeningFeedbackToast" class="listening-feedback-toast" role="status" aria-live="polite" hidden></div>
    </section>

    <section id="listeningTheoryScreen" hidden aria-modal="true" role="dialog" aria-labelledby="listeningTheoryTitle">
      <header class="listening-theory-header">
        <span class="listening-theory-header-icon"><i class="fa-solid fa-headphones" aria-hidden="true"></i></span>
        <strong id="listeningTheoryTitle">Lý thuyết nghe</strong>
        <button id="closeListeningTheory" class="listening-theory-close" type="button" aria-label="Đóng lý thuyết"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      </header>
      <div id="listeningTheoryScroll" class="listening-theory-scroll"><div id="listeningTheoryContent" class="listening-theory-content"></div></div>
      <footer class="listening-theory-footer"><button id="listeningTheoryPractice" class="listening-theory-start" type="button"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Luyện tập ngay <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></footer>
    </section>

    <div id="goalModal" class="goal-modal-overlay" hidden>
      <section class="goal-modal" role="dialog" aria-modal="true"
        aria-labelledby="goalModalTitle"
        aria-describedby="goalModalDescription">
        <header class="goal-modal-header">
          <span class="goal-modal-icon" aria-hidden="true">
            <i class="fa-solid fa-trophy"></i>
          </span>
          <h2 class="goal-modal-title" id="goalModalTitle">Mục tiêu kỳ thi</h2>
          <button class="goal-modal-close" id="goalModalClose" type="button"
            aria-label="Đóng">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </header>
        <form class="goal-modal-form" id="goalForm">
          <p id="goalModalDescription" class="sr-only">Chọn kỳ thi, điểm TOEIC
            mục tiêu và ngày thi dự kiến.</p>
          <div class="goal-field">
            <span class="goal-field-label">Kỳ thi</span>
            <div class="goal-exam-options" role="group"
              aria-label="Chọn kỳ thi">
              <button class="goal-exam-option" type="button"
                aria-pressed="true">TOEIC</button>
              <button class="goal-exam-option" type="button" disabled>VSTEP ·
                Chưa hỗ trợ</button>
            </div>
          </div>
          <label class="goal-field" for="goalScoreInput">
            <span class="goal-field-label">Điểm mục tiêu TOEIC</span>
            <input class="goal-input" id="goalScoreInput" name="score"
              type="number" min="10" max="990" step="5" value="650" required>
          </label>
          <label class="goal-field" for="goalDateInput">
            <span class="goal-field-label">Ngày thi dự kiến</span>
            <input class="goal-input" id="goalDateInput" name="date"
              type="date" required>
          </label>
          <div class="goal-modal-actions">
            <button class="goal-cancel" id="goalCancelButton"
              type="button">Hủy</button>
            <button class="goal-save" id="goalSaveButton" type="submit"
              disabled>Lưu mục tiêu</button>
          </div>
        </form>
      </section>
    </div>
}

@section Scripts {
    <script src="~/assets/js/Listening/listening-main.js" asp-append-version="true"></script>
}
