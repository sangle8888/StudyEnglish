          <p class="sr-only">Hạng 1</p>
          <p id="podiumName1" class="leaderboard-podium-name relative mt-2 line-clamp-2 max-w-[65%] px-2 font-display text-sm font-extrabold text-foreground sm:text-base">Nam Phùng</p>
          <p id="podiumValue1" class="leaderboard-podium-value relative mt-0.5 font-display font-extrabold tabular-nums text-2xl sm:text-3xl text-medal-gold">99h 36p</p>
          <p id="podiumSlogan1" class="leaderboard-podium-quote relative mt-1 max-w-[85%] px-3 text-xs text-muted-foreground">Học nhiều hơn, tiến xa hơn</p>
        </div>

