@{
    ViewData["Title"] = "Bảng Xếp Hạng - Leaderboard";
    Layout = "~/Views/Shared/_LayoutSidebar.cshtml"; 
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/Leaderboard/Leaderboard-main.css" asp-append-version="true" />
}

<!-- MAIN CONTENT AREA -->
<main id="dashboardMain" class="mx-auto w-full px-4 sm:px-6 pb-safe leaderboard-main max-w-[1280px] min-w-0 flex-1">
  <div class="leaderboard-page space-y-4">
    <header class="leaderboard-header flex flex-wrap items-center justify-between gap-3">
      <h1 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-3xl lg:text-4xl">Bảng xếp hạng</h1>
      <span class="inline-flex items-center gap-2 rounded-full border border-slate-200/80 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80 px-3 py-1.5 text-xs font-bold text-slate-600 dark:text-slate-300 shadow-sm backdrop-blur mt-1">
        <span class="size-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
        Cập nhật 1 phút trước
      </span>
    </header>

    <div class="leaderboard-filters flex flex-col gap-3">
      <!-- Mobile Filters -->
      <div class="flex w-full gap-2 lg:hidden">
        <div class="relative min-w-0 flex-1">
          <button id="mobileMetricBtn" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Chọn tiêu chí xếp hạng" class="min-h-touch flex w-full items-center gap-2 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 px-3.5 py-2 text-sm font-bold text-slate-800 dark:text-slate-100 shadow-sm transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock3 size-4 shrink-0 text-slate-500 dark:text-slate-400" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16.5 12"></polyline></svg>
            <span id="mobileMetricLabel" class="min-w-0 flex-1 truncate text-left">Thời gian học</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 text-slate-500 dark:text-slate-400" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </button>
        </div>
        <div class="relative min-w-0 flex-1">
          <button id="mobilePeriodBtn" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Chọn khoảng thời gian" class="min-h-touch flex w-full items-center gap-2 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 px-3.5 py-2 text-sm font-bold text-slate-800 dark:text-slate-100 shadow-sm transition-colors">
            <span id="mobilePeriodLabel" class="min-w-0 flex-1 truncate text-left">Mọi thời điểm</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 text-slate-500 dark:text-slate-400" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </button>
        </div>
      </div>

      <!-- Desktop Filters -->
      <div class="hidden lg:flex lg:items-center lg:justify-between lg:gap-3">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Bảng xếp hạng">
          <button type="button" role="tab" data-metric="studyTime" aria-selected="true" class="leaderboard-tab min-h-touch inline-flex items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-bold transition-all bg-blue-600 text-white shadow-soft">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock3 size-4 shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16.5 12"></polyline></svg>
            Thời gian học
          </button>
          <button type="button" role="tab" data-metric="correctAnswers" aria-selected="false" class="leaderboard-tab min-h-touch inline-flex items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-bold transition-all border border-slate-200/90 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check size-4 shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
            Số câu đúng
          </button>
          <button type="button" role="tab" data-metric="studyDays" aria-selected="false" class="leaderboard-tab min-h-touch inline-flex items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-bold transition-all border border-slate-200/90 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days size-4 shrink-0" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg>
            Số ngày học
          </button>
          <button type="button" role="tab" data-metric="learnedWords" aria-selected="false" class="leaderboard-tab min-h-touch inline-flex items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-bold transition-all border border-slate-200/90 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open size-4 shrink-0" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>
            Từ vựng đã ôn
          </button>
          <button type="button" role="tab" data-metric="mockTests" aria-selected="false" class="leaderboard-tab min-h-touch inline-flex items-center gap-2 whitespace-nowrap rounded-full px-4 py-2 text-sm font-bold transition-all border border-slate-200/90 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-column size-4 shrink-0" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></svg>
            Điểm thi thử
          </button>
        </div>

        <div class="flex flex-wrap gap-2">
          <button type="button" data-period="week" aria-pressed="false" class="leaderboard-period-btn min-h-touch whitespace-nowrap rounded-full border px-4 py-2 text-sm font-bold shadow-sm transition-all border-slate-200/90 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:border-amber-400 hover:bg-amber-50">
            Tuần này
          </button>
          <button type="button" data-period="month" aria-pressed="false" class="leaderboard-period-btn min-h-touch whitespace-nowrap rounded-full border px-4 py-2 text-sm font-bold shadow-sm transition-all border-slate-200/90 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 hover:border-amber-400 hover:bg-amber-50">
            Tháng này
          </button>
          <button type="button" data-period="all" aria-pressed="true" class="leaderboard-period-btn min-h-touch whitespace-nowrap rounded-full border px-4 py-2 text-sm font-bold shadow-sm transition-all border-amber-300 dark:border-amber-500/50 bg-[#fef0cd] dark:bg-amber-500/20 text-[#8a5b17] dark:text-amber-300">
            Mọi thời điểm
          </button>
        </div>
      </div>
    </div>

    <div class="leaderboard-results space-y-4">
      <!-- PODIUM SECTION (TOP 3) -->
      <div class="leaderboard-podium grid grid-cols-1 gap-3 sm:gap-4 sm:grid-cols-3">
        <!-- TOP 1 (Nam Phùng) -->
        <div class="leaderboard-podium-card relative min-w-0 flex flex-col items-center justify-center rounded-3xl border px-4 text-center podium-card-gold sm:order-2 leaderboard-podium-winner">
          <svg viewBox="0 0 64 120" fill="none" aria-hidden="true" class="w-auto leaderboard-laurel pointer-events-none absolute left-[2%] top-1/2 -translate-y-1/2 opacity-80 text-medal-gold"><g><path d="M51 115C12 90 6 49 40 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><g transform="translate(39 102) rotate(-42)" fill="currentColor"><path d="M0 0C-17-1-22-12-19-20C-7-16 0-9 0 0Z" opacity="0.85"></path><path d="M0 0C2-15 10-21 17-22C20-11 10-2 0 0Z" opacity="0.6"></path><path d="M-2-2L-16-16M2-3L13-18" stroke="hsl(var(--medal-highlight))" stroke-width="0.7" opacity="0.65"></path></g><g transform="translate(28 88) rotate(-25)" fill="currentColor"><path d="M0 0C-17-1-22-12-19-20C-7-16 0-9 0 0Z" opacity="0.85"></path><path d="M0 0C2-15 10-21 17-22C20-11 10-2 0 0Z" opacity="0.6"></path><path d="M-2-2L-16-16M2-3L13-18" stroke="hsl(var(--medal-highlight))" stroke-width="0.7" opacity="0.65"></path></g><g transform="translate(21 72) rotate(-8)" fill="currentColor"><path d="M0 0C-17-1-22-12-19-20C-7-16 0-9 0 0Z" opacity="0.85"></path><path d="M0 0C2-15 10-21 17-22C20-11 10-2 0 0Z" opacity="0.6"></path><path d="M-2-2L-16-16M2-3L13-18" stroke="hsl(var(--medal-highlight))" stroke-width="0.7" opacity="0.65"></path></g><g transform="translate(19 55) rotate(10)" fill="currentColor"><path d="M0 0C-17-1-22-12-19-20C-7-16 0-9 0 0Z" opacity="0.85"></path><path d="M0 0C2-15 10-21 17-22C20-11 10-2 0 0Z" opacity="0.6"></path><path d="M-2-2L-16-16M2-3L13-18" stroke="hsl(var(--medal-highlight))" stroke-width="0.7" opacity="0.65"></path></g><g transform="translate(23 38) rotate(30)" fill="currentColor"><path d="M0 0C-17-1-22-12-19-20C-7-16 0-9 0 0Z" opacity="0.85"></path><path d="M0 0C2-15 10-21 17-22C20-11 10-2 0 0Z" opacity="0.6"></path><path d="M-2-2L-16-16M2-3L13-18" stroke="hsl(var(--medal-highlight))" stroke-width="0.7" opacity="0.65"></path></g><g transform="translate(31 23) rotate(48)" fill="currentColor"><path d="M0 0C-17-1-22-12-19-20C-7-16 0-9 0 0Z" 