          <svg viewBox="0 0 52 40" fill="none" aria-hidden="true" class="h-10 w-12 leaderboard-crown absolute left-1/2 -translate-x-1/2 drop-shadow-sm text-medal-gold"><defs><linearGradient id="_r_0_" x1="0" y1="0" x2="0.7" y2="1"><stop stop-color="hsl(var(--medal-highlight))"></stop><stop offset="0.45" stop-color="hsl(var(--medal-crown))"></stop><stop offset="1" stop-color="currentColor"></stop></linearGradient></defs><path d="M8 30L4 10L16 20L26 4L36 20L48 10L44 30Z" fill="url(#_r_0_)" stroke="hsl(var(--medal-crown))" stroke-width="2" stroke-linejoin="round"></path><rect x="8" y="30" width="36" height="6" rx="3" fill="url(#_r_0_)"></rect><g fill="hsl(var(--medal-crown))" stroke="hsl(var(--medal-highlight))"><circle cx="4" cy="8" r="3"></circle><circle cx="26" cy="4" r="3"></circle><circle cx="48" cy="8" r="3"></circle></g><path d="M26 16L29 22L26 27L23 22Z" fill="hsl(var(--medal-highlight))"></path></svg>
