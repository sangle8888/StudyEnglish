@model StudyEnglish.Models.ViewModels.Admin.FeedbackListViewModel
@{
    ViewData["Title"] = "Quản lý Góp ý";
}

<div class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1 class="h3 mb-1 fw-bold text-dark">Quản lý Góp ý &amp; Phản hồi</h1>
            <p class="text-muted mb-0 small">Tiếp nhận và xử lý các ý kiến đóng góp từ người dùng nhằm nâng cao chất lượng nền tảng</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i data-lucide="rotate-ccw"></i> Làm mới
            </a>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 rounded-3">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 48px; height: 48px; font-size: 20px;">
                    <i data-lucide="messages-square"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Tổng số góp ý</div>
                    <div class="h4 mb-0 fw-bold">@Model.TotalCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 rounded-3">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger" style="width: 48px; height: 48px; font-size: 20px;">
                    <i data-lucide="bell"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Chưa đọc</div>
                    <div class="h4 mb-0 fw-bold text-danger">@Model.NewCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 rounded-3">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info" style="width: 48px; height: 48px; font-size: 20px;">
                    <i data-lucide="mail-open"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Đã xem</div>
                    <div class="h4 mb-0 fw-bold text-info">@Model.ReadCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 rounded-3">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success" style="width: 48px; height: 48px; font-size: 20px;">
                    <i data-lucide="check-circle"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Đã giải quyết</div>
                    <div class="h4 mb-0 fw-bold text-success">@Model.ResolvedCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i data-lucide="search"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" 
                               placeholder="Tìm theo nội dung, tên, email..." value="@Model.CurrentSearch">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Loại góp ý</label>
                    <select name="type" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả loại --</option>
                        <option value="Đề xuất tính năng mới" selected="@(Model.CurrentType == "Đề xuất tính năng mới")">💡 Đề xuất tính năng mới</option>
                        <option value="Giao diện khó dùng" selected="@(Model.CurrentType == "Giao diện khó dùng")">🎨 Giao diện khó dùng</option>
                        <option value="Nội dung học" selected="@(Model.CurrentType == "Nội dung học")">📚 Nội dung học</option>
                        <option value="Khác" selected="@(Model.CurrentType == "Khác")">💬 Khác</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Trạng thái</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="New" selected="@(Model.CurrentStatus == "New")">Mới (Chưa đọc)</option>
                        <option value="Read" selected="@(Model.CurrentStatus == "Read")">Đã đọc</option>
                        <option value="Resolved" selected="@(Model.CurrentStatus == "Resolved")">Đã giải quyết</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Lọc
                    </button>
                    @if (!string.IsNullOrEmpty(Model.CurrentSearch) || !string.IsNullOrEmpty(Model.CurrentType) || !string.IsNullOrEmpty(Model.CurrentStatus))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                            <i data-lucide="x"></i>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Feedbacks Table -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;" class="text-center">#</th>
                    <th style="width: 180px;">Loại góp ý</th>
                    <th>Nội dung góp ý</th>
                    <th style="width: 200px;">Người gửi</th>
                    <th style="width: 150px;">Thời gian</th>
                    <th style="width: 130px;" class="text-center">Trạng thái</th>
                    <th style="width: 140px;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <div class="d-flex flex-column align-items-center gap-2">
                                <i data-lucide="message-square" class="fs-1 text-secondary opacity-50"></i>
                                <span>Chưa có góp ý nào phù hợp với điều kiện tìm kiếm.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        var badgeClass = item.FeedbackType switch
                        {
                            "Đề xuất tính năng mới" => "bg-primary-subtle text-primary border border-primary-subtle",
                            "Giao diện khó dùng" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                            "Nội dung học" => "bg-info-subtle text-info-emphasis border border-info-subtle",
                            _ => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle"
                        };

                        var statusBadge = item.Status switch
                        {
                            "New" => "bg-danger text-white",
                            "Read" => "bg-info text-white",
                            "Resolved" => "bg-success text-white",
                            _ => "bg-secondary text-white"
                        };

                        var statusText = item.Status switch
                        {
                            "New" => "Chưa đọc",
                            "Read" => "Đã đọc",
                            "Resolved" => "Đã xử lý",
                            _ => item.Status
                        };

                        <tr class="@(item.Status == "New" ? "fw-medium" : "")" id="row-feedback-@item.FeedbackId">
                            <td class="text-center text-muted small">@item.FeedbackId</td>
                            <td>
                                <span class="badge @badgeClass px-2 py-1 rounded-pill small">
                                    @item.FeedbackType
                                </span>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 380px;" title="@item.Content">
                                    @item.Content
                                </div>
                                @if (!string.IsNullOrEmpty(item.AdminNote))
                                {
                                    <div class="small text-muted mt-1">
                                        <i data-lucide="reply" class="text-secondary me-1"></i>
                                        <span class="fst-italic text-secondary">Ghi chú: @item.AdminNote</span>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 32px; height: 32px; font-size: 13px;">
                                        @(string.IsNullOrEmpty(item.SenderName) ? "K" : item.SenderName[0].ToString().ToUpper())
                                    </div>
                                    <div class="small">
                                        <div class="fw-semibold text-dark">@item.SenderName</div>
                                        <div class="text-muted" style="font-size: 11px;">@(item.SenderEmail ?? "Ẩn danh")</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-nowrap small text-muted">
                                @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-center">
                                <span class="badge @statusBadge px-2 py-1 rounded-pill small" id="badge-status-@item.FeedbackId">
                                    @statusText
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary" 
                                        onclick="openFeedbackModal(@item.FeedbackId)" title="Xem chi tiết">
                                    <i data-lucide="eye"></i>
                                </button>
                                @if (item.Status != "Resolved")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" 
                                            onclick="quickResolve(@item.FeedbackId)" title="Đánh dấu đã giải quyết" id="btn-resolve-@item.FeedbackId">
                                        <i data-lucide="check"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        onclick="deleteFeedback(@item.FeedbackId)" title="Xóa góp ý">
                                    <i data-lucide="trash-2"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                Hiển thị trang @Model.PageIndex / @Model.TotalPages (Tổng cộng @Model.TotalCount góp ý)
            </span>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.PageIndex - 1)" 
                           asp-route-type="@Model.CurrentType" 
                           asp-route-status="@Model.CurrentStatus" 
                           asp-route-search="@Model.CurrentSearch">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@p" 
                               asp-route-type="@Model.CurrentType" 
                               asp-route-status="@Model.CurrentStatus" 
                               asp-route-search="@Model.CurrentSearch">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.PageIndex + 1)" 
                           asp-route-type="@Model.CurrentType" 
                           asp-route-status="@Model.CurrentStatus" 
                           asp-route-search="@Model.CurrentSearch">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Modal Chi tiết góp ý -->
<div class="modal fade" id="feedbackDetailModal" tabindex="-1" aria-labelledby="feedbackDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <div>
                    <span class="badge bg-primary-subtle text-primary px-2 py-1 rounded-pill small mb-2" id="modalFeedbackType">Loại góp ý</span>
                    <h5 class="modal-title fw-bold" id="feedbackDetailModalLabel">Chi tiết góp ý #<span id="modalFeedbackId"></span></h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small fw-medium">Người gửi:</div>
                            <div class="fw-bold text-dark" id="modalSenderName">--</div>
                            <div class="text-muted small" id="modalSenderEmail">--</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="text-muted small fw-medium">Thời gian gửi:</div>
                            <div class="fw-bold text-dark" id="modalCreatedAt">--</div>
                            <div class="text-muted small" id="modalResolvedAt">--</div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">NỘI DUNG GÓP Ý</label>
                    <div class="p-3 border rounded-3 bg-white" id="modalContent" style="white-space: pre-wrap; min-height: 100px; font-size: 15px; line-height: 1.6;">
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-secondary">TRẠNG THÁI XỬ LÝ</label>
                        <select id="modalStatusSelect" class="form-select">
                            <option value="New">Chưa đọc (New)</option>
                            <option value="Read">Đã đọc (Read)</option>
                            <option value="Resolved">Đã giải quyết (Resolved)</option>
                        </select>
                    </div>
                    <div class="col-md-7">
                        <label class="form-label small fw-bold text-secondary">GHI CHÚ NỘI BỘ CỦA ADMIN</label>
                        <textarea id="modalAdminNote" class="form-control" rows="2" placeholder="Ghi chú kế hoạch xử lý, tính năng tiếp nhận..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary px-4" id="btnSaveFeedback">
                    <i data-lucide="save" class="me-1"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentDetailModal = null;
        let currentEditingId = null;

        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('feedbackDetailModal');
            if (modalEl) {
                currentDetailModal = new bootstrap.Modal(modalEl);
            }

            document.getElementById('btnSaveFeedback').addEventListener('click', saveFeedbackChanges);

            if (window.lucide) {
                lucide.createIcons();
            }
        });

        async function openFeedbackModal(id) {
            currentEditingId = id;
            try {
                const res = await fetch(`/Admin/Feedback/GetDetails/${id}`);
                const data = await res.json();
                if (data.success) {
                    const fb = data.data;
                    document.getElementById('modalFeedbackId').textContent = fb.id;
                    document.getElementById('modalFeedbackType').textContent = fb.feedbackType;
                    document.getElementById('modalSenderName').textContent = fb.senderName;
                    document.getElementById('modalSenderEmail').textContent = fb.senderEmail;
                    document.getElementById('modalCreatedAt').textContent = fb.createdAt;
                    document.getElementById('modalResolvedAt').textContent = fb.resolvedAt ? `Giải quyết: ${fb.resolvedAt}` : 'Chưa giải quyết';
                    document.getElementById('modalContent').textContent = fb.content;
                    document.getElementById('modalStatusSelect').value = fb.status;
                    document.getElementById('modalAdminNote').value = fb.adminNote || '';

                    // Cập nhật badge ở row bảng sang "Đã đọc" nếu trước đó là "New"
                    const badge = document.getElementById(`badge-status-${id}`);
                    if (badge && badge.textContent.trim() === 'Chưa đọc') {
                        badge.className = 'badge bg-info text-white px-2 py-1 rounded-pill small';
                        badge.textContent = 'Đã đọc';
                    }

                    currentDetailModal.show();
                } else {
                    alert(data.message || 'Không thể tải chi tiết góp ý.');
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi xảy ra khi tải dữ liệu.');
            }
        }

        async function saveFeedbackChanges() {
            if (!currentEditingId) return;
            const status = document.getElementById('modalStatusSelect').value;
            const adminNote = document.getElementById('modalAdminNote').value;
            const saveBtn = document.getElementById('btnSaveFeedback');

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

            try {
                const res = await fetch('/Admin/Feedback/UpdateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        feedbackId: currentEditingId,
                        status: status,
                        adminNote: adminNote
                    })
                });
                const result = await res.json();
                if (result.success) {
                    currentDetailModal.hide();
                    location.reload();
                } else {
                    alert(result.message || 'Không thể lưu thay đổi.');
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi xảy ra khi lưu.');
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i data-lucide="save" class="me-1"></i> Lưu thay đổi';
                if (window.lucide) lucide.createIcons();
            }
        }

        async function quickResolve(id) {
            if (!confirm('Đánh dấu góp ý này là đã giải quyết?')) return;
            try {
                const res = await fetch(`/Admin/Feedback/QuickResolve/${id}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await res.json();
                if (result.success) {
                    const badge = document.getElementById(`badge-status-${id}`);
                    if (badge) {
                        badge.className = 'badge bg-success text-white px-2 py-1 rounded-pill small';
                        badge.textContent = 'Đã xử lý';
                    }
                    const resolveBtn = document.getElementById(`btn-resolve-${id}`);
                    if (resolveBtn) resolveBtn.remove();
                } else {
                    alert(result.message || 'Thao tác không thành công.');
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi xảy ra.');
            }
        }

        async function deleteFeedback(id) {
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn góp ý này?')) return;
            try {
                const res = await fetch(`/Admin/Feedback/Delete/${id}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await res.json();
                if (result.success) {
                    const row = document.getElementById(`row-feedback-${id}`);
                    if (row) {
                        row.classList.add('table-danger');
                        setTimeout(() => row.remove(), 300);
                    }
                } else {
                    alert(result.message || 'Không thể xóa góp ý.');
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi xảy ra khi xóa.');
            }
        }
    </script>
}
