@inject StudyEnglish.Data.AppDbContext DbContext
@{
    int unreadFeedbackCount = 0;
    try
    {
        unreadFeedbackCount = DbContext.Feedbacks.Count(f => f.Status == "New");
    }
    catch { }
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <script>document.documentElement.classList.add('js')</script>
  <script>(function(){var t;try{t=localStorage.getItem('homeroom-theme')}catch(e){}if(t!=='light'&&t!=='dark'){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.setAttribute('data-bs-theme',t);try{if(localStorage.getItem('homeroom-sidebar-collapsed')==='true'){document.documentElement.classList.add('collapsed')}}catch(e){}})()</script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>@ViewData["Title"] - Quản trị hệ thống StudyEnglish</title>
  <meta name="description" content="Khu vực quản trị hệ thống StudyEnglish">
  <meta name="theme-color" content="#4f46e5">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='12' fill='%234f46e5'/%3E%3Cpath d='M10.5 21 20 12.5l9.5 8.5M14 19v9h12v-9' fill='none' stroke='%23fff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='30' cy='10.5' r='4' fill='%23ff7a5c'/%3E%3C/svg%3E">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="~/admin/css/vendor/bootstrap.min.css" asp-append-version="true">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="~/admin/css/style.css?v=20261103.1" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="">

  <a class="skip-link" href="#main">Chuyển đến nội dung chính</a>
  <!-- Backdrop cho menu mobile -->
  <button id="sbBackdrop" type="button" aria-label="Đóng menu" tabindex="-1"></button>

  <!-- Admin Sidebar -->
  <aside id="adminSidebar" aria-label="Điều hướng chính">
    <div class="sb-brand">
      <div class="sb-logo">
        <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <rect class="bm-bg" width="40" height="40" rx="12"/>
          <path class="bm-line" d="M10.5 21 20 12.5l9.5 8.5"/>
          <path class="bm-line" d="M14 19v9h12v-9"/>
          <path class="bm-line" d="M18 28v-4.5h4V28"/>
          <circle class="bm-sun" cx="30" cy="10.5" r="4"/>
        </svg>
      </div>
      <div class="sb-title"><b>StudyEnglish</b><small>Quản trị</small></div>
      <button class="sb-btn sb-close" id="menuClose" type="button" aria-label="Đóng menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <nav class="sb-nav">
      <div class="sb-group">
        <a class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" title="Tổng quan">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
          <span class="sb-label">Tổng quan</span>
        </a>
      </div>

      <div class="sb-group">
        <div class="sb-group-label">Nội dung</div>
        <a class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Grammar_management" ? "active" : "")" asp-area="Admin" asp-controller="Grammar_management" asp-action="Index" title="Quản lý Ngữ pháp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
          <span class="sb-label">Ngữ pháp</span>
        </a>
        <a class="sb-item" href="#" title="Từ vựng">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><path d="m8 13 4-7 4 7M9.1 11h5.7"/></svg>
          <span class="sb-label">Từ vựng</span>
        </a>
        <a class="sb-item" href="#" title="Nghe">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>
          <span class="sb-label">Nghe</span>
        </a>
        <a class="sb-item" href="#" title="Đọc">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8M8 9h2"/></svg>
          <span class="sb-label">Đọc</span>
        </a>
        <a class="sb-item" href="#" title="Đề thi thử">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <span class="sb-label">Đề thi thử</span>
        </a>
      </div>

      <div class="sb-group">
        <div class="sb-group-label">Người dùng</div>
        <a class="sb-item" asp-area="Admin" asp-controller="Users" asp-action="Index" title="Người dùng">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="sb-label">Người dùng</span>
        </a>
        <a class="sb-item" href="#" title="Bảng xếp hạng">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          <span class="sb-label">Bảng xếp hạng</span>
        </a>
        <a class="sb-item" href="#" title="Phân quyền">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          <span class="sb-label">Phân quyền</span>
        </a>
      </div>

      <div class="sb-group">
        <div class="sb-group-label">Hệ thống</div>
        <a class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Feedback" ? "active" : "")" asp-area="Admin" asp-controller="Feedback" asp-action="Index" title="Góp ý">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span class="sb-label">Góp ý</span>
          @if (unreadFeedbackCount > 0)
          {
            <span class="sb-badge" aria-label="@unreadFeedbackCount góp ý chưa đọc">@unreadFeedbackCount</span>
          }
        </a>
        <a class="sb-item" href="#" title="Cài đặt">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          <span class="sb-label">Cài đặt</span>
        </a>
      </div>
    </nav>

    <div class="sb-foot">
      <div class="sb-user">
        <div class="sb-avatar" aria-hidden="true">AD</div>
        <div class="sb-user-info">
          <b>@(User.Identity?.Name ?? "Quản trị viên")</b>
            <span class="sb-user-role">Quản trị viên</span>
        </div>
      </div>
      <div class="sb-actions">
        <button class="sb-btn" type="button" data-theme-toggle aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện">
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6.5 6.5 0 0 0 8.268 8.268c.344-.215.825-.003.803.401"/></svg>
        </button>
        <a class="sb-btn sb-logout" asp-area="" asp-controller="Login" asp-action="Logout" title="Đăng xuất">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          <span>Đăng xuất</span>
        </a>
      </div>
    </div>

    <!-- Nút thu gọn trên mép sidebar -->
    <button id="sbCollapse" type="button" aria-label="Thu gọn thanh điều hướng" aria-expanded="true">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
  </aside>

  <header class="topbar">
    <div class="topbar-inner">
      <button class="icon-btn sb-hamburger me-2 d-lg-none" id="menuOpen" type="button" aria-label="Mở menu" aria-controls="adminSidebar">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <a class="brand d-lg-none me-auto" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-label="StudyEnglish Admin">
        <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect class="bm-bg" width="40" height="40" rx="12"/><path class="bm-line" d="M10.5 21 20 12.5l9.5 8.5"/><path class="bm-line" d="M14 19v9h12v-9"/><path class="bm-line" d="M18 28v-4.5h4V28"/><circle class="bm-sun" cx="30" cy="10.5" r="4"/></svg>
        <span class="brand-text"><span class="brand-name">StudyEnglish</span><span class="brand-school">Admin Panel</span></span>
      </a>

      <span class="term-chip ms-0 me-auto d-none d-md-inline-flex">
        <svg class="ic text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3 2"/>
        </svg>
        <span id="topbarLiveClock" data-live-clock class="fw-semibold">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span>
      </span>

      <nav class="portal-switch" aria-label="Chuyển chế độ xem">
        <a asp-area="" asp-controller="Home" asp-action="Index"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg> Trang học viên</a>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-current="page"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l7.58-7.58c.94-.94.94-2.48 0-3.42L12 2z"/></svg> Quản trị</a>
      </nav>

      <div class="topbar-actions ms-auto ms-md-0">
        <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Đổi giao diện sáng/tối">
          <svg class="ic ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="ic ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>

        <div class="dropdown">
          <button class="account-btn" type="button" data-bs-toggle="dropdown" data-bs-offset="0,10" aria-expanded="false" aria-label="Menu tài khoản">
            <span class="avatar avatar-sm av-indigo" aria-hidden="true">AD</span>
            <span class="account-name">@(User.Identity?.Name ?? "Admin")</span>
            <svg class="ic ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <ul class="dropdown-menu dropdown-menu-end account-menu">
            <li class="account-card">
              <span class="avatar av-indigo" aria-hidden="true">AD</span>
              <span>
                <strong>@(User.Identity?.Name ?? "Quản trị viên")</strong>
                <span id="accountCardLiveClock" data-live-clock style="font-size: 0.8rem; color: var(--hr-muted); display: block;">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span>
              </span>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <div class="dropdown-item d-flex align-items-center gap-2 py-2" style="cursor: default; pointer-events: none; color: var(--hr-ink);" title="Thời gian hiện tại">
                <svg class="ic text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M12 7v5l3 2"/>
                </svg>
                <span id="adminLiveClock" data-live-clock class="fw-bold">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span>
              </div>
            </li>
            <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Login" asp-action="Logout"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg> Đăng xuất</a></li>
          </ul>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main id="main" class="app-main">
    <div class="page">
      @RenderBody()
    </div>
  </main>

  <script src="~/admin/js/vendor/bootstrap.bundle.min.js" asp-append-version="true"></script>
  <script src="~/admin/js/main.js" asp-append-version="true"></script>
  <script>
    (function () {
      function padZero(num) {
        return num < 10 ? '0' + num : String(num);
      }

      function updateAllLiveClocks() {
        try {
          var now = new Date();
          var d = padZero(now.getDate());
          var m = padZero(now.getMonth() + 1);
          var y = now.getFullYear();
          var hr = padZero(now.getHours());
          var min = padZero(now.getMinutes());
          var sec = padZero(now.getSeconds());
          var formatted = d + '/' + m + '/' + y + ' ' + hr + ':' + min + ':' + sec;

          var clockElements = document.querySelectorAll('[data-live-clock]');
          for (var i = 0; i < clockElements.length; i++) {
            clockElements[i].textContent = formatted;
          }
        } catch (err) {
          console.error('Lỗi cập nhật đồng hồ:', err);
        }
      }

      updateAllLiveClocks();
      setInterval(updateAllLiveClocks, 1000);
    })();
  </script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    lucide.createIcons();
  </script>
  @await RenderSectionAsync("Scripts", required: false)
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      if (window.lucide) {
        lucide.createIcons();
      }
    });
  </script>
</body>
</html>
