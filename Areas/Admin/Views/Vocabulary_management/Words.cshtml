    async function editWord(id) {
        try {
            const res = await fetch(`/Admin/Vocabulary_management/GetWord/${id}`);
            const json = await res.json();
            if (!json.success) {
                showToast(json.message || 'Không tìm thấy dữ liệu từ vựng.', 'danger');
                return;
            }
            const w = json.data;
            document.getElementById('modalWordTitle').innerText = `Chỉnh Sửa Từ Vựng: ${w.word}`;
            document.getElementById('wordId').value = w.wordId;
            document.getElementById('wordTopicId').value = w.topicId;
            document.getElementById('wordText').value = w.word;
            document.getElementById('wordPos').value = (w.partOfSpeech || 'noun').toLowerCase();
            document.getElementById('wordPhoneticUs').value = w.phoneticUs || '';
            document.getElementById('wordPhoneticUk').value = w.phoneticUk || '';
            document.getElementById('wordMeaning').value = w.meaning;
            document.getElementById('wordEnglishDefinition').value = w.englishDefinition || '';
            document.getElementById('wordAudioUrl').value = w.audioUrl || '';
            document.getElementById('wordImageUrl').value = w.imageUrl || '';
            document.getElementById('wordSortOrder').value = w.sortOrder || 1;
            document.getElementById('wordIsActive').checked = w.isActive;

            const rawExSentences = String(w.exampleSentence || '').split(/\r\n|\r|\n|\|\|\|/).map(s => s.trim()).filter(Boolean);
            const rawExMeanings = String(w.exampleMeaning || '').split(/\r\n|\r|\n|\|\|\|/).map(s => s.trim());
            document.getElementById('wordExampleSentence').value = rawExSentences[0] || '';
            document.getElementById('wordExampleMeaning').value = rawExMeanings[0] || '';
            extraExamplesList = rawExSentences.slice(1).map((en, i) => ({
                en,
                vi: rawExMeanings[i + 1] || ''
            }));
            if (document.getElementById('extraExEnInput')) document.getElementById('extraExEnInput').value = '';
            if (document.getElementById('extraExViInput')) document.getElementById('extraExViInput').value = '';
            renderExtraExamplesUI();
            document.getElementById('wordCollocations').value = w.collocations || '';
            if (document.getElementById('collocEnInput')) document.getElementById('collocEnInput').value = '';
            if (document.getElementById('collocViInput')) document.getElementById('collocViInput').value = '';
            document.getElementById('wordSynonyms').value = w.synonyms || '';
            document.getElementById('wordAntonyms').value = w.antonyms || '';
            ['wordCollocations', 'wordSynonyms', 'wordAntonyms'].forEach(syncTagInputUI);

            modalSensesData = [];
            if (w.sensesJson) {
                try {
                    const parsed = JSON.parse(w.sensesJson);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        modalSensesData = parsed.map(s => ({
                            partOfSpeech: s.partOfSpeech || (w.partOfSpeech || 'noun').toLowerCase(),
                            meaning: s.meaning || w.meaning || '',
                            englishDefinition: s.englishDefinition || '',
                            examples: Array.isArray(s.examples) ? s.examples.map(e => ({ en: e.en || e.En || (Array.isArray(e) ? e[0] : ''), vi: e.vi || e.Vi || (Array.isArray(e) ? e[1] : '') })) : [],
                            collocations: s.collocations || '',
                            synonyms: s.synonyms || '',
                            antonyms: s.antonyms || ''
                        }));
                    }
                } catch { modalSensesData = []; }
            }

            if (!modalSensesData || modalSensesData.length === 0) {
                modalSensesData = [{
                    partOfSpeech: (w.partOfSpeech || 'noun').toLowerCase(),
                    meaning: w.meaning || '',
                    englishDefinition: w.englishDefinition || '',
                    examples: extraExamplesList.length > 0 ? extraExamplesList : [],
                    collocations: w.collocations || '',
                    synonyms: w.synonyms || '',
                    antonyms: w.antonyms || ''
                }];
            }
            renderModalSensesUI();

            document.getElementById('wordFamily').value = w.wordFamily || '';
            document.getElementById('wordCommonMistakeWrong').value = w.commonMistakeWrong || '';
            document.getElementById('wordCommonMistakeRight').value = w.commonMistakeRight || '';
            document.getElementById('wordCommonMistakeNote').value = w.commonMistakeNote || '';
            document.getElementById('wordMemoryTip').value = w.memoryTip || '';

            document.getElementById('wordUseManualQuiz').checked = Boolean(w.useManualQuiz);
            let manualArr = [];
            try {
                if (w.quizDistractorsJson) manualArr = JSON.parse(w.quizDistractorsJson) || [];
            } catch { manualArr = []; }
            document.getElementById('wordDistractor1').value = manualArr[0] || '';
            document.getElementById('wordDistractor2').value = manualArr[1] || '';
            document.getElementById('wordDistractor3').value = manualArr[2] || '';
            toggleManualQuizInputs();
            cachedDbQuizPreview = null;
            fetchDbQuizPreview(true);

            updateLiveModalPreview();
            switchModalWordTab('tab-word-core-tab');
            new bootstrap.Modal(document.getElementById('modalWord')).show();
            if (window.lucide) lucide.createIcons();
        } catch (e) {
            showToast('Lỗi kết nối khi tải từ vựng.', 'danger');
        }
    }

    async function saveWord() {
        const form = document.getElementById('formWord');
        if (!form.checkValidity()) {
            switchModalWordTab('tab-word-core-tab');
            form.reportValidity();
            return;
        }

        const useManual = Boolean(document.getElementById('wordUseManualQuiz')?.checked);
        const manualDistractors = getManualDistractorsArray();

        const primaryExEn = document.getElementById('wordExampleSentence').value.replace(/\r?\n+/g, ' ').trim();
        const primaryExVi = document.getElementById('wordExampleMeaning').value.replace(/\r?\n+/g, ' ').trim();
        const combinedPairs = [];
        if (primaryExEn || primaryExVi) combinedPairs.push({ en: primaryExEn, vi: primaryExVi });
        for (const ex of extraExamplesList) {
            if (ex.en?.trim()) combinedPairs.push({ en: ex.en.replace(/\r?\n+/g, ' ').trim(), vi: (ex.vi || '').replace(/\r?\n+/g, ' ').trim() });
        }
        const combinedExampleSentence = combinedPairs.map(p => p.en).join('\n');
        const combinedExampleMeaning = combinedPairs.some(p => p.vi) ? combinedPairs.map(p => p.vi || ' ').join('\n') : '';

        syncModalSensesHidden();
        const sensesVal = document.getElementById('wordSensesJson')?.value?.trim() || null;

        const data = {
            WordId: parseInt(document.getElementById('wordId').value) || 0,
            TopicId: parseInt(document.getElementById('wordTopicId').value) || @Model.TopicId,
            Word: document.getElementById('wordText').value.trim(),
            PartOfSpeech: document.getElementById('wordPos').value,
            PhoneticUs: document.getElementById('wordPhoneticUs').value.trim(),
            PhoneticUk: document.getElementById('wordPhoneticUk').value.trim(),
            Meaning: document.getElementById('wordMeaning').value.trim(),
            EnglishDefinition: document.getElementById('wordEnglishDefinition').value.trim(),
            ExampleSentence: combinedExampleSentence,
            ExampleMeaning: combinedExampleMeaning,
            Collocations: document.getElementById('wordCollocations').value.trim(),
            Synonyms: document.getElementById('wordSynonyms').value.trim(),
            Antonyms: document.getElementById('wordAntonyms').value.trim(),
            SensesJson: sensesVal,
            WordFamily: document.getElementById('wordFamily').value.trim(),
            CommonMistakeWrong: document.getElementById('wordCommonMistakeWrong').value.trim(),
            CommonMistakeRight: document.getElementById('wordCommonMistakeRight').value.trim(),
            CommonMistakeNote: document.getElementById('wordCommonMistakeNote').value.trim(),
            MemoryTip: document.getElementById('wordMemoryTip').value.trim(),
            QuizDistractorsJson: useManual && manualDistractors.length ? JSON.stringify(manualDistractors) : null,
            UseManualQuiz: useManual,
            AudioUrl: document.getElementById('wordAudioUrl').value.trim(),
            ImageUrl: document.getElementById('wordImageUrl').value.trim(),
            SortOrder: parseInt(document.getElementById('wordSortOrder').value) || 1,
            IsActive: document.getElementById('wordIsActive').checked
        };

        try {
            const res = await fetch('/Admin/Vocabulary_management/SaveWord', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify(data)
            });
            const json = await res.json();
            if (json.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalWord'))?.hide();
                showToast(json.message || 'Lưu từ vựng thành công!');
                setTimeout(() => location.reload(), 600);
            } else {
                showToast(json.message || 'Lưu thất bại.', 'danger');
            }
        } catch (e) {
            showToast('Lỗi máy chủ khi lưu từ vựng.', 'danger');
        }
    }

