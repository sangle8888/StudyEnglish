    const defaultPhraseCategoryCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCode ?? ""));
    const defaultPhraseSetTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopicTitle ?? "General"));

    function updatePhraseModalPreview() {
        const left = document.getElementById('phraseLeftWord').value.trim();
        const right = document.getElementById('phraseRightWord').value.trim();
        const before = document.getElementById('phraseSentenceBefore').value.trim();
        const after = document.getElementById('phraseSentenceAfter').value.trim();
        const previewEl = document.getElementById('phraseLivePreview');
        if (!previewEl) return;

        previewEl.replaceChildren();
        if (!left && !right) {
            const placeholder = document.createElement('span');
            placeholder.className = 'text-muted fst-italic';
            placeholder.textContent = 'Nhập Vế 1 và Vế 2 để xem trước...';
            previewEl.appendChild(placeholder);
            return;
        }

        if (before) previewEl.append(document.createTextNode(before + ' '));
        const leftSpan = document.createElement('span');
        leftSpan.className = 'phrase-part-left me-1';
        leftSpan.textContent = left || '...';
        const rightSpan = document.createElement('span');
        rightSpan.className = 'phrase-part-right';
        rightSpan.textContent = right || '...';
        previewEl.append(leftSpan, rightSpan);
        if (after) previewEl.append(document.createTextNode(' ' + after));
    }

    function openPhraseModal() {
        document.getElementById('modalPhraseTitle').innerText = 'Thêm Cụm Từ Ghép Mới';
        document.getElementById('formPhrase').reset();
        document.getElementById('phrasePairId').value = '0';
        const catSelect = document.getElementById('phraseTopicCategory');
        if (defaultPhraseCategoryCode && [...catSelect.options].some(o => o.value === defaultPhraseCategoryCode)) {
            catSelect.value = defaultPhraseCategoryCode;
        }
        document.getElementById('phraseSetTitle').value = defaultPhraseSetTitle;
        document.getElementById('phraseSortOrder').value = '1';
        document.getElementById('phraseIsActive').checked = true;
        const aiFocusInput = document.getElementById('phraseAiFocusWord');
        if (aiFocusInput) aiFocusInput.value = '';
        const aiStatusEl = document.getElementById('phraseAiStatus');
        if (aiStatusEl) aiStatusEl.textContent = 'Chọn từ trong bộ thẻ học hoặc nhập từ mới để AI tự động tách Vế 1, Vế 2, nghĩa và câu ví dụ.';
        updatePhraseModalPreview();
        new bootstrap.Modal(document.getElementById('modalPhrase')).show();
    }

    async function aiGeneratePhraseFromFocusWord() {
        const input = document.getElementById('phraseAiFocusWord');
        const btn = document.getElementById('btnAiSuggestPhrase');
        const statusEl = document.getElementById('phraseAiStatus');
        const focusWord = (input?.value || '').trim();
        if (!focusWord) {
            statusEl.innerHTML = '<span class="text-danger fw-semibold">Vui lòng nhập hoặc chọn từ vựng gốc trọng tâm.</span>';
            input?.focus();
            return;
        }
        const token = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]')?.value || '';
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang sinh...';
        statusEl.textContent = `AI đang tạo câu hỏi ghép cụm từ cho "${focusWord}"...`;
        try {
            const res = await fetch('/Admin/Vocabulary_management/AiSuggestPhrasePair', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({
                    focusWord,
                    topicId: @(Model.TopicId),
                    setTitle: document.getElementById('phraseSetTitle').value || defaultPhraseSetTitle
                })
            });
            const json = await res.json();
            if (!res.ok || !json.success || !json.data) {
                statusEl.innerHTML = `<span class="text-danger">${json.message || 'Không thể sinh câu hỏi.'}</span>`;
                return;
            }
            const d = json.data;
            document.getElementById('phraseLeftWord').value = d.leftWord || '';
            document.getElementById('phraseRightWord').value = d.rightWord || '';
            document.getElementById('phraseMeaning').value = d.meaning || '';
            document.getElementById('phraseSentenceBefore').value = d.sentenceBefore || '';
            document.getElementById('phraseSentenceAfter').value = d.sentenceAfter || '';
            updatePhraseModalPreview();
            statusEl.innerHTML = `<span class="text-success fw-semibold">Đã sinh xong (${d.source === 'smart-fallback' ? 'Gợi ý thông minh' : 'AI'}): "${d.leftWord} ${d.rightWord}".</span>`;
        } catch (err) {
            statusEl.innerHTML = '<span class="text-danger">Lỗi kết nối máy chủ khi gọi AI.</span>';
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            if (window.lucide) lucide.createIcons();
        }
    }

    function updateAiBatchSelectedCount() {
        const checked = document.querySelectorAll('.ai-batch-word-cb:checked').length;
        const el = document.getElementById('aiBatchSelectedCount');
        if (el) el.textContent = `Đã chọn ${checked} từ`;
    }

    function toggleAiBatchWords(onlyMissing) {
        let count = 0;
        document.querySelectorAll('.ai-batch-word-cb').forEach((cb) => {
            if (!onlyMissing) {
                cb.checked = false;
            } else {
                const isMissing = cb.dataset.hasPhrase !== 'true';
                cb.checked = isMissing && count < 10;
                if (cb.checked) count += 1;
            }
        });
        updateAiBatchSelectedCount();
    }

    function openAiPhraseBatchModal() {
        document.getElementById('aiBatchStatusMsg').innerHTML = '';
        toggleAiBatchWords(true);
        new bootstrap.Modal(document.getElementById('aiPhraseBatchModal')).show();
        if (window.lucide) lucide.createIcons();
    }

    async function submitAiPhraseBatch() {
        const wordIds = [...document.querySelectorAll('.ai-batch-word-cb:checked')]
            .map((cb) => parseInt(cb.value, 10))
            .filter((id) => !Number.isNaN(id))
            .slice(0, 10);
        const statusEl = document.getElementById('aiBatchStatusMsg');
        const btn = document.getElementById('btnRunAiPhraseBatch');
        if (wordIds.length === 0) {
            statusEl.innerHTML = '<div class="alert alert-warning py-2 mb-0">Vui lòng chọn ít nhất 1 từ vựng gốc trọng tâm.</div>';
            return;
        }
        const token = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]')?.value || '';
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang sinh câu hỏi...';
        statusEl.innerHTML = `<div class="text-primary small">AI đang xử lý ${wordIds.length} từ vựng gốc...</div>`;
        try {
            const res = await fetch('/Admin/Vocabulary_management/AiGeneratePhrasesFromTopic', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({
                    topicId: @(Model.TopicId),
                    categoryCode: defaultPhraseCategoryCode,
                    setTitle: defaultPhraseSetTitle,
                    wordIds
                })
            });
            const json = await res.json();
            if (!res.ok || !json.success) {
                statusEl.innerHTML = `<div class="alert alert-danger py-2 mb-0">${json.message || 'Không thể sinh câu hỏi.'}</div>`;
                return;
            }
            statusEl.innerHTML = `<div class="alert alert-success py-2 mb-0">${json.message}</div>`;
            if (json.addedCount > 0) {
                setTimeout(() => {
                    window.location.href = '@Url.Action("Words", "Vocabulary_management", new { area = "Admin", id = Model.TopicId, tab = "phrases" })';
                }, 900);
            }
        } catch {
            statusEl.innerHTML = '<div class="alert alert-danger py-2 mb-0">Lỗi kết nối máy chủ khi gọi AI.</div>';
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            if (window.lucide) lucide.createIcons();
        }
    }

    async function editPhrase(id) {
        try {
            const res = await fetch(`/Admin/Vocabulary_management/GetPhrase/${id}`);
            const json = await res.json();
            if (!json.success) {
                showToast(json.message || 'Không tìm thấy cụm từ.', 'danger');
                return;
            }
            const p = json.data;
            document.getElementById('modalPhraseTitle').innerText = `Chỉnh Sửa Cụm Từ: ${p.leftWord} ${p.rightWord}`;
            document.getElementById('phrasePairId').value = p.pairId;
            const catSelect = document.getElementById('phraseTopicCategory');
            const catVal = (p.topicCategory || defaultPhraseCategoryCode || 'business').toLowerCase();
            if (![...catSelect.options].some(o => o.value === catVal)) {
                const opt = document.createElement('option');
                opt.value = catVal;
                opt.textContent = catVal;
                catSelect.appendChild(opt);
            }
            catSelect.value = catVal;
            document.getElementById('phraseSetTitle').value = p.setTitle || defaultPhraseSetTitle;
            document.getElementById('phraseLeftWord').value = p.leftWord || '';
            document.getElementById('phraseRightWord').value = p.rightWord || '';
            document.getElementById('phraseMeaning').value = p.meaning || '';
            document.getElementById('phraseSentenceBefore').value = p.sentenceBefore || '';
            document.getElementById('phraseSentenceAfter').value = p.sentenceAfter || '';
            document.getElementById('phraseSortOrder').value = p.sortOrder || 1;
            document.getElementById('phraseIsActive').checked = Boolean(p.isActive);
            updatePhraseModalPreview();
            new bootstrap.Modal(document.getElementById('modalPhrase')).show();
        } catch (e) {
            showToast('Lỗi tải dữ liệu cụm từ.', 'danger');
        }
    }

    async function savePhrase() {
        const form = document.getElementById('formPhrase');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const data = {
            PairId: parseInt(document.getElementById('phrasePairId').value, 10) || 0,
            TopicCategory: document.getElementById('phraseTopicCategory').value.trim(),
            SetTitle: document.getElementById('phraseSetTitle').value.trim() || defaultPhraseSetTitle,
            LeftWord: document.getElementById('phraseLeftWord').value.trim(),
            RightWord: document.getElementById('phraseRightWord').value.trim(),
            Meaning: document.getElementById('phraseMeaning').value.trim(),
            SentenceBefore: document.getElementById('phraseSentenceBefore').value.trim(),
            SentenceAfter: document.getElementById('phraseSentenceAfter').value.trim(),
            SortOrder: parseInt(document.getElementById('phraseSortOrder').value, 10) || 1,
            IsActive: document.getElementById('phraseIsActive').checked
        };

        try {
            const res = await fetch('/Admin/Vocabulary_management/SavePhrase', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify(data)
            });
            const json = await res.json();
            if (json.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalPhrase'))?.hide();
                showToast(json.message || 'Lưu cụm từ ghép thành công!');
                setTimeout(() => reloadWithTab('phrases'), 600);
            } else {
                showToast(json.message || 'Lưu cụm từ thất bại.', 'danger');
            }
        } catch (e) {
            showToast('Lỗi máy chủ khi lưu cụm từ.', 'danger');
        }
    }

    async function togglePhraseStatus(id) {
        try {
            const res = await fetch(`/Admin/Vocabulary_management/TogglePhraseStatus/${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getAntiForgeryToken() }
            });
            const json = await res.json();
            if (json.success) {
                const row = document.getElementById(`phrase-row-${id}`);
                if (row) {
                    row.setAttribute('data-status', json.isActive ? 'active' : 'inactive');
                    const cell = row.querySelector('.phrase-status-cell button');
                    if (cell) {
                        cell.innerHTML = json.isActive
                            ? '<span class="badge text-bg-success"><i data-lucide="check-circle" class="me-1"></i>Hiển thị</span>'
                            : '<span class="badge text-bg-secondary"><i data-lucide="eye-off" class="me-1"></i>Ẩn</span>';
                        if (window.lucide) lucide.createIcons();
                    }
                }
                showToast(json.message);
            } else {
                showToast(json.message || 'Không thể cập nhật trạng thái.', 'danger');
            }
        } catch (e) {
            showToast('Lỗi kết nối máy chủ.', 'danger');
        }
    }

    async function deletePhrase(id, label) {
        if (!confirm(`Bạn có chắc chắn muốn xóa cụm từ "${label}"?`)) return;

        try {
            const res = await fetch(`/Admin/Vocabulary_management/DeletePhrase/${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getAntiForgeryToken() }
            });
            const json = await res.json();
            if (json.success) {
                const row = document.getElementById(`phrase-row-${id}`);
                if (row) {
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '0';
                    setTimeout(() => {
                        row.remove();
                        if (typeof window.filterWordsPhrases === 'function') window.filterWordsPhrases();
                    }, 300);
                }
                showToast(json.message || 'Đã xóa cụm từ!');
            } else {
                showToast(json.message || 'Không thể xóa cụm từ.', 'danger');
            }
        } catch (e) {
            showToast('Lỗi khi xóa cụm từ.', 'danger');
        }
    }
</script>
}
