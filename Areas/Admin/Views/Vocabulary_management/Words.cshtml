    async function previewBulkImport() {
        const rawData = document.getElementById('bulkRawData').value.trim();
        if (!rawData) {
            showToast('Vui lòng chọn tệp CSV hoặc dán dữ liệu trước khi kiểm tra.', 'warning');
            return;
        }
        try {
            const res = await fetch('/Admin/Vocabulary_management/PreviewBulkImport', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({ TopicId: @Model.TopicId, RawData: rawData })
            });
            const json = await res.json();
            if (!json.success) {
                showToast(json.message || 'Không phân tích được dữ liệu.', 'danger');
                return;
            }
            const wrap = document.getElementById('bulkPreviewWrap');
            const summary = document.getElementById('bulkPreviewSummary');
            const tbody = document.getElementById('bulkPreviewBody');
            wrap.style.display = 'block';
            summary.innerHTML = `Tổng ${json.totalRows} dòng: <span class="text-success">${json.validCount} hợp lệ</span> · <span class="text-warning">${json.warningCount} cảnh báo</span> · <span class="text-danger">${json.errorCount} lỗi (sẽ bỏ qua)</span>`;
            tbody.innerHTML = (json.rows || []).map(r => {
                const badgeClass = r.status === 'error'
                    ? 'bg-danger-subtle text-danger'
                    : (r.status === 'warning' ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success');
                const statusText = (r.issues && r.issues.length) ? r.issues.join('; ') : 'Hợp lệ ✓';
                return `
                    <tr class="${r.status === 'error' ? 'table-danger' : ''}">
                        <td>${r.rowNumber}</td>
                        <td class="fw-bold">${escapeHtmlModal(r.word || '(trống)')}</td>
                        <td>${escapeHtmlModal(r.partOfSpeech || 'noun')}</td>
                        <td>${escapeHtmlModal(r.meaning || '(trống)')}</td>
                        <td>${escapeHtmlModal(r.exampleSentence || '-')}</td>
                        <td><span class="badge ${badgeClass}">${escapeHtmlModal(statusText)}</span></td>
                    </tr>`;
            }).join('');
        } catch {
            showToast('Lỗi kết nối khi kiểm tra CSV.', 'danger');
        }
    }

