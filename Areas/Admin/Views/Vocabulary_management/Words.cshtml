    function updateLiveModalPreview() {
        const currentId = parseInt(document.getElementById('wordId').value) || 0;
        const wordRaw = document.getElementById('wordText').value.trim();
        const word = wordRaw || 'Headword';
        const meaningRaw = document.getElementById('wordMeaning').value.trim();
        const meaning = meaningRaw || 'Nghĩa tiếng Việt';
        const pos = document.getElementById('wordPos').value;
        const us = document.getElementById('wordPhoneticUs').value.trim();
        const uk = document.getElementById('wordPhoneticUk').value.trim();
        const phonetics = us || uk ? `${us ? 'US: ' + us : ''} ${uk ? 'UK: ' + uk : ''}`.trim() : '/phonetics/';
        const engDef = document.getElementById('wordEnglishDefinition').value.trim();
        const exSent = document.getElementById('wordExampleSentence').value.trim();
        const exMean = document.getElementById('wordExampleMeaning').value.trim();
        const collocs = document.getElementById('wordCollocations').value.trim();
        const isActive = document.getElementById('wordIsActive').checked;

        // Tab 1: Xem nhanh thẻ Từ
        document.getElementById('prevTermPos').innerText = pos;
        document.getElementById('prevTermWord').innerText = word;
        document.getElementById('prevTermPhonetics').innerText = phonetics;
        document.getElementById('prevTermMeaning').innerText = meaning;

        // Tab 2: Quiz Preview (Auto vs Manual Override)
        const quizSyncInput = document.getElementById('quizCorrectMeaningSync');
        if (quizSyncInput && document.activeElement !== quizSyncInput) {
            quizSyncInput.value = meaningRaw;
        }
        document.getElementById('quizPreviewPrompt').innerText = `Nghĩa đúng của "${word}" là gì?`;

        const useManual = document.getElementById('wordUseManualQuiz')?.checked;
        const distractors = [];
        if (useManual) {
            for (const d of getManualDistractorsArray()) {
                if (d.toLowerCase() !== meaning.toLowerCase() && !distractors.includes(d)) {
                    distractors.push(d);
                }
            }
        }
        if (cachedDbQuizPreview?.distractors?.length) {
            for (const m of cachedDbQuizPreview.distractors) {
                if (distractors.length >= 3) break;
                if (m && m.toLowerCase() !== meaning.toLowerCase() && !distractors.includes(m)) {
                    distractors.push(m);
                }
            }
        }
        for (const item of topicWordChoices) {
            if (distractors.length >= 3) break;
            const m = (item.meaning || '').trim();
            if (item.wordId !== currentId && m && m.toLowerCase() !== meaning.toLowerCase() && !distractors.includes(m)) {
                distractors.push(m);
            }
        }
        const fallbackDistractors = ['đáp án nhiễu 1', 'đáp án nhiễu 2', 'đáp án nhiễu 3'];
        for (const fb of fallbackDistractors) {
            if (distractors.length >= 3) break;
            if (!distractors.includes(fb) && fb !== meaning.toLowerCase()) {
                distractors.push(fb);
            }
        }
        const quizLabels = ['A', 'B', 'C', 'D'];
        const quizList = [{ text: meaning, correct: true }, ...distractors.slice(0, 3).map(d => ({ text: d, correct: false }))];
        document.getElementById('quizPreviewOptions').innerHTML = quizList.map((opt, idx) => `
            <div class="col-md-6">
                <div class="p-2 px-3 rounded-3 border ${opt.correct ? 'border-success bg-success-subtle text-success-emphasis fw-semibold' : 'bg-white text-dark'} d-flex justify-content-between align-items-center">
                    <span><span class="badge ${opt.correct ? 'bg-success' : 'bg-secondary-subtle text-secondary'} me-2">${quizLabels[idx]}</span>${escapeHtmlModal(opt.text)}</span>
                    ${opt.correct ? '<span class="small fw-bold">✓ Đúng</span>' : ''}
                </div>
            </div>`).join('');

        // Tab 3: Gõ Preview (hiển thị [ . . . ] và từ cần gõ)
        let typingBefore = 'Please learn how to use';
        let typingAfter = 'in context.';
        let typingAnswer = wordRaw;
        let matchedExample = false;
        let matchedBracket = false;
        const firstSent = exSent.split(/\r\n|\r|\n|\|\|\|/)[0].trim();
        if (firstSent) {
            const bracketMatch = /\[([^\[\]]+)\]/.exec(firstSent);
            if (bracketMatch && bracketMatch[1].trim()) {
                matchedExample = true;
                matchedBracket = true;
                typingAnswer = bracketMatch[1].trim();
                typingBefore = firstSent.slice(0, bracketMatch.index).trim();
                typingAfter = firstSent.slice(bracketMatch.index + bracketMatch[0].length).trim();
            } else if (wordRaw) {
                const match = new RegExp(`\\b${escapeRegexModal(wordRaw)}\\b`, 'i').exec(firstSent)
                    || new RegExp(escapeRegexModal(wordRaw), 'i').exec(firstSent);
                if (match) {
                    matchedExample = true;
                    typingAnswer = match[0];
                    typingBefore = firstSent.slice(0, match.index).trim();
                    typingAfter = firstSent.slice(match.index + match[0].length).trim();
                }
            }
        }

        const alertBox = document.getElementById('typingMatchAlert');
        if (!wordRaw && !matchedBracket) {
            alertBox.innerHTML = `<div class="alert alert-secondary py-2 px-3 small mb-0">Nhập <strong>Từ tiếng Anh</strong> ở Tab 1 hoặc bọc <code>[từ]</code> trong câu ví dụ.</div>`;
        } else if (matchedBracket) {
            alertBox.innerHTML = `<div class="alert alert-success py-2 px-3 small mb-0">✓ Đã đánh dấu ô trống <code>[${escapeHtmlModal(typingAnswer)}]</code>. Từ cần gõ: <strong>${escapeHtmlModal(typingAnswer)}</strong>.</div>`;
        } else if (matchedExample) {
            alertBox.innerHTML = `<div class="alert alert-warning py-2 px-3 small mb-0">Tìm thấy từ <strong>${escapeHtmlModal(typingAnswer)}</strong> nhưng nên bôi đen và bấm <strong>Đặt làm ô trống</strong> để chuẩn hóa cú pháp <code>[${escapeHtmlModal(typingAnswer)}]</code>.</div>`;
        } else {
            alertBox.innerHTML = `<div class="alert alert-warning py-2 px-3 small mb-0">Câu ví dụ chưa có <code>[...]</code>. Bôi đen từ cần điền rồi bấm <strong>Đặt làm ô trống</strong> hoặc bấm <strong>Tạo câu mẫu [từ]</strong>.</div>`;
        }

        document.getElementById('typingPreviewSentence').innerHTML =
            `${escapeHtmlModal(typingBefore)} <span class="d-inline-block px-3 py-0 mx-1 rounded-2 border border-primary bg-primary-subtle text-primary fw-bold font-monospace">[ . . . ] <small class="text-muted fw-normal">(${escapeHtmlModal(typingAnswer || '______')})</small></span> ${escapeHtmlModal(typingAfter)}`;
        document.getElementById('typingPreviewTranslation').innerText =
            `Gợi ý nghĩa: ${exMean || meaning}`;
    }

