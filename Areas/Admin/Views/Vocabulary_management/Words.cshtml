@model VocabTopicWordsViewModel
@{
    ViewData["Title"] = $"Từ vựng - {Model.TopicTitle}";
    var isPhrasesTab = string.Equals(Model.ActiveTab, "phrases", StringComparison.OrdinalIgnoreCase);
    var topicTitleNorm = (Model.TopicTitle ?? string.Empty).Trim();
    var topicPhraseCount = Model.Phrases.Count(p => string.Equals((p.SetTitle ?? "General").Trim(), topicTitleNorm, StringComparison.OrdinalIgnoreCase));
    var generalPhraseCount = Model.Phrases.Count(p => string.Equals((p.SetTitle ?? "General").Trim(), "General", StringComparison.OrdinalIgnoreCase));
    var categoryNameMap = Model.Categories
        .GroupBy(c => c.Code.ToLower())
        .ToDictionary(g => g.Key, g => g.First().Name);
    var distinctPhraseSets = Model.Phrases
        .Select(p => string.IsNullOrWhiteSpace(p.SetTitle) ? "General" : p.SetTitle.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s)
        .ToList();
}

@section Styles {
<style>
    .admin-filter-bar .input-group-search {
        display: flex;
        align-items: center;
        background: var(--hr-surface, #fff);
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        border-radius: 12px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        height: 42px;
        overflow: hidden;
    }
    .admin-filter-bar .input-group-search:focus-within {
        border-color: var(--hr-primary, #4f46e5);
        box-shadow: var(--hr-ring, 0 0 0 4px rgba(79, 70, 229, 0.22));
    }
    .admin-filter-bar .input-group-search .search-icon {
        padding: 0 10px 0 14px;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .admin-filter-bar .input-group-search input.form-control {
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
        padding-left: 0 !important;
        height: 100% !important;
        font-size: 0.92rem;
    }
    .admin-filter-bar .form-select {
        height: 42px;
        border-radius: 12px;
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        font-size: 0.92rem;
    }
    .admin-filter-bar .btn-filter-reset {
        height: 42px;
        border-radius: 12px;
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* POS Badges */
    .badge-pos {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 6px;
    }
    .badge-pos-noun { background: #e0e7ff; color: #4338ca; }
    .badge-pos-verb { background: #dcfce7; color: #15803d; }
    .badge-pos-adj { background: #fef3c7; color: #b45309; }
    .badge-pos-adv { background: #f3e8ff; color: #7e22ce; }
    .badge-pos-phrase { background: #cffafe; color: #0e7490; }

    /* Audio Speaker Button */
    .btn-audio-speak {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #4f46e5;
        transition: all 0.15s ease;
        padding: 0;
        cursor: pointer;
    }
    .btn-audio-speak:hover {
        background: #4f46e5;
        color: #ffffff;
        border-color: #4f46e5;
        transform: scale(1.08);
    }

    [data-bs-theme="dark"] .card-header {
        background-color: var(--hr-surface-2, #242247) !important;
        border-bottom-color: var(--hr-line, #2d2a52) !important;
        color: var(--hr-ink, #f2f0fb) !important;
    }
    [data-bs-theme="dark"] .table thead,
    [data-bs-theme="dark"] .table thead th {
        background-color: var(--hr-surface-2, #242247) !important;
        color: var(--hr-ink, #f2f0fb) !important;
        border-bottom-color: var(--hr-line, #2d2a52) !important;
    }
    [data-bs-theme="dark"] .table > :not(caption) > * > * {
        background-color: transparent;
        color: var(--hr-ink, #f2f0fb);
        border-bottom-color: var(--hr-line, #2d2a52);
    }
    [data-bs-theme="dark"] .table-hover > tbody > tr:hover > * {
        background-color: rgba(143, 136, 255, 0.08) !important;
        color: var(--hr-ink, #f2f0fb);
    }
    [data-bs-theme="dark"] .table-active {
        --bs-table-active-bg: rgba(143, 136, 255, 0.15);
        --bs-table-active-color: var(--hr-ink, #f2f0fb);
    }

    /* Mode Switcher Tabs (Học thẻ / Ghép cụm từ) */
    .vocab-mode-tabs {
        display: inline-flex;
        gap: 6px;
        padding: 6px;
        border-radius: 16px;
        background: var(--hr-surface, #ffffff);
        border: 1.5px solid var(--hr-line-2, #e2e8f0);
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    }
    .vocab-mode-tabs .nav-link {
        border-radius: 12px;
        padding: 9px 18px;
        font-weight: 600;
        font-size: 0.92rem;
        color: #475569;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.15s ease;
    }
    .vocab-mode-tabs .nav-link:hover {
        background: #f1f5f9;
        color: #1e293b;
    }
    .vocab-mode-tabs .nav-link.active {
        background: var(--hr-primary, #4f46e5);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    }
    .vocab-mode-tabs .nav-link.active .badge {
        background: rgba(255, 255, 255, 0.22) !important;
        color: #ffffff !important;
        border-color: transparent !important;
    }
    [data-bs-theme="dark"] .vocab-mode-tabs {
        background: var(--hr-surface, #1b1a37);
        border-color: var(--hr-line, #2d2a52);
    }
    [data-bs-theme="dark"] .vocab-mode-tabs .nav-link {
        color: var(--hr-muted, #aaa6cb);
    }
    [data-bs-theme="dark"] .vocab-mode-tabs .nav-link:hover {
        background: rgba(143, 136, 255, 0.12);
        color: var(--hr-ink, #f2f0fb);
    }
    [data-bs-theme="dark"] .vocab-mode-tabs .nav-link.active {
        background: var(--hr-primary, #6366f1);
        color: #ffffff;
    }
    .phrase-pair-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }
    .phrase-part-left {
        background: #eef2ff;
        color: #4338ca;
        padding: 3px 10px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.88rem;
    }
    .phrase-part-right {
        background: #ecfeff;
        color: #0e7490;
        padding: 3px 10px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.88rem;
    }
    [data-bs-theme="dark"] .phrase-part-left {
        background: rgba(99, 102, 241, 0.2);
        color: #a5b4fc;
    }
    [data-bs-theme="dark"] .phrase-part-right {
        background: rgba(6, 182, 212, 0.2);
        color: #67e8f9;
    }
    .custom-count-badge {
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
    }
    [data-bs-theme="dark"] .custom-count-badge {
        background-color: var(--hr-surface-2, #242247) !important;
        color: var(--hr-ink-2, #d6d2f0) !important;
        border-color: var(--hr-line-2, #3c3968) !important;
    }
</style>
}

<div class="mb-4">
    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none d-inline-flex align-items-center gap-1 text-secondary mb-2">
        <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i> Quay lại danh sách thư mục cha / con
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1 class="h3 mb-0 fw-bold">@Model.TopicTitle</h1>
            <div class="text-muted small mt-1 d-flex flex-wrap align-items-center gap-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Thư mục cha: @Model.CategoryTitle</span>
                <span class="text-muted">›</span>
                <span class="badge bg-secondary-subtle text-secondary">Cấp độ: @Model.Level</span>
                <span>· <strong id="headerWordCount">@Model.Words.Count</strong> từ (Học thẻ)</span>
                <span>· <strong id="headerPhraseCount">@topicPhraseCount</strong>/@Model.Phrases.Count cụm (Ghép cụm từ)</span>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" onclick="openBulkImportModal()" title="Nhập danh sách từ vựng từ tệp Excel/CSV">
                <i data-lucide="file-spreadsheet" class="me-1"></i>Nhập Excel / CSV
            </button>
            <button type="button" class="btn btn-primary rounded-pill px-3 shadow-sm" onclick="openWordModal()">
                <i data-lucide="plus" class="me-1"></i>Thêm từ vựng
            </button>
            <button type="button" class="btn btn-info text-white rounded-pill px-3 shadow-sm" onclick="openPhraseModal()">
                <i data-lucide="plus" class="me-1"></i>Thêm cụm từ ghép
            </button>
            <a class="btn btn-outline-primary rounded-pill px-3" asp-action="CreateWord" asp-route-topicId="@Model.TopicId" title="Soạn thảo toàn màn hình">
                <i data-lucide="pen-tool" class="me-1"></i>Soạn thảo chi tiết
            </a>
        </div>
    </div>
</div>

<div id="indexAlertContainer"></div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i data-lucide="check-circle" class="me-2 text-success"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<!-- TAB CHUYỂN CHẾ ĐỘ QUẢN LÝ TRONG BỘ TỪ: HỌC THẺ / GHÉP CỤM TỪ -->
<div class="mb-4">
    <ul class="nav vocab-mode-tabs" id="vocabWordsModeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(!isPhrasesTab ? "active" : "")"
                    id="tab-words-flashcards"
                    data-bs-toggle="pill"
                    data-bs-target="#pane-words-flashcards"
                    data-words-tab="flashcards"
                    type="button"
                    role="tab"
                    aria-controls="pane-words-flashcards"
                    aria-selected="@(!isPhrasesTab ? "true" : "false")">
                <i data-lucide="layers" style="width: 17px; height: 17px;"></i>
                <span>Quản lý Học thẻ</span>
                <span class="badge rounded-pill custom-count-badge">@Model.Words.Count từ</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(isPhrasesTab ? "active" : "")"
                    id="tab-words-phrases"
                    data-bs-toggle="pill"
                    data-bs-target="#pane-words-phrases"
                    data-words-tab="phrases"
                    type="button"
                    role="tab"
                    aria-controls="pane-words-phrases"
                    aria-selected="@(isPhrasesTab ? "true" : "false")">
                <i data-lucide="link" style="width: 17px; height: 17px;"></i>
                <span>Quản lý Ghép cụm từ</span>
                <span class="badge rounded-pill custom-count-badge" id="tabWordsPhraseBadge">@topicPhraseCount cụm</span>
            </button>
        </li>
    </ul>
</div>

<div class="tab-content" id="vocabWordsTabContent">
<div class="tab-pane fade @(!isPhrasesTab ? "show active" : "")" id="pane-words-flashcards" role="tabpanel" aria-labelledby="tab-words-flashcards">

<!-- Bộ lọc tìm kiếm từ vựng, loại từ, trạng thái (Client instant filter) -->
<div class="card shadow-sm mb-3">
    <div class="card-body p-3 admin-filter-bar">
        <div class="row g-2 align-items-center">
            <div class="col-lg-5 col-md-6">
                <div class="input-group-search w-100">
                    <span class="search-icon"><i data-lucide="search"></i></span>
                    <input type="text" id="wordSearchInput" class="form-control" placeholder="Tìm kiếm từ tiếng Anh, phát âm, nghĩa tiếng Việt..." />
                </div>
            </div>
            <div class="col-lg-3 col-md-3">
                <select id="posFilter" class="form-select">
                    <option value="">-- Tất cả loại từ --</option>
                    <option value="noun">Noun (Danh từ)</option>
                    <option value="verb">Verb (Động từ)</option>
                    <option value="adjective">Adjective (Tính từ)</option>
                    <option value="adverb">Adverb (Trạng từ)</option>
                    <option value="phrase">Phrase (Cụm từ)</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-3">
                <select id="statusFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="active">Hiển thị</option>
                    <option value="inactive">Ẩn</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-12 d-grid">
                <button type="button" id="btnResetFilter" class="btn btn-outline-secondary btn-filter-reset w-100" title="Đặt lại bộ lọc">
                    <i data-lucide="rotate-ccw"></i>
                </button>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
            <span>Đang hiển thị <strong id="visibleCount" class="text-primary">@Model.Words.Count</strong> trên tổng số <strong>@Model.Words.Count</strong> từ vựng</span>
        </div>
    </div>
</div>

<!-- Thanh thao tác hàng loạt cho các từ được chọn -->
<div id="bulkActionBar" class="alert alert-info py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 shadow-sm rounded-3" style="display: none !important;">
    <div class="d-flex align-items-center gap-2">
        <i data-lucide="check-circle" class="text-primary fs-5"></i>
        <span>Đã chọn <strong id="selectedCountBadge" class="text-primary">0</strong> từ vựng</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" id="btnOpenBulkDeleteModal" data-bs-toggle="modal" data-bs-target="#bulkDeleteConfirmModal">
            <i data-lucide="trash-2" class="me-1"></i>Xoá các từ đã chọn
        </button>
        <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted" id="btnClearSelection">
            Bỏ chọn
        </button>
    </div>
</div>

<!-- Bảng danh sách từ vựng chi tiết -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="wordsTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 45px;" class="text-center">
                        <input type="checkbox" id="checkAllRows" class="form-check-input" title="Chọn tất cả từ đang hiển thị" />
                    </th>
                    <th style="width: 60px;" class="text-center">STT</th>
                    <th style="min-width: 220px;">Từ vựng & Phát âm</th>
                    <th style="width: 110px;">Loại từ</th>
                    <th style="min-width: 300px;">Nghĩa tiếng Việt & Cấu trúc ngữ nghĩa</th>
                    <th style="width: 120px;" class="text-center">Trạng thái</th>
                    <th class="text-end text-nowrap" style="width: 180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @for (var idx = 0; idx < Model.Words.Count; idx++)
                {
                    var w = Model.Words[idx];
                    string posClass = w.PartOfSpeech?.ToLower() switch
                    {
                        "verb" => "badge-pos-verb",
                        "adjective" or "adj" => "badge-pos-adj",
                        "adverb" or "adv" => "badge-pos-adv",
                        "phrase" or "phrasal verb" => "badge-pos-phrase",
                        _ => "badge-pos-noun"
                    };

                    <tr class="word-row"
                        id="row-word-@w.WordId"
                        data-id="@w.WordId"
                        data-word="@w.Word.ToLower()"
                        data-meaning="@w.Meaning.ToLower()"
                        data-phonetic="@((w.PhoneticUs ?? w.PhoneticUk ?? "").ToLower())"
                        data-pos="@(w.PartOfSpeech?.ToLower() ?? "noun")"
                        data-status="@(w.IsActive ? "active" : "inactive")">
                        <td class="text-center">
                            <input type="checkbox" class="form-check-input row-checkbox" value="@w.WordId" />
                        </td>
                        <td class="text-center fw-semibold text-muted stt-col">@(idx + 1)</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn-audio-speak" onclick="speakText('@w.Word', '@w.AudioUrl')" title="Nghe phát âm">
                                    <i data-lucide="volume-2" style="width: 16px; height: 16px;"></i>
                                </button>
                                <div>
                                    <div class="fw-bold text-dark fs-6">
                                        @w.Word
                                    </div>
                                    @if (!string.IsNullOrEmpty(w.PhoneticUs) || !string.IsNullOrEmpty(w.PhoneticUk))
                                    {
                                        <div class="text-muted small font-monospace">
                                            @(w.PhoneticUs ?? w.PhoneticUk)
                                        </div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge @posClass">@(string.IsNullOrEmpty(w.PartOfSpeech) ? "noun" : w.PartOfSpeech)</span>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@w.Meaning</div>
                            @if (!string.IsNullOrEmpty(w.EnglishDefinition))
                            {
                                <div class="text-muted small text-truncate" style="max-width: 320px;" title="@w.EnglishDefinition">
                                    @w.EnglishDefinition
                                </div>
                            }
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @if (!string.IsNullOrEmpty(w.WordFamily))
                                {
                                    <span class="badge bg-purple-subtle text-purple-700 border border-purple-subtle" style="font-size: 11px;" title="Họ từ: @w.WordFamily">
                                        <i data-lucide="layers" style="width: 12px; height: 12px;" class="me-1"></i>Họ từ
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(w.Collocations))
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" style="font-size: 11px;" title="Cụm từ: @w.Collocations">
                                        <i data-lucide="link-2" style="width: 12px; height: 12px;" class="me-1"></i>Cụm từ
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(w.Synonyms))
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle" style="font-size: 11px;" title="Đồng nghĩa: @w.Synonyms">
                                        <i data-lucide="equal" style="width: 12px; height: 12px;" class="me-1"></i>Đồng nghĩa
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(w.CommonMistakeWrong))
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 11px;" title="Lỗi sai: @w.CommonMistakeWrong ➔ @w.CommonMistakeRight (@w.CommonMistakeNote)">
                                        <i data-lucide="alert-triangle" style="width: 12px; height: 12px;" class="me-1"></i>Lỗi thường gặp
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(w.MemoryTip))
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 11px;" title="Mẹo nhớ: @w.MemoryTip">
                                        <i data-lucide="lightbulb" style="width: 12px; height: 12px;" class="me-1"></i>Mẹo nhớ
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="text-center">
                            @if (w.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i data-lucide="check-circle" class="me-1"></i>Hiển thị
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                    <i data-lucide="eye-off" class="me-1"></i>Ẩn
                                </span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex align-items-center justify-content-end" style="gap: 6px;">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-1"
                                        onclick="editWord(@w.WordId)" title="Chỉnh sửa nhanh">
                                    <i data-lucide="square-pen" class="me-1"></i><span>Sửa</span>
                                </button>
                                <a asp-action="EditWord" asp-route-id="@w.WordId" class="btn btn-sm btn-outline-secondary rounded-pill px-2 d-inline-flex align-items-center" title="Soạn thảo toàn màn hình">
                                    <i data-lucide="external-link"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 d-inline-flex align-items-center btn-delete-word"
                                        data-id="@w.WordId" data-word="@w.Word" title="Xoá từ vựng">
                                    <i data-lucide="trash-2"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }

                <tr id="noResultsRow" style="display: none;">
                    <td colspan="7" class="text-center text-muted py-4">
                        <i data-lucide="filter" class="me-1 text-secondary"></i> Không tìm thấy từ vựng nào phù hợp với bộ lọc hiện tại.
                    </td>
                </tr>

                @if (Model.Words.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i data-lucide="folder-open" class="mb-2" style="width: 40px; height: 40px; opacity: 0.5;"></i>
                            <div class="fw-semibold">Bộ từ vựng này chưa có từ nào.</div>
                            <small class="text-muted">Nhấn nút <strong>+ Thêm từ vựng</strong> hoặc <strong>Nhập Excel / CSV</strong> ở trên để nạp từ mới.</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div> <!-- /#pane-words-flashcards -->

<!-- ==================== TAB 2: QUẢN LÝ GHÉP CỤM TỪ ==================== -->
<div class="tab-pane fade @(isPhrasesTab ? "show active" : "")" id="pane-words-phrases" role="tabpanel" aria-labelledby="tab-words-phrases">
    <div class="card shadow-sm mb-3">
        <div class="card-header py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-info"><i data-lucide="link" class="me-1"></i>Cụm từ ghép (Collocations / Phrases)</span>
                <span id="phraseCountBadge" class="badge custom-count-badge">@topicPhraseCount cụm</span>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openAiPhraseBatchModal()">
                    <i data-lucide="sparkles" class="me-1"></i>AI Sinh từ thẻ học
                </button>
                <button type="button" class="btn btn-sm btn-info text-white rounded-pill px-3" onclick="openPhraseModal()">
                    <i data-lucide="plus" class="me-1"></i>Thêm cụm từ vào bộ này
                </button>
            </div>
        </div>
        <div class="card-body p-3 admin-filter-bar border-bottom">
            <div class="row g-2 align-items-center">
                <div class="col-lg-5 col-md-6">
                    <div class="input-group-search w-100">
                        <span class="search-icon"><i data-lucide="search"></i></span>
                        <input type="text" id="phraseSearchInput" class="form-control" placeholder="Tìm vế 1, vế 2, nghĩa tiếng Việt, câu ví dụ..." />
                    </div>
                </div>
                <div class="col-lg-4 col-md-3">
                    <select id="phraseScopeFilter" class="form-select">
                        <!option value="topic" selected>Bộ hiện tại: @Model.TopicTitle (@topicPhraseCount)</!option>
                        <!option value="all">Cả thư mục cha: @Model.CategoryTitle (@Model.Phrases.Count)</!option>
                        <!option value="general">Mục General trong nhóm (@generalPhraseCount)</!option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-2">
                    <select id="phraseStatusFilter" class="form-select">
                        <option value="">-- Trạng thái --</option>
                        <option value="active">Hiển thị</option>
                        <option value="inactive">Ẩn</option>
                    </select>
                </div>
                <div class="col-lg-1 col-md-12 d-grid">
                    <button type="button" id="btnResetPhraseFilter" class="btn btn-outline-secondary btn-filter-reset w-100" title="Đặt lại bộ lọc cụm từ">
                        <i data-lucide="rotate-ccw"></i>
                    </button>
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 pt-2 border-top small text-muted">
                <span>Đang hiển thị <strong id="visiblePhraseCount" class="text-info">@topicPhraseCount</strong> cụm từ (tổng <strong>@Model.Phrases.Count</strong> cụm trong nhóm <strong>@Model.CategoryTitle</strong>)</span>
                @if (topicPhraseCount == 0 && Model.Phrases.Count > 0)
                {
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="showAllCategoryPhrases()">
                        Xem tất cả @Model.Phrases.Count cụm từ trong nhóm cha "@Model.CategoryTitle"
                    </button>
                }
            </div>
        </div>

        <div id="bulkPhraseActionBar" class="alert alert-info py-2 px-3 mx-3 mt-3 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-sm" style="display: none !important;">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="check-circle" class="text-primary fs-5"></i>
                <span>Đã chọn <strong id="selectedPhrasesBadge" class="text-primary">0</strong> cụm từ</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-success rounded-pill px-3" id="btnBulkShowPhrases">
                    <i data-lucide="eye" class="me-1"></i>Hiện mục chọn
                </button>
                <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-3" id="btnBulkHidePhrases">
                    <i data-lucide="eye-off" class="me-1"></i>Ẩn mục chọn
                </button>
                <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" id="btnBulkDeletePhrases">
                    <i data-lucide="trash-2" class="me-1"></i>Xoá mục chọn
                </button>
                <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted" id="btnClearPhraseSelection">
                    Bỏ chọn
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="phraseTable">
                <thead>
                    <tr>
                        <th style="width: 40px;" class="text-center">
                            <input type="checkbox" id="checkAllPhrases" class="form-check-input" title="Chọn tất cả">
                        </th>
                        <th style="width: 60px;" class="text-center">STT</th>
                        <th>Cụm từ ghép (Vế 1 + Vế 2)</th>
                        <th>Nghĩa tiếng Việt</th>
                        <th>Thư mục (Cha / Con)</th>
                        <th class="text-center" style="width: 90px;">Thứ tự</th>
                        <th style="width: 120px;">Trạng thái</th>
                        <th class="text-end text-nowrap" style="width: 240px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int phraseStt = 1; }
                    @foreach (var p in Model.Phrases)
                    {
                        var catKey = p.TopicCategory.ToLower();
                        var catDisplay = categoryNameMap.TryGetValue(catKey, out var catName) ? catName : p.TopicCategory;
                        var setTitleDisplay = string.IsNullOrWhiteSpace(p.SetTitle) ? "General" : p.SetTitle.Trim();
                        var isCurrentTopic = string.Equals(setTitleDisplay, topicTitleNorm, StringComparison.OrdinalIgnoreCase);
                        var isGeneral = string.Equals(setTitleDisplay, "General", StringComparison.OrdinalIgnoreCase);
                        var fullSearch = $"{p.LeftWord} {p.RightWord} {p.Meaning} {setTitleDisplay} {catDisplay} {p.SentenceBefore} {p.SentenceAfter}".ToLower();
                        <tr class="phrase-row"
                            id="phrase-row-@p.PairId"
                            data-id="@p.PairId"
                            data-search="@fullSearch"
                            data-is-topic="@(isCurrentTopic ? "true" : "false")"
                            data-is-general="@(isGeneral ? "true" : "false")"
                            data-status="@(p.IsActive ? "active" : "inactive")"
                            style="@(isCurrentTopic ? "" : "display: none;")">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input phrase-row-checkbox" value="@p.PairId">
                            </td>
                            <td class="phrase-stt text-center fw-semibold">@(phraseStt++)</td>
                            <td>
                                <div class="phrase-pair-pill mb-1">
                                    <span class="phrase-part-left">@p.LeftWord</span>
                                    <span class="text-muted small fw-bold">+</span>
                                    <span class="phrase-part-right">@p.RightWord</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.SentenceBefore) || !string.IsNullOrWhiteSpace(p.SentenceAfter))
                                {
                                    <div class="small text-muted">
                                        @p.SentenceBefore <strong class="text-body">@p.LeftWord @p.RightWord</strong> @p.SentenceAfter
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">@p.Meaning</td>
                            <td>
                                <div class="d-flex flex-column align-items-start gap-1">
                                    <span class="badge custom-count-badge">@catDisplay</span>
                                    @if (isCurrentTopic)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Con: @setTitleDisplay</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Con: @setTitleDisplay</span>
                                    }
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill custom-count-badge">@p.SortOrder</span>
                            </td>
                            <td class="phrase-status-cell">
                                <button type="button"
                                        class="btn btn-sm p-0 border-0 bg-transparent"
                                        onclick="togglePhraseStatus(@p.PairId)"
                                        title="Nhấn để bật/tắt hiển thị">
                                    @if (p.IsActive)
                                    {
                                        <span class="badge text-bg-success"><i data-lucide="check-circle" class="me-1"></i>Hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary"><i data-lucide="eye-off" class="me-1"></i>Ẩn</span>
                                    }
                                </button>
                            </td>
                            <td class="text-end text-nowrap">
                                <div class="d-inline-flex align-items-center justify-content-end" style="gap: 6px;">
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2"
                                            data-speak="@($"{p.LeftWord} {p.RightWord}")"
                                            onclick="speakWithTTS(this.dataset.speak)" title="Nghe phát âm">
                                        <i data-lucide="volume-2"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap"
                                            onclick="editPhrase(@p.PairId)" title="Chỉnh sửa cụm từ">
                                        <i data-lucide="square-pen" class="me-1"></i><span>Sửa</span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap"
                                            data-label="@($"{p.LeftWord} {p.RightWord}")"
                                            onclick="deletePhrase(@p.PairId, this.dataset.label)" title="Xoá cụm từ">
                                        <i data-lucide="trash-2" class="me-1"></i><span>Xoá</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="noPhraseMatchRow" style="@(topicPhraseCount == 0 ? "" : "display: none;")">
                        <td colspan="8" class="text-center text-muted py-4">
                            <i data-lucide="link" class="me-2"></i>Chưa có cụm từ ghép nào trong chế độ lọc hiện tại. Nhấn <strong>+ Thêm cụm từ vào bộ này</strong> hoặc đổi phạm vi lọc để xem cả thư mục cha.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div> <!-- /#pane-words-phrases -->
</div> <!-- /#vocabWordsTabContent -->

<!-- ==================== MODAL THÊM / SỬA TỪ VỰNG ==================== -->
<div class="modal fade" id="modalWord" tabindex="-1" aria-labelledby="modalWordTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-bottom px-4 pt-4 pb-3 bg-light">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white" style="width: 38px; height: 38px;">
                        <i data-lucide="spell-check" style="width: 20px; height: 20px;"></i>
                    </span>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="modalWordTitle">Thêm Từ Vựng Mới</h5>
                        <small class="text-muted">Cung cấp đầy đủ 12 thành phần ngữ nghĩa học để tối ưu trải nghiệm học sinh</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <!-- 4 Tab điều hướng (Thông tin từ · Bài học · Quiz · Gõ) -->
            <div class="px-4 pt-2 border-bottom bg-light">
                <ul class="nav nav-tabs border-0" id="modalWordTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" id="tab-word-core-tab" data-bs-toggle="tab" data-bs-target="#tab-word-core" type="button" role="tab" onclick="updateLiveModalPreview()">
                            1. Thông tin từ
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="tab-word-lesson-tab" data-bs-toggle="tab" data-bs-target="#tab-word-lesson" type="button" role="tab" onclick="updateLiveModalPreview()">
                            2. Bài học
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="tab-word-quiz-tab" data-bs-toggle="tab" data-bs-target="#tab-word-quiz" type="button" role="tab" onclick="updateLiveModalPreview()">
                            3. Quiz
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold text-primary" id="tab-word-typing-tab" data-bs-toggle="tab" data-bs-target="#tab-word-typing" type="button" role="tab" onclick="updateLiveModalPreview()">
                            4. Gõ
                        </button>
                    </li>
                </ul>
            </div>

            <div class="modal-body px-4 py-3">
                <form id="formWord">
                    <input type="hidden" id="wordId" name="WordId" value="0" />
                    <input type="hidden" id="wordTopicId" name="TopicId" value="@Model.TopicId" />

                    <div class="tab-content" id="modalWordTabsContent">
                        <!-- TAB 1: THÔNG TIN TỪ -->
                        <div class="tab-pane fade show active" id="tab-word-core" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label class="form-label fw-semibold small">Từ tiếng Anh (Headword) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="text" id="wordText" name="Word" class="form-control fw-bold fs-5" placeholder="vd: assurance, contract, abide by..." onblur="if(this.value.trim() && !document.getElementById('wordMeaning').value.trim()) autoFillWordFromApi(true)" required />
                                        <button class="btn btn-primary fw-semibold px-3" type="button" id="btnAutoFillWord" onclick="autoFillWordFromApi(false)" title="Tự động điền từ Từ điển (0 token LLM)">
                                            <i data-lucide="wand-2" style="width: 16px; height: 16px;" class="me-1"></i>Gợi ý tự động
                                        </button>
                                        <button class="btn btn-outline-secondary" type="button" onclick="speakCurrentInput()" title="Nghe phát âm"><i data-lucide="volume-2" style="width: 18px; height: 18px;"></i></button>
                                    </div>
                                    <div id="autoFillStatus" class="form-text text-muted small">Phần 1 (Từ điển · 0 token LLM): Tự điền phiên âm US/UK, loại từ, nghĩa Việt &amp; file phát âm ngay khi nhập từ.</div>
                                </div>

                                <div class="col-md-5">
                                    <label class="form-label fw-semibold small">Bộ từ &amp; Loại từ (Part of Speech)</label>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <input type="text" class="form-control" value="@Model.TopicTitle" disabled />
                                        </div>
                                        <div class="col-6">
                                            <select id="wordPos" name="PartOfSpeech" class="form-select">
                                                <option value="noun">Noun (Danh từ)</option>
                                                <option value="verb">Verb (Động từ)</option>
                                                <option value="adjective">Adjective (Tính từ)</option>
                                                <option value="adverb">Adverb (Trạng từ)</option>
                                                <option value="phrase">Phrase (Cụm từ)</option>
                                                <option value="preposition">Preposition (Giới từ)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Nghĩa tiếng Việt <span class="text-danger">*</span></label>
                                    <input type="text" id="wordMeaning" name="Meaning" class="form-control fw-bold" placeholder="vd: sự bảo đảm, lời cam đoan..." required />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold small">Phiên âm US (Mỹ)</label>
                                    <input type="text" id="wordPhoneticUs" name="PhoneticUs" class="form-control font-monospace" placeholder="/əˈʃʊrəns/" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold small">Phiên âm UK (Anh)</label>
                                    <input type="text" id="wordPhoneticUk" name="PhoneticUk" class="form-control font-monospace" placeholder="/əˈʃʊərəns/" />
                                </div>

                                <!-- Tệp âm thanh (Audio MP3 Upload + Tạo TTS) -->
                                <div class="col-12">
                                    <div class="card p-3 bg-light border">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                            <label class="form-label fw-semibold small mb-0">
                                                <i data-lucide="music" style="width: 15px; height: 15px;" class="me-1 text-primary"></i>Tệp âm thanh phát âm (Audio MP3 / TTS)
                                            </label>
                                            <div class="d-flex flex-wrap gap-2">
                                                <input type="file" id="wordAudioFileInput" accept=".mp3,.wav,.ogg,.m4a" class="d-none" onchange="uploadWordAudioFile(this)" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="document.getElementById('wordAudioFileInput').click()">
                                                    <i data-lucide="upload" style="width: 14px; height: 14px;" class="me-1"></i>Tải file MP3
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" id="btnGenerateTts" onclick="generateWordTts()">
                                                    <i data-lucide="audio-waveform" style="width: 14px; height: 14px;" class="me-1"></i>Tạo âm thanh TTS
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="playWordAudioUrl()">
                                                    <i data-lucide="play" style="width: 14px; height: 14px;" class="me-1"></i>Nghe thử Audio
                                                </button>
                                            </div>
                                        </div>
                                        <input type="text" id="wordAudioUrl" name="AudioUrl" class="form-control form-control-sm" placeholder="/uploads/vocab-audio/... hoặc https://...mp3" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Link hình ảnh minh họa</label>
                                    <input type="url" id="wordImageUrl" name="ImageUrl" class="form-control" placeholder="https://...jpg" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold small">Thứ tự</label>
                                    <input type="number" id="wordSortOrder" name="SortOrder" class="form-control" value="1" min="1" />
                                </div>

                                <div class="col-md-4 d-flex align-items-center pt-4">
                                    <div class="form-check form-switch form-check-switch">
                                        <input class="form-check-input" type="checkbox" id="wordIsActive" name="IsActive" checked />
                                        <label class="form-check-label fw-semibold small ms-1" for="wordIsActive">Hiển thị cho học viên</label>
                                    </div>
                                </div>

                                <!-- Xem nhanh thẻ Từ -->
                                <div class="col-12">
                                    <div class="p-3 rounded-3 bg-light border d-flex flex-wrap justify-content-between align-items-center gap-3">
                                        <div>
                                            <div class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Xem nhanh thẻ Từ</div>
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <span class="badge bg-secondary-subtle text-secondary" id="prevTermPos">noun</span>
                                                <span class="fw-bold fs-5 text-dark" id="prevTermWord">Headword</span>
                                                <span class="text-muted font-monospace small" id="prevTermPhonetics">/phonetics/</span>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="small text-muted">Nghĩa mặt sau</div>
                                            <div class="fw-bold text-primary" id="prevTermMeaning">Nghĩa tiếng Việt</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: BÀI HỌC (KIẾN THỨC & MẸO NHỚ) -->
                        <div class="tab-pane fade" id="tab-word-lesson" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="card border p-3 bg-light d-flex flex-wrap flex-row justify-content-between align-items-center gap-2">
                                        <div>
                                            <div class="fw-bold small text-dark">Tự động hóa Bài học (JSON Arrays -> Thẻ Tag)</div>
                                            <div id="lessonAiStatus" class="text-muted small">AI sinh định nghĩa Anh, Collocations, Synonyms, Antonyms, Word Family, Lỗi sai &amp; Mẹo nhớ để bạn bấm × chọn lọc.</div>
                                        </div>
                                        <button type="button" id="btnAiLesson" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" onclick="autoFillLessonByAi()">
                                            <i data-lucide="sparkles" style="width: 14px; height: 14px;" class="me-1"></i>Gợi ý Bài học bằng AI
                                        </button>
                                    </div>
                                </div>
                                <!-- CÁC TRƯỜNG ẨN ĐỒNG BỘ NÉT NGHĨA CHÍNH (TƯƠNG THÍCH HỆ THỐNG GỐC) -->
                                <input type="hidden" id="wordEnglishDefinition" name="EnglishDefinition" />
                                <input type="hidden" id="wordCollocations" name="Collocations" />
                                <input type="hidden" id="wordSynonyms" name="Synonyms" />
                                <input type="hidden" id="wordAntonyms" name="Antonyms" />
                                <input type="hidden" id="wordSensesJson" name="SensesJson" />

                                <!-- KHỐI THỐNG NHẤT: NÉT NGHĨA TỪ VỰNG (GỒM ĐỊNH NGHĨA, VÍ DỤ, CỤM TỪ, ĐỒNG/TRÁI NGHĨA) -->
                                <div class="col-12">
                                    <div class="card border border-fuchsia-200 rounded-4 shadow-sm bg-fuchsia-50/10">
                                        <div class="card-header bg-white py-3 px-3 border-bottom border-fuchsia-200 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div>
                                                <h6 class="fw-bold mb-0 text-slate-800 d-flex align-items-center gap-2">
                                                    <span class="badge rounded-circle p-1 d-inline-flex align-items-center justify-content-center text-white" style="width: 22px; height: 22px; background-color: #c026d3; font-size: 11px;">★</span>
                                                    <span>Nét nghĩa từ vựng (Định nghĩa · Ví dụ · Cụm từ · Đồng nghĩa · Trái nghĩa)</span>
                                                </h6>
                                                <small class="text-muted">Mỗi nét nghĩa bao gồm đầy đủ Định nghĩa tiếng Anh, Ví dụ bổ sung ngữ cảnh, Cụm từ đi kèm, Từ đồng nghĩa &amp; Từ trái nghĩa. Bạn có thể <strong>Thêm</strong>, <strong>Sửa</strong> hoặc <strong>Xóa</strong> từng nét nghĩa.</small>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-sm" onclick="addNewSenseModal()">
                                                <i data-lucide="plus" style="width: 14px; height: 14px;" class="me-1"></i>+ Thêm nét nghĩa
                                            </button>
                                        </div>
                                        <div class="card-body p-3">
                                            <!-- Container chứa danh sách các card nét nghĩa -->
                                            <div id="modalSensesContainer" class="d-flex flex-column gap-3"></div>

                                            <div class="mt-3 text-center">
                                                <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-sm" onclick="addNewSenseModal()">
                                                    <i data-lucide="plus-circle" style="width: 16px; height: 16px;"></i>
                                                    <span>+ Thêm nét nghĩa mới</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label fw-semibold small mb-0">
                                            <i data-lucide="layers" style="width: 14px; height: 14px;" class="me-1 text-primary"></i>Họ từ (Word Family)
                                        </label>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary py-0" onclick="insertFamilyTemplate('noun')">+ Noun</button>
                                            <button type="button" class="btn btn-outline-secondary py-0" onclick="insertFamilyTemplate('adjective')">+ Adj</button>
                                            <button type="button" class="btn btn-outline-secondary py-0" onclick="insertFamilyTemplate('adverb')">+ Adv</button>
                                        </div>
                                    </div>
                                    <textarea id="wordFamily" name="WordFamily" class="form-control font-monospace" rows="2" placeholder="assure · verb · cam đoan&#10;assured · adjective · tự tin, chắc chắn"></textarea>
                                </div>

                                <div class="col-12">
                                    <div class="card p-3 border-warning-subtle bg-warning-subtle">
                                        <div class="fw-bold text-warning-emphasis small mb-2">
                                            <i data-lucide="alert-triangle" style="width: 15px; height: 15px;" class="me-1"></i>Lỗi thường gặp &amp; Lưu ý nhanh (Common Mistakes)
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label small text-danger fw-semibold">Cách dùng SAI ✕</label>
                                                <input type="text" id="wordCommonMistakeWrong" name="CommonMistakeWrong" class="form-control text-danger border-danger" placeholder="vd: make an assurance" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-success fw-semibold">Cách dùng ĐÚNG ✓</label>
                                                <input type="text" id="wordCommonMistakeRight" name="CommonMistakeRight" class="form-control text-success border-success" placeholder="vd: give an assurance" />
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small text-muted">Giải thích quy tắc</label>
                                                <textarea id="wordCommonMistakeNote" name="CommonMistakeNote" class="form-control" rows="2" placeholder="vd: Thường đi theo cụm cố định 'give an assurance'."></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card p-3 border-primary-subtle bg-primary-subtle">
                                        <label class="form-label fw-bold text-primary small mb-1">
                                            <i data-lucide="lightbulb" style="width: 15px; height: 15px;" class="me-1"></i>Mẹo ghi nhớ / Nguồn gốc từ (Mnemonic)
                                        </label>
                                        <textarea id="wordMemoryTip" name="MemoryTip" class="form-control" rows="2" placeholder="vd: Gốc 'sure' = chắc chắn -> 'assurance' là mang lại sự chắc chắn."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 3: QUIZ (TỰ ĐỘNG & GHI ĐÈ) -->
                        <div class="tab-pane fade" id="tab-word-quiz" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="card border p-3 bg-light">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="fw-bold small text-dark">Chế độ tạo đáp án nhiễu Quiz</span>
                                                    <span id="quizPoolStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle">CSDL nội bộ (0 token)</span>
                                                </div>
                                                <div id="quizAiStatus" class="text-muted small">Mặc định bốc tự động 3 từ cùng <strong>Loại từ</strong> &amp; ưu tiên cùng <strong>Chủ đề</strong>, loại bỏ từ đồng nghĩa (tức thì, 0 phí API).</div>
                                            </div>
                                            <div class="d-flex flex-wrap align-items-center gap-3">
                                                <button type="button" id="btnAiQuizTraps" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" onclick="suggestQuizTrapsByAi()">
                                                    <i data-lucide="sparkles" style="width: 14px; height: 14px;" class="me-1"></i>Gợi ý đáp án bẫy bằng AI
                                                </button>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" id="wordUseManualQuiz" name="UseManualQuiz" onchange="toggleManualQuizInputs()" />
                                                    <label class="form-check-label fw-bold text-primary small" for="wordUseManualQuiz">Ghi đè thủ công</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold small">Đáp án ĐÚNG (đồng bộ với Nghĩa tiếng Việt)</label>
                                    <input type="text" id="quizCorrectMeaningSync" class="form-control fw-bold border-success" placeholder="Nhập nghĩa tiếng Việt đúng cho câu hỏi Quiz..." />
                                </div>

                                <div class="col-12" id="manualQuizDistractorsBox" style="display: none;">
                                    <div class="card border-primary-subtle bg-primary-subtle p-3">
                                        <div class="fw-bold small text-primary mb-2">3 Đáp án nhiễu chủ đích (Dành cho từ dễ gây nhầm lẫn)</div>
                                        <div class="row g-2">
                                            <div class="col-md-4">
                                                <input type="text" id="wordDistractor1" class="form-control form-control-sm" placeholder="Đáp án nhiễu 1..." oninput="updateLiveModalPreview()" />
                                            </div>
                                            <div class="col-md-4">
                                                <input type="text" id="wordDistractor2" class="form-control form-control-sm" placeholder="Đáp án nhiễu 2..." oninput="updateLiveModalPreview()" />
                                            </div>
                                            <div class="col-md-4">
                                                <input type="text" id="wordDistractor3" class="form-control form-control-sm" placeholder="Đáp án nhiễu 3..." oninput="updateLiveModalPreview()" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card border-0 bg-light p-3" style="border-radius: 14px;">
                                        <div class="small text-uppercase text-muted fw-bold mb-1" style="font-size: 0.7rem;">Xem trước câu hỏi Quiz A / B / C / D</div>
                                        <div class="fw-bold fs-5 text-dark mb-3" id="quizPreviewPrompt">Nghĩa đúng của "Headword" là gì?</div>
                                        <div class="row g-2" id="quizPreviewOptions"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 4: GÕ (NGỮ CẢNH & TÁCH TỪ) -->
                        <div class="tab-pane fade" id="tab-word-typing" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12" id="typingMatchAlert"></div>

                                <div class="col-12">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                                        <label class="form-label fw-semibold small mb-0">Câu ví dụ tiếng Anh (bọc từ chia thì bằng <code>[...]</code>)</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" id="btnAiTyping" class="btn btn-sm btn-primary py-0 px-3 rounded-pill fw-semibold" onclick="autoFillTypingByAi()">
                                                <i data-lucide="sparkles" style="width: 13px; height: 13px;" class="me-1"></i>Sinh câu ví dụ TOEIC &amp; dịch bằng AI
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" onclick="wrapSelectedTypingBlank()">
                                                <i data-lucide="brackets" style="width: 13px; height: 13px;" class="me-1"></i>Đặt làm ô trống
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="applySampleTypingSentence()">
                                                <i data-lucide="file-text" style="width: 13px; height: 13px;" class="me-1"></i>Mẫu nhanh
                                            </button>
                                        </div>
                                    </div>
                                    <textarea id="wordExampleSentence" name="ExampleSentence" class="form-control" rows="2" placeholder="vd: The supplier gave us an [assurance] that goods will arrive on time."></textarea>
                                    <div id="typingAiStatus" class="form-text small text-muted">Bấm <strong>Sinh câu ví dụ TOEIC &amp; dịch bằng AI</strong> để tạo trọn gói câu ngữ cảnh công sở có sẵn <code>[từ_gốc]</code> và bản dịch Việt, hoặc bôi đen từ rồi bấm <strong>Đặt làm ô trống</strong>.</div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold small">Dịch nghĩa tiếng Việt của câu ví dụ</label>
                                    <textarea id="wordExampleMeaning" name="ExampleMeaning" class="form-control" rows="2" placeholder="vd: Nhà cung cấp đã đưa cho chúng tôi lời cam đoan rằng hàng sẽ đến đúng hạn."></textarea>
                                </div>

                                <div class="col-12">
                                    <div class="card border-0 bg-light p-3" style="border-radius: 14px;">
                                        <div class="small text-uppercase text-muted fw-bold mb-2" style="font-size: 0.7rem;">Xem trước bài tập Gõ điền từ</div>
                                        <div class="fs-5 text-dark mb-2" id="typingPreviewSentence">...</div>
                                        <div class="small text-muted" id="typingPreviewTranslation">Gợi ý: ...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary rounded-pill px-3" onclick="nextModalTab()">
                        <span>Tiếp tục</span> <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="saveWord()">
                        <i data-lucide="save" style="width: 16px; height: 16px;" class="me-1"></i> Lưu Từ Vựng
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

