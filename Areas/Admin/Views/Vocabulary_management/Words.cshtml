<!-- ==================== MODAL NHẬP HÀNG LOẠT QUA EXCEL/CSV ==================== -->
<div class="modal fade" id="modalBulk" tabindex="-1" aria-labelledby="modalBulkTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold" id="modalBulkTitle">Nhập Hàng Loạt (Excel/CSV) vào Bộ: @Model.TopicTitle</h5>
                    <small class="text-muted">Tải file mẫu CSV, kiểm tra tự động dấu <code>[...]</code> và từ trùng lặp trước khi lưu vào CSDL</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form id="formBulk">
                    <input type="hidden" id="bulkTopicId" name="TopicId" value="@Model.TopicId" />

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 rounded-3 bg-light border mb-3">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <a href="/Admin/Vocabulary_management/DownloadWordTemplate" class="btn btn-sm btn-outline-success rounded-pill fw-semibold">
                                <i data-lucide="file-spreadsheet" style="width: 15px; height: 15px;" class="me-1"></i>Tải file mẫu CSV/Excel
                            </a>
                            <label class="btn btn-sm btn-outline-primary rounded-pill fw-semibold mb-0" style="cursor: pointer;">
                                <i data-lucide="upload" style="width: 15px; height: 15px;" class="me-1"></i>Chọn file CSV
                                <input type="file" id="bulkCsvFile" accept=".csv,.txt" class="d-none" onchange="handleBulkCsvUpload(this)" />
                            </label>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill fw-semibold" onclick="previewBulkImport()">
                            <i data-lucide="shield-check" style="width: 15px; height: 15px;" class="me-1"></i>Kiểm tra &amp; Xem trước
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Dữ liệu CSV hoặc ngăn cách bởi dấu <code>|</code> (mỗi dòng một từ)</label>
                        <textarea id="bulkRawData" name="RawData" class="form-control font-monospace small" rows="6" placeholder="Word,PartOfSpeech,Meaning,Phonetic,ExampleSentence,ExampleMeaning,Mnemonic,Collocations,Synonyms&#10;&quot;assurance&quot;,noun,&quot;sự bảo đảm&quot;,/əˈʃʊərəns/,&quot;The supplier gave us an [assurance] that goods will arrive on time.&quot;,&quot;Nhà cung cấp đã cam đoan hàng sẽ đến đúng hạn.&quot;,&quot;Gốc sure = chắc chắn&quot;,&quot;give an assurance&quot;,&quot;guarantee&quot;"></textarea>
                    </div>

                    <div id="bulkPreviewWrap" style="display: none;">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div class="fw-bold small text-dark" id="bulkPreviewSummary"></div>
                        </div>
                        <div class="table-responsive border rounded-3" style="max-height: 260px;">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light sticky-top small">
                                    <tr>
                                        <th>#</th>
                                        <th>Từ (Word)</th>
                                        <th>Loại từ</th>
                                        <th>Nghĩa</th>
                                        <th>Ví dụ (có <code>[...]</code>)</th>
                                        <th>Kiểm tra lỗi</th>
                                    </tr>
                                </thead>
                                <tbody id="bulkPreviewBody" class="small"></tbody>
                            </table>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="previewBulkImport()">Kiểm tra lại</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="commitBulkImport()">
                    <i data-lucide="check-circle" style="width: 16px; height: 16px;" class="me-1"></i>Lưu các dòng hợp lệ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODAL THÊM / SỬA CỤM TỪ GHÉP (PHRASE) ==================== -->
<div class="modal fade" id="modalPhrase" tabindex="-1" aria-labelledby="modalPhraseTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold" id="modalPhraseTitle">Thêm Cụm Từ Ghép Mới</h5>
                    <small class="text-muted">Thư mục cha: <strong>@Model.CategoryTitle</strong> › Thư mục con: <strong>@Model.TopicTitle</strong></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form id="formPhrase">
                    <input type="hidden" id="phrasePairId" name="PairId" value="0" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Thư mục cha (Nhóm bộ từ) <span class="text-danger">*</span></label>
                            <select id="phraseTopicCategory" name="TopicCategory" class="form-select" required>
                                @foreach (var c in Model.Categories)
                                {
                                    var codeLower = c.Code.ToLower();
                                    <!option value="@codeLower" @(string.Equals(Model.CategoryCode, codeLower, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@c.Name (@codeLower)</!option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CategoryCode) && !Model.Categories.Any(c => string.Equals(c.Code, Model.CategoryCode, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <!option value="@Model.CategoryCode" selected>@Model.CategoryTitle (@Model.CategoryCode)</!option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Thư mục con / Bộ cụm từ (Set Title)</label>
                            <input type="text" id="phraseSetTitle" name="SetTitle" class="form-control" list="phraseSetSuggestions" placeholder="vd: @Model.TopicTitle" value="@Model.TopicTitle" />
                            <datalist id="phraseSetSuggestions">
                                <option value="@Model.TopicTitle"></option>
                                @foreach (var tTitle in Model.CategoryTopics.Where(t => !string.Equals(t, Model.TopicTitle, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@tTitle"></option>
                                }
                                @foreach (var s in distinctPhraseSets.Where(x => !string.Equals(x, Model.TopicTitle, StringComparison.OrdinalIgnoreCase) && !Model.CategoryTopics.Contains(x, StringComparer.OrdinalIgnoreCase)))
                                {
                                    <option value="@s"></option>
                                }
                                <option value="General"></option>
                            </datalist>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 border border-primary-subtle bg-primary-subtle/20 mb-3" style="background: rgba(79, 70, 229, 0.05);">
                        <label class="form-label fw-semibold small text-primary d-flex align-items-center gap-1 mb-1">
                            <i data-lucide="sparkles" style="width: 15px; height: 15px;"></i> AI Sinh câu hỏi từ Từ vựng gốc trọng tâm
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="phraseAiFocusWord" class="form-control" list="phraseFocusWordSuggestions" placeholder="Chọn hoặc nhập từ gốc trọng tâm (vd: cancellation, abide by...)" />
                            <button type="button" id="btnAiSuggestPhrase" class="btn btn-primary fw-semibold px-3" onclick="aiGeneratePhraseFromFocusWord()">
                                <i data-lucide="wand-2" style="width: 14px; height: 14px;" class="me-1"></i>AI Sinh câu hỏi
                            </button>
                        </div>
                        <datalist id="phraseFocusWordSuggestions">
                            @foreach (var w in Model.Words)
                            {
                                <option value="@w.Word">@w.Word — @w.Meaning</option>
                            }
                        </datalist>
                        <div class="form-text small text-muted mt-1" id="phraseAiStatus">Chọn từ trong bộ thẻ học hoặc nhập từ mới để AI tự động tách Vế 1, Vế 2, nghĩa và câu ví dụ.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Vế 1 (Từ đứng trước) <span class="text-danger">*</span></label>
                            <input type="text" id="phraseLeftWord" name="LeftWord" class="form-control fw-bold" placeholder="vd: sign, abide by, meet..." required oninput="updatePhraseModalPreview()" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Vế 2 (Cụm theo sau) <span class="text-danger">*</span></label>
                            <input type="text" id="phraseRightWord" name="RightWord" class="form-control fw-bold" placeholder="vd: a contract, the rules, deadlines..." required oninput="updatePhraseModalPreview()" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nghĩa tiếng Việt <span class="text-danger">*</span></label>
                        <input type="text" id="phraseMeaning" name="Meaning" class="form-control fw-semibold" placeholder="vd: ký hợp đồng, tuân thủ luật lệ..." required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Câu ví dụ (phần trước cụm từ)</label>
                            <input type="text" id="phraseSentenceBefore" name="SentenceBefore" class="form-control" placeholder="vd: Both parties must" oninput="updatePhraseModalPreview()" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Câu ví dụ (phần sau cụm từ)</label>
                            <input type="text" id="phraseSentenceAfter" name="SentenceAfter" class="form-control" placeholder="vd: before work begins." oninput="updatePhraseModalPreview()" />
                        </div>
                    </div>

                    <div class="p-3 rounded-3 bg-light border mb-3">
                        <div class="small text-muted fw-semibold mb-1">Xem trước câu hiển thị cho học viên:</div>
                        <div class="fs-6" id="phraseLivePreview">
                            <span class="text-muted fst-italic">Nhập Vế 1 và Vế 2 để xem trước...</span>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Thứ tự</label>
                            <input type="number" id="phraseSortOrder" name="SortOrder" class="form-control" value="1" min="1" />
                        </div>
                        <div class="col-6 d-flex align-items-center pt-4">
                            <div class="form-check form-switch form-check-switch">
                                <input class="form-check-input" type="checkbox" id="phraseIsActive" name="IsActive" checked />
                                <label class="form-check-label fw-semibold small ms-1" for="phraseIsActive">Kích hoạt hiển thị</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-info text-white rounded-pill px-4" onclick="savePhrase()">
                    <i data-lucide="save" style="width: 16px; height: 16px;" class="me-1"></i> Lưu Cụm Từ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL AI SINH CÂU HỎI GHÉP CỤM TỪ HÀNG LOẠT TỪ THẺ HỌC -->
<div class="modal fade" id="aiPhraseBatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2 text-primary">
                    <i data-lucide="sparkles"></i> AI Sinh câu hỏi Ghép cụm từ từ Từ vựng gốc
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3">
                    Chọn các từ vựng gốc trọng tâm trong bộ thẻ học <strong>@Model.TopicTitle</strong> (tối đa 10 từ/lượt) để AI tự động sinh cụm từ ghép, nghĩa tiếng Việt và câu ví dụ:
                </p>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold text-secondary" id="aiBatchSelectedCount">Đã chọn 0 từ</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="toggleAiBatchWords(true)">Chọn từ chưa có cụm</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="toggleAiBatchWords(false)">Bỏ chọn tất cả</button>
                    </div>
                </div>
                <div class="border rounded-3 p-2 overflow-auto" style="max-height: 300px;" id="aiPhraseWordList">
                    @foreach (var w in Model.Words)
                    {
                        var hasPhrase = Model.Phrases.Any(p =>
                            string.Equals(p.SetTitle, Model.TopicTitle, StringComparison.OrdinalIgnoreCase) &&
                            ((p.LeftWord + " " + p.RightWord).Contains(w.Word, StringComparison.OrdinalIgnoreCase)));
                        <label class="d-flex align-items-center justify-content-between gap-2 p-2 rounded-2 border-bottom cursor-pointer">
                            <span class="d-flex align-items-center gap-2">
                                <input type="checkbox" class="form-check-input ai-batch-word-cb" value="@w.WordId" data-has-phrase="@(hasPhrase ? "true" : "false")" onchange="updateAiBatchSelectedCount()" />
                                <strong class="text-dark">@w.Word</strong>
                                <span class="text-muted small">— @w.Meaning</span>
                            </span>
                            @if (hasPhrase)
                            {
                                <span class="badge bg-success-subtle text-success">Đã có cụm</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis">Chưa có cụm</span>
                            }
                        </label>
                    }
                    @if (!Model.Words.Any())
                    {
                        <div class="text-center text-muted py-4 small">Bộ này chưa có từ vựng thẻ học nào.</div>
                    }
                </div>
                <div id="aiBatchStatusMsg" class="small mt-3"></div>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="button" id="btnRunAiPhraseBatch" class="btn btn-primary rounded-pill px-4" onclick="submitAiPhraseBatch()">
                    <i data-lucide="wand-2" style="width: 16px; height: 16px;" class="me-1"></i> AI Tạo &amp; Lưu câu hỏi
                </button>
            </div>
        </div>
    </div>
</div>

<form id="antiforgeryForm" hidden>@Html.AntiForgeryToken()</form>

@section Scripts {
<script>
    // ===== HỖ TRỢ PHÁT ÂM AUDIO & WEB SPEECH API =====
    function speakText(text, audioUrl) {
        if (audioUrl && audioUrl.trim() !== '') {
            const audio = new Audio(audioUrl);
            audio.play().catch(() => speakWithTTS(text));
        } else {
            speakWithTTS(text);
        }
    }

    function speakWithTTS(text) {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = 0.9;
            window.speechSynthesis.speak(utterance);
        } else {
            alert('Trình duyệt của bạn không hỗ trợ Web Speech API.');
        }
    }

    function speakCurrentInput() {
        const text = document.getElementById('wordText').value.trim();
        if (text) speakWithTTS(text);
    }

    function getAntiForgeryToken() {
        return document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]')?.value || '';
    }

    function showToast(message, type = 'success') {
        const alertContainer = document.getElementById('indexAlertContainer');
        if (!alertContainer) return;
        const alertId = 'alert-' + Date.now();
        alertContainer.innerHTML = `
            <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}"></i>
                    <span>${message}</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        `;
        if (window.lucide) lucide.createIcons();
        setTimeout(() => {
            const el = document.getElementById(alertId);
            if (el) bootstrap.Alert.getOrCreateInstance(el).close();
        }, 4000);
    }

    // ==========================================
    // CLIENT FILTERING & SELECTION
    // ==========================================
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) {
            lucide.createIcons();
        }

        const searchInput = document.getElementById("wordSearchInput");
        const posFilter = document.getElementById("posFilter");
        const statusFilter = document.getElementById("statusFilter");
        const btnReset = document.getElementById("btnResetFilter");
        const visibleCountEl = document.getElementById("visibleCount");
        const checkAllRows = document.getElementById("checkAllRows");
        const noResultsRow = document.getElementById("noResultsRow");
        const table = document.getElementById("wordsTable");
        const rows = Array.from(table.querySelectorAll("tbody tr.word-row"));

        const bulkActionBar = document.getElementById("bulkActionBar");
        const selectedCountBadge = document.getElementById("selectedCountBadge");
        const bulkDeleteCount = document.getElementById("bulkDeleteCount");
        const btnClearSelection = document.getElementById("btnClearSelection");

        let currentDeleteWordId = null;

        function filterWords() {
            const query = (searchInput?.value || "").trim().toLowerCase();
            const pos = (posFilter?.value || "").trim().toLowerCase();
            const status = statusFilter?.value || "";

            let visible = 0;
            rows.forEach(r => {
                const word = r.getAttribute("data-word") || "";
                const meaning = r.getAttribute("data-meaning") || "";
                const phonetic = r.getAttribute("data-phonetic") || "";
                const rPos = r.getAttribute("data-pos") || "";
                const rStatus = r.getAttribute("data-status") || "";

                const matchQuery = !query || word.includes(query) || meaning.includes(query) || phonetic.includes(query);
                const matchPos = !pos || rPos === pos;
                const matchStatus = !status || rStatus === status;

                if (matchQuery && matchPos && matchStatus) {
                    r.style.display = "";
                    visible++;
                    const stt = r.querySelector(".stt-col");
                    if (stt) stt.textContent = visible;
                } else {
                    r.style.display = "none";
                    const cb = r.querySelector("input.row-checkbox");
                    if (cb) cb.checked = false;
                    r.classList.remove("table-active");
                }
            });

            if (noResultsRow) {
                noResultsRow.style.display = (visible === 0 && rows.length > 0) ? "" : "none";
            }
            if (visibleCountEl) {
                visibleCountEl.textContent = visible;
            }

            updateSelectedState();
        }

        if (searchInput) searchInput.addEventListener("input", filterWords);
        if (posFilter) posFilter.addEventListener("change", filterWords);
        if (statusFilter) statusFilter.addEventListener("change", filterWords);

        if (btnReset) {
            btnReset.addEventListener("click", function () {
                if (searchInput) searchInput.value = "";
                if (posFilter) posFilter.value = "";
                if (statusFilter) statusFilter.value = "";
                filterWords();
            });
        }

        function updateSelectedState() {
            const checkedBoxes = table.querySelectorAll("tbody tr.word-row:not([style*='display: none']) input.row-checkbox:checked");
            const visibleBoxes = table.querySelectorAll("tbody tr.word-row:not([style*='display: none']) input.row-checkbox");
            const count = checkedBoxes.length;

            if (selectedCountBadge) selectedCountBadge.textContent = count;
            if (bulkDeleteCount) bulkDeleteCount.textContent = count;

            if (bulkActionBar) {
                if (count > 0) bulkActionBar.style.setProperty("display", "flex", "important");
                else bulkActionBar.style.setProperty("display", "none", "important");
            }

            if (checkAllRows) {
                checkAllRows.checked = visibleBoxes.length > 0 && checkedBoxes.length === visibleBoxes.length;
                checkAllRows.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < visibleBoxes.length;
            }
        }

        if (checkAllRows) {
            checkAllRows.addEventListener("change", function () {
                const isChecked = checkAllRows.checked;
                rows.forEach(r => {
                    if (r.style.display !== "none") {
                        const cb = r.querySelector("input.row-checkbox");
                        if (cb) {
                            cb.checked = isChecked;
                            if (isChecked) r.classList.add("table-active");
                            else r.classList.remove("table-active");
                        }
                    }
                });
                updateSelectedState();
            });
        }

        table.addEventListener("change", function (e) {
            if (e.target && e.target.classList.contains("row-checkbox")) {
                const row = e.target.closest("tr");
                if (row) {
                    if (e.target.checked) row.classList.add("table-active");
                    else row.classList.remove("table-active");
                }
                updateSelectedState();
            }
        });

        if (btnClearSelection) {
            btnClearSelection.addEventListener("click", function () {
                rows.forEach(r => {
                    const cb = r.querySelector("input.row-checkbox");
                    if (cb) cb.checked = false;
                    r.classList.remove("table-active");
                });
                updateSelectedState();
            });
        }

        // Modal xác nhận xoá 1 từ
        const deleteModalEl = document.getElementById("deleteConfirmModal");
        const deleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;

        document.querySelectorAll(".btn-delete-word").forEach(btn => {
            btn.addEventListener("click", function () {
                currentDeleteWordId = this.getAttribute("data-id");
                const wordText = this.getAttribute("data-word") || "";
                document.getElementById("modalWordText").textContent = wordText;
                if (deleteModal) deleteModal.show();
            });
        });

        document.getElementById("btnConfirmDeleteWord")?.addEventListener("click", async function () {
            if (!currentDeleteWordId) return;
            try {
                const res = await fetch(`/Admin/Vocabulary_management/DeleteWord/${currentDeleteWordId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });
                const json = await res.json();
                if (json.success) {
                    deleteModal?.hide();
                    const row = document.getElementById(`row-word-${currentDeleteWordId}`);
                    if (row) {
                        row.remove();
                        filterWords();
                    }
                    showToast(json.message || 'Đã xoá từ vựng thành công!');
                } else {
                    showToast(json.message || 'Không thể xoá.', 'danger');
                }
            } catch (e) {
                showToast('Lỗi máy chủ khi xoá từ.', 'danger');
            }
        });

        // Xoá hàng loạt
        const bulkDeleteModalEl = document.getElementById("bulkDeleteConfirmModal");
        const bulkDeleteModal = bulkDeleteModalEl ? new bootstrap.Modal(bulkDeleteModalEl) : null;

        document.getElementById("btnConfirmBulkDelete")?.addEventListener("click", async function () {
            const checkedIds = Array.from(table.querySelectorAll("tbody tr.word-row:not([style*='display: none']) input.row-checkbox:checked"))
                .map(cb => parseInt(cb.value));

            if (checkedIds.length === 0) return;

            try {
                const res = await fetch('/Admin/Vocabulary_management/DeleteMultipleWords', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({ ids: checkedIds })
                });
                const json = await res.json();
                if (json.success) {
                    bulkDeleteModal?.hide();
                    showToast(json.message || `Đã xoá ${checkedIds.length} từ vựng!`);
                    setTimeout(() => location.reload(), 600);
                } else {
                    showToast(json.message || 'Không thể xoá hàng loạt.', 'danger');
                }
            } catch (e) {
                showToast('Lỗi khi xoá hàng loạt.', 'danger');
            }
        });

        // ==========================================
        // CHUYỂN TAB (HỌC THẺ / GHÉP CỤM TỪ) & BỘ LỌC CỤM TỪ
        // ==========================================
        document.querySelectorAll('#vocabWordsModeTabs [data-words-tab]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', function () {
                const tabName = btn.getAttribute('data-words-tab') || 'flashcards';
                const url = new URL(window.location.href);
                url.searchParams.set('tab', tabName);
                window.history.replaceState({}, '', url.toString());
            });
        });

        const phraseSearchInput = document.getElementById("phraseSearchInput");
        const phraseScopeFilter = document.getElementById("phraseScopeFilter");
        const phraseStatusFilter = document.getElementById("phraseStatusFilter");
        const btnResetPhraseFilter = document.getElementById("btnResetPhraseFilter");
        const phraseRows = Array.from(document.querySelectorAll("#phraseTable tbody tr.phrase-row"));
        const noPhraseMatchRow = document.getElementById("noPhraseMatchRow");
        const visiblePhraseCount = document.getElementById("visiblePhraseCount");
        const phraseCountBadge = document.getElementById("phraseCountBadge");
        const checkAllPhrases = document.getElementById("checkAllPhrases");
        const bulkPhraseActionBar = document.getElementById("bulkPhraseActionBar");
        const selectedPhrasesBadge = document.getElementById("selectedPhrasesBadge");
        const btnClearPhraseSelection = document.getElementById("btnClearPhraseSelection");
        const btnBulkShowPhrases = document.getElementById("btnBulkShowPhrases");
        const btnBulkHidePhrases = document.getElementById("btnBulkHidePhrases");
        const btnBulkDeletePhrases = document.getElementById("btnBulkDeletePhrases");

        function filterPhrases() {
            const query = (phraseSearchInput?.value || "").trim().toLowerCase();
            const scope = phraseScopeFilter?.value || "topic";
            const status = phraseStatusFilter?.value || "";

            let visibleCount = 0;
            phraseRows.forEach(row => {
                if (!row.isConnected) return;
                const searchData = row.getAttribute("data-search") || "";
                const isTopic = row.getAttribute("data-is-topic") === "true";
                const isGeneral = row.getAttribute("data-is-general") === "true";
                const rowStatus = row.getAttribute("data-status") || "";

                const matchQuery = !query || searchData.includes(query);
                const matchScope = scope === "all" || (scope === "topic" ? isTopic : isGeneral);
                const matchStatus = !status || rowStatus === status;

                if (matchQuery && matchScope && matchStatus) {
                    row.style.display = "";
                    visibleCount++;
                    const sttCell = row.querySelector(".phrase-stt");
                    if (sttCell) sttCell.textContent = visibleCount;
                } else {
                    row.style.display = "none";
                    const cb = row.querySelector("input.phrase-row-checkbox");
                    if (cb) cb.checked = false;
                    row.classList.remove("table-active");
                }
            });

            if (noPhraseMatchRow) {
                noPhraseMatchRow.style.display = visibleCount === 0 ? "" : "none";
            }
            if (visiblePhraseCount) {
                visiblePhraseCount.textContent = visibleCount;
            }
            if (phraseCountBadge) {
                phraseCountBadge.textContent = `${visibleCount} cụm`;
            }

            updateSelectedPhrasesState();
        }

        window.filterWordsPhrases = filterPhrases;

        if (phraseSearchInput) phraseSearchInput.addEventListener("input", filterPhrases);
        if (phraseScopeFilter) phraseScopeFilter.addEventListener("change", filterPhrases);
        if (phraseStatusFilter) phraseStatusFilter.addEventListener("change", filterPhrases);
        if (btnResetPhraseFilter) {
            btnResetPhraseFilter.addEventListener("click", function () {
                if (phraseSearchInput) phraseSearchInput.value = "";
                if (phraseScopeFilter) phraseScopeFilter.value = "topic";
                if (phraseStatusFilter) phraseStatusFilter.value = "";
                filterPhrases();
            });
        }

        function getSelectedPhraseIds() {
            return Array.from(document.querySelectorAll("#phraseTable tbody tr.phrase-row input.phrase-row-checkbox:checked"))
                .map(cb => parseInt(cb.value, 10))
                .filter(id => !isNaN(id));
        }

        function updateSelectedPhrasesState() {
            const checkedBoxes = document.querySelectorAll("#phraseTable tbody tr.phrase-row:not([style*='display: none']) input.phrase-row-checkbox:checked");
            const visibleBoxes = document.querySelectorAll("#phraseTable tbody tr.phrase-row:not([style*='display: none']) input.phrase-row-checkbox");
            const count = checkedBoxes.length;

            if (selectedPhrasesBadge) selectedPhrasesBadge.textContent = count;
            if (bulkPhraseActionBar) {
                bulkPhraseActionBar.style.setProperty("display", count > 0 ? "flex" : "none", "important");
            }
            if (checkAllPhrases) {
                checkAllPhrases.checked = visibleBoxes.length > 0 && checkedBoxes.length === visibleBoxes.length;
                checkAllPhrases.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < visibleBoxes.length;
            }
        }

        if (checkAllPhrases) {
            checkAllPhrases.addEventListener("change", function () {
                const isChecked = checkAllPhrases.checked;
                phraseRows.forEach(row => {
                    if (row.style.display !== "none") {
                        const cb = row.querySelector("input.phrase-row-checkbox");
                        if (cb) {
                            cb.checked = isChecked;
                            row.classList.toggle("table-active", isChecked);
                        }
                    }
                });
                updateSelectedPhrasesState();
            });
        }

        document.getElementById("phraseTable")?.addEventListener("change", function (e) {
            if (e.target && e.target.classList.contains("phrase-row-checkbox")) {
                const row = e.target.closest("tr");
                if (row) row.classList.toggle("table-active", e.target.checked);
                updateSelectedPhrasesState();
            }
        });

        if (btnClearPhraseSelection) {
            btnClearPhraseSelection.addEventListener("click", function () {
                phraseRows.forEach(r => {
                    const cb = r.querySelector("input.phrase-row-checkbox");
                    if (cb) cb.checked = false;
                    r.classList.remove("table-active");
                });
                updateSelectedPhrasesState();
            });
        }

        async function executeBulkPhrasesAction(action) {
            const ids = getSelectedPhraseIds();
            if (ids.length === 0) return;

            let confirmMsg = `Bạn có chắc muốn áp dụng hành động "${action}" cho ${ids.length} cụm từ đã chọn?`;
            if (action === 'delete') {
                confirmMsg = `Bạn có chắc chắn muốn xoá ${ids.length} cụm từ ghép đã chọn không?`;
            }
            if (!confirm(confirmMsg)) return;

            try {
                const res = await fetch('/Admin/Vocabulary_management/BulkUpdatePhrases', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({ ids: ids, action: action })
                });
                const json = await res.json();
                if (json.success) {
                    showToast(json.message);
                    setTimeout(() => reloadWithTab('phrases'), 600);
                } else {
                    showToast(json.message || 'Thao tác hàng loạt thất bại.', 'danger');
                }
            } catch (e) {
                showToast('Lỗi máy chủ khi thao tác hàng loạt.', 'danger');
            }
        }

        if (btnBulkShowPhrases) btnBulkShowPhrases.addEventListener("click", () => executeBulkPhrasesAction("show"));
        if (btnBulkHidePhrases) btnBulkHidePhrases.addEventListener("click", () => executeBulkPhrasesAction("hide"));
