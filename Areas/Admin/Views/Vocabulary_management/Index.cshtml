<!-- ==================== MODAL NHẬP HÀNG LOẠT QUA EXCEL/CSV ==================== -->
<div class="modal fade" id="modalBulk" tabindex="-1" aria-labelledby="modalBulkTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold" id="modalBulkTitle">Nhập Hàng Loạt (Excel/CSV) &amp; Kiểm Tra Lỗi</h5>
                    <small class="text-muted">Tải file mẫu CSV, kiểm tra tự động dấu <code>[...]</code> và từ trùng lặp trước khi lưu vào CSDL</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form id="formBulk">
                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Chọn Bộ từ đích <span class="text-danger">*</span></label>
                            <select id="bulkTopicId" name="TopicId" class="form-select" required>
                                <option value="">-- Chọn bộ từ --</option>
                                @foreach (var top in Model.Topics)
                                {
                                    <option value="@top.TopicId">@top.Title (@top.CategoryName)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-7 d-flex align-items-end justify-content-md-end flex-wrap gap-2">
                            <a href="/Admin/Vocabulary_management/DownloadWordTemplate" class="btn btn-sm btn-outline-success rounded-pill fw-semibold">
                                <i data-lucide="file-spreadsheet" style="width: 15px; height: 15px;" class="me-1"></i>Tải file mẫu CSV/Excel
                            </a>
                            <label class="btn btn-sm btn-outline-primary rounded-pill fw-semibold mb-0" style="cursor: pointer;">
                                <i data-lucide="upload" style="width: 15px; height: 15px;" class="me-1"></i>Chọn file CSV
                                <input type="file" id="bulkCsvFile" accept=".csv,.txt" class="d-none" onchange="handleBulkCsvUpload(this)" />
                            </label>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill fw-semibold" onclick="previewBulkImport()">
                                <i data-lucide="shield-check" style="width: 15px; height: 15px;" class="me-1"></i>Kiểm tra &amp; Xem trước
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Dữ liệu CSV hoặc ngăn cách bởi dấu <code>|</code> (mỗi dòng một từ)</label>
                        <textarea id="bulkRawData" name="RawData" class="form-control font-monospace small" rows="6" placeholder="Word,PartOfSpeech,Meaning,Phonetic,ExampleSentence,ExampleMeaning,Mnemonic,Collocations,Synonyms&#10;&quot;assurance&quot;,noun,&quot;sự bảo đảm&quot;,/əˈʃʊərəns/,&quot;The supplier gave us an [assurance] that goods will arrive on time.&quot;,&quot;Nhà cung cấp đã cam đoan hàng sẽ đến đúng hạn.&quot;,&quot;Gốc sure = chắc chắn&quot;,&quot;give an assurance&quot;,&quot;guarantee&quot;"></textarea>
                    </div>

                    <div id="bulkPreviewWrap" style="display: none;">
                        <div class="fw-bold small text-dark mb-2" id="bulkPreviewSummary"></div>
                        <div class="table-responsive border rounded-3" style="max-height: 260px;">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light sticky-top small">
                                    <tr>
                                        <th>#</th>
                                        <th>Từ (Word)</th>
                                        <th>Loại từ</th>
                                        <th>Nghĩa</th>
                                        <th>Ví dụ (<code>[...]</code>)</th>
                                        <th>Kiểm tra lỗi</th>
                                    </tr>
                                </thead>
                                <tbody id="bulkPreviewBody" class="small"></tbody>
                            </table>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="previewBulkImport()">Kiểm tra lại</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="commitBulkImport()">
                    <i data-lucide="check-circle" style="width: 16px; height: 16px;" class="me-1"></i>Lưu các dòng hợp lệ
                </button>
            </div>
        </div>
    </div>
</div>

<form id="antiforgeryForm" hidden>@Html.AntiForgeryToken()</form>

@section Scripts {
<script>
    // ===== HỖ TRỢ PHÁT ÂM AUDIO & WEB SPEECH API =====
    function speakText(text, audioUrl) {
        if (audioUrl && audioUrl.trim() !== '') {
            const audio = new Audio(audioUrl);
            audio.play().catch(() => speakWithTTS(text));
        } else {
            speakWithTTS(text);
        }
    }

    function speakWithTTS(text) {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = 0.9;
            window.speechSynthesis.speak(utterance);
        } else {
            alert('Trình duyệt của bạn không hỗ trợ Web Speech API.');
        }
    }

    function speakCurrentInput() {
        const text = document.getElementById('wordText').value.trim();
        if (text) speakWithTTS(text);
    }

    function getAntiForgeryToken() {
        return document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]')?.value || '';
    }

    function showToast(message, type = 'success') {
        const alertContainer = document.getElementById('indexAlertContainer');
        if (!alertContainer) return;
        const alertId = 'alert-' + Date.now();
        alertContainer.innerHTML = `
            <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}"></i>
                    <span>${message}</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        `;
        if (window.lucide) lucide.createIcons();
        setTimeout(() => {
            const el = document.getElementById(alertId);
            if (el) bootstrap.Alert.getOrCreateInstance(el).close();
        }, 4000);
    }

    // ==========================================
    // DOM READY & CLIENT SEARCH / FILTERING
    // ==========================================
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) {
            lucide.createIcons();
        }

        // ==========================================
        // 1. BỘ LỌC & TÌM KIẾM NHÓM BỘ TỪ (BẢNG 1)
        // ==========================================
        const categorySearchInput = document.getElementById("categorySearchInput");
        const categoryStatusFilter = document.getElementById("categoryStatusFilter");
        const btnResetCategoryFilter = document.getElementById("btnResetCategoryFilter");
        const categoryRows = Array.from(document.querySelectorAll("#categoryTable tbody tr.category-row"));
        const noCategoryMatchRow = document.getElementById("noCategoryMatchRow");
        const categoryCountBadge = document.getElementById("categoryCountBadge");

        function filterCategories() {
            const query = (categorySearchInput?.value || "").trim().toLowerCase();
            const status = categoryStatusFilter?.value || "";

            let visibleCount = 0;
            categoryRows.forEach(row => {
                const title = row.getAttribute("data-title") || "";
                const rowStatus = row.getAttribute("data-status") || "";

                const matchQuery = !query || title.includes(query);
                const matchStatus = !status || rowStatus === status;

                if (matchQuery && matchStatus) {
                    row.style.display = "";
                    visibleCount++;
                    const sttCell = row.querySelector(".category-stt");
                    if (sttCell) sttCell.textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            if (noCategoryMatchRow) {
                noCategoryMatchRow.style.display = (visibleCount === 0 && categoryRows.length > 0) ? "" : "none";
            }
            if (categoryCountBadge) {
                categoryCountBadge.textContent = `${visibleCount}/${categoryRows.length} nhóm`;
            }
        }

        if (categorySearchInput) categorySearchInput.addEventListener("input", filterCategories);
        if (categoryStatusFilter) categoryStatusFilter.addEventListener("change", filterCategories);
        if (btnResetCategoryFilter) {
            btnResetCategoryFilter.addEventListener("click", function () {
                if (categorySearchInput) categorySearchInput.value = "";
                if (categoryStatusFilter) categoryStatusFilter.value = "";
                filterCategories();
            });
        }

        // ==========================================
        // 2. BỘ LỌC, TÌM KIẾM & CHỌN NHIỀU BỘ TỪ (BẢNG 2)
        // ==========================================
        const topicSearchInput = document.getElementById("topicSearchInput");
        const topicCategoryFilter = document.getElementById("topicCategoryFilter");
        const topicLevelFilter = document.getElementById("topicLevelFilter");
        const topicStatusFilter = document.getElementById("topicStatusFilter");
        const btnResetTopicFilter = document.getElementById("btnResetTopicFilter");
        const topicRows = Array.from(document.querySelectorAll("#topicTable tbody tr.topic-row"));
        const noTopicMatchRow = document.getElementById("noTopicMatchRow");
        const visibleTopicCount = document.getElementById("visibleTopicCount");
        const checkAllTopics = document.getElementById("checkAllTopics");
        const bulkTopicActionBar = document.getElementById("bulkTopicActionBar");
        const selectedTopicsBadge = document.getElementById("selectedTopicsBadge");
        const btnClearTopicSelection = document.getElementById("btnClearTopicSelection");
        const btnBulkShowTopics = document.getElementById("btnBulkShowTopics");
        const btnBulkHideTopics = document.getElementById("btnBulkHideTopics");
        const btnBulkDeleteTopics = document.getElementById("btnBulkDeleteTopics");

        function filterTopics() {
            const query = (topicSearchInput?.value || "").trim().toLowerCase();
            const categoryId = topicCategoryFilter?.value || "";
            const level = (topicLevelFilter?.value || "").trim().toLowerCase();
            const status = topicStatusFilter?.value || "";

            let visibleCount = 0;
            topicRows.forEach(row => {
                const title = row.getAttribute("data-title") || "";
                const rowCatId = row.getAttribute("data-category-id") || "";
                const rowCatTitle = row.getAttribute("data-category-title") || "";
                const rowLevel = row.getAttribute("data-level") || "";
                const rowStatus = row.getAttribute("data-status") || "";

                const matchQuery = !query || title.includes(query) || rowCatTitle.includes(query) || rowLevel.includes(query);
                const matchCategory = !categoryId || rowCatId === categoryId;
                const matchLevel = !level || rowLevel.includes(level);
                const matchStatus = !status || rowStatus === status;

                if (matchQuery && matchCategory && matchLevel && matchStatus) {
                    row.style.display = "";
                    visibleCount++;
                    const sttCell = row.querySelector(".topic-stt");
                    if (sttCell) sttCell.textContent = visibleCount;
                } else {
                    row.style.display = "none";
                    const cb = row.querySelector("input.topic-row-checkbox");
                    if (cb) cb.checked = false;
                    row.classList.remove("table-active");
                }
            });

            if (noTopicMatchRow) {
                noTopicMatchRow.style.display = (visibleCount === 0 && topicRows.length > 0) ? "" : "none";
            }
            if (visibleTopicCount) {
                visibleTopicCount.textContent = visibleCount;
            }

            updateSelectedTopicsState();
        }

        if (topicSearchInput) topicSearchInput.addEventListener("input", filterTopics);
        if (topicCategoryFilter) topicCategoryFilter.addEventListener("change", filterTopics);
        if (topicLevelFilter) topicLevelFilter.addEventListener("change", filterTopics);
        if (topicStatusFilter) topicStatusFilter.addEventListener("change", filterTopics);
        if (btnResetTopicFilter) {
            btnResetTopicFilter.addEventListener("click", function () {
                if (topicSearchInput) topicSearchInput.value = "";
                if (topicCategoryFilter) topicCategoryFilter.value = "";
                if (topicLevelFilter) topicLevelFilter.value = "";
                if (topicStatusFilter) topicStatusFilter.value = "";
                filterTopics();
            });
        }

        function getSelectedTopicIds() {
            return Array.from(document.querySelectorAll("#topicTable tbody tr.topic-row input.topic-row-checkbox:checked"))
                .map(cb => parseInt(cb.value, 10))
                .filter(id => !isNaN(id));
        }

        function updateSelectedTopicsState() {
            const checkedBoxes = document.querySelectorAll("#topicTable tbody tr.topic-row:not([style*='display: none']) input.topic-row-checkbox:checked");
            const visibleBoxes = document.querySelectorAll("#topicTable tbody tr.topic-row:not([style*='display: none']) input.topic-row-checkbox");
            const count = checkedBoxes.length;

            if (selectedTopicsBadge) selectedTopicsBadge.textContent = count;

            if (bulkTopicActionBar) {
                if (count > 0) {
                    bulkTopicActionBar.style.setProperty("display", "flex", "important");
                } else {
                    bulkTopicActionBar.style.setProperty("display", "none", "important");
                }
            }

            if (checkAllTopics) {
                checkAllTopics.checked = visibleBoxes.length > 0 && checkedBoxes.length === visibleBoxes.length;
                checkAllTopics.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < visibleBoxes.length;
            }
        }

        if (checkAllTopics) {
            checkAllTopics.addEventListener("change", function () {
                const isChecked = checkAllTopics.checked;
                topicRows.forEach(row => {
                    if (row.style.display !== "none") {
                        const cb = row.querySelector("input.topic-row-checkbox");
                        if (cb) {
                            cb.checked = isChecked;
                            if (isChecked) row.classList.add("table-active");
                            else row.classList.remove("table-active");
                        }
                    }
                });
                updateSelectedTopicsState();
            });
        }

        document.getElementById("topicTable")?.addEventListener("change", function (e) {
            if (e.target && e.target.classList.contains("topic-row-checkbox")) {
                const row = e.target.closest("tr");
                if (row) {
                    if (e.target.checked) row.classList.add("table-active");
                    else row.classList.remove("table-active");
                }
                updateSelectedTopicsState();
            }
        });

        if (btnClearTopicSelection) {
            btnClearTopicSelection.addEventListener("click", function () {
                topicRows.forEach(r => {
                    const cb = r.querySelector("input.topic-row-checkbox");
                    if (cb) cb.checked = false;
                    r.classList.remove("table-active");
                });
                updateSelectedTopicsState();
            });
        }

        async function executeBulkTopicsAction(action) {
            const ids = getSelectedTopicIds();
            if (ids.length === 0) return;

            let confirmMsg = `Bạn có chắc muốn áp dụng hành động "${action}" cho ${ids.length} bộ từ đã chọn?`;
            if (action === 'delete') {
                confirmMsg = `CẢNH BÁO: Xoá ${ids.length} bộ từ sẽ xoá toàn bộ từ vựng bên trong! Bạn có chắc chắn muốn xoá không?`;
            }
            if (!confirm(confirmMsg)) return;

            try {
                const res = await fetch('/Admin/Vocabulary_management/BulkUpdateTopics', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({ ids: ids, action: action })
                });
                const json = await res.json();
                if (json.success) {
                    showToast(json.message);
                    setTimeout(() => location.reload(), 600);
                } else {
                    showToast(json.message || 'Thao tác hàng loạt thất bại.', 'danger');
                }
            } catch (e) {
                showToast('Lỗi máy chủ khi thao tác hàng loạt.', 'danger');
            }
        }

        if (btnBulkShowTopics) btnBulkShowTopics.addEventListener("click", () => executeBulkTopicsAction("show"));
        if (btnBulkHideTopics) btnBulkHideTopics.addEventListener("click", () => executeBulkTopicsAction("hide"));
        if (btnBulkDeleteTopics) btnBulkDeleteTopics.addEventListener("click", () => executeBulkTopicsAction("delete"));

        loadQualityControlData();
    });

    // ===== QUALITY CONTROL LOOP (BÁO LỖI · ĐỘ KHÓ · TOÀN VẸN DỮ LIỆU) =====
    let qcIntegrityCache = [];

    async function loadQualityControlData() {
        try {
            const res = await fetch('/Admin/Vocabulary_management/GetQualityControlData');
            const json = await res.json();
            if (!json.success) return;

            const errors = json.errorQueue || [];
            const difficult = json.difficultWords || [];
            const integrity = json.integrityIssues || [];
            qcIntegrityCache = integrity;

            document.getElementById('qcErrorCount').innerText = errors.length;
            document.getElementById('qcDifficultCount').innerText = difficult.length;
            document.getElementById('qcIntegrityCount').innerText = integrity.length;
            document.getElementById('qcSummaryBadge').innerText = `${errors.length + difficult.length} mục cần ưu tiên`;

            renderQcErrors(errors);
            renderQcDifficult(difficult);
            renderQcIntegrity(integrity);
            if (window.lucide) lucide.createIcons();
        } catch (e) {
            console.warn('QC load error:', e);
        }
    }

    function renderQcErrors(errors) {
        const tbody = document.getElementById('qcErrorTableBody');
        if (!tbody) return;
        if (!errors.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-success py-3">✓ Hộp thư báo lỗi đang trống!</td></tr>';
            return;
        }
        tbody.innerHTML = errors.map(item => `
            <tr>
                <td><span class="badge bg-danger-subtle text-danger">${escapeHtmlModal(item.categoryTag)}</span></td>
                <td class="fw-bold">${escapeHtmlModal(item.word || 'Chưa gắn từ')}</td>
                <td>${escapeHtmlModal(item.content)}</td>
                <td class="text-muted">${escapeHtmlModal(item.createdAt)}</td>
                <td class="text-end text-nowrap">
                    ${item.wordId > 0 ? `<button type="button" class="btn btn-sm btn-outline-primary rounded-pill me-1" onclick="editWord(${item.wordId})">Mở sửa từ</button>` : ''}
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="resolveQcFeedback(${item.feedbackId})">Đã xử lý</button>
                </td>
            </tr>`).join('');
    }

    function renderQcDifficult(list) {
        const tbody = document.getElementById('qcDifficultTableBody');
        if (!tbody) return;
        if (!list.length) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-success py-3">✓ Chưa có từ nào có tỷ lệ quên hoặc lỗi gõ bất thường.</td></tr>';
            return;
        }
        tbody.innerHTML = list.map(item => `
            <tr>
                <td><div class="fw-bold">${escapeHtmlModal(item.word)}</div><div class="text-muted">${escapeHtmlModal(item.meaning)}</div></td>
                <td>${escapeHtmlModal(item.topicTitle)}</td>
                <td>${item.reviewCount} lượt</td>
                <td><span class="badge ${item.againRate > 70 ? 'bg-danger-subtle text-danger' : 'bg-secondary-subtle text-secondary'}">${item.againRate}%</span></td>
                <td><span class="badge ${item.typingFailCount >= 3 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-light text-dark'}">${item.typingFailCount} lần</span></td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="editWord(${item.wordId}, 'tab-word-typing-tab')">Biên tập lại</button>
                </td>
            </tr>`).join('');
    }

    function filterQcIntegrity(kind, btn) {
        document.querySelectorAll('#qcIntegrityFilters button').forEach(b => {
            b.className = 'btn btn-xs btn-sm btn-outline-secondary rounded-pill';
        });
        if (btn) btn.className = 'btn btn-xs btn-sm btn-primary rounded-pill active';

        let filtered = qcIntegrityCache;
        if (kind === 'audio') filtered = qcIntegrityCache.filter(x => x.missingAudio);
        else if (kind === 'blank') filtered = qcIntegrityCache.filter(x => x.missingBlankMarker);
        else if (kind === 'example') filtered = qcIntegrityCache.filter(x => x.missingExample);
        else if (kind === 'tip') filtered = qcIntegrityCache.filter(x => x.missingTip);
        renderQcIntegrity(filtered);
    }

    function renderQcIntegrity(list) {
        const tbody = document.getElementById('qcIntegrityTableBody');
        if (!tbody) return;
        if (!list.length) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center text-success py-3">✓ Không có từ nào bị thiếu dữ liệu trong bộ lọc này.</td></tr>';
            return;
        }
        tbody.innerHTML = list.map(item => {
            const targetTab = (item.missingBlankMarker || item.missingExample)
                ? 'tab-word-typing-tab'
                : (item.missingTip && !item.missingAudio ? 'tab-word-lesson-tab' : 'tab-word-core-tab');
            return `
                <tr>
                    <td><span class="fw-bold">${escapeHtmlModal(item.word)}</span> <span class="text-muted">— ${escapeHtmlModal(item.meaning)}</span></td>
                    <td>${escapeHtmlModal(item.topicTitle)}</td>
                    <td>${(item.tags || []).map(t => `<span class="badge bg-warning-subtle text-warning-emphasis me-1">${escapeHtmlModal(t)}</span>`).join('')}</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="editWord(${item.wordId}, '${targetTab}')">Bổ sung ngay</button>
                    </td>
                </tr>`;
        }).join('');
    }

    async function resolveQcFeedback(feedbackId) {
        try {
            const res = await fetch(`/Admin/Vocabulary_management/ResolveVocabFeedback?feedbackId=${feedbackId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getAntiForgeryToken() }
            });
            const json = await res.json();
            if (json.success) {
                showToast(json.message);
                loadQualityControlData();
            } else {
                showToast(json.message || 'Không thể xử lý.', 'danger');
            }
        } catch {
            showToast('Lỗi máy chủ khi cập nhật phản hồi.', 'danger');
        }
    }

    // ===== MODAL TỪ VỰNG TẬP TRUNG (4 TAB) =====
    function escapeHtmlModal(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function escapeRegexModal(value) {
        return String(value ?? '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function parseTagList(hiddenId, rawValue) {
        const str = String(rawValue || '').trim();
        if (!str) return [];
        if (hiddenId === 'wordCollocations') {
            if (/[;\r\n|]/.test(str)) {
                return str.split(/[;\r\n|]+/).map(s => s.trim()).filter(Boolean);
            }
            if (str.includes(' — ')) {
                return [str];
            }
            return str.split(/[,;\r\n|]+/).map(s => s.trim()).filter(Boolean);
        }
        return str.split(/[,;\r\n|]+/).map(s => s.trim()).filter(Boolean);
    }

    function joinTagList(hiddenId, items) {
        return hiddenId === 'wordCollocations' ? items.join('; ') : items.join(', ');
    }

    function syncTagInputUI(hiddenId) {
        const hiddenEl = document.getElementById(hiddenId);
        const container = document.querySelector(`[data-tag-container="${hiddenId}"]`);
        const textInput = document.querySelector(`[data-tag-input="${hiddenId}"]`);
        if (!hiddenEl || !container) return;

        container.querySelectorAll('.vocab-tag-chip').forEach(el => el.remove());
        const tags = parseTagList(hiddenId, hiddenEl.value);
        if (hiddenId === 'wordCollocations') {
            const hint = document.getElementById('collocEmptyHint');
            if (hint) hint.style.display = tags.length ? 'none' : 'inline';
        }

        tags.forEach((tag, idx) => {
            const chip = document.createElement('span');
            if (hiddenId === 'wordCollocations') {
                chip.className = 'vocab-tag-chip d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill small';
                chip.style.cssText = 'background-color:#f5e8ff;color:#a21caf;border:1px solid #e9d5ff;font-weight:500;';
                const parts = tag.split(/\s+—\s+/);
                const labelHtml = parts.length >= 2
                    ? `<span class="tag-edit-trigger" style="cursor:pointer;" title="Nhấn để sửa"><strong class="fw-bold">${escapeHtmlModal(parts[0])}</strong> — ${escapeHtmlModal(parts.slice(1).join(' — '))}</span>`
                    : `<span class="tag-edit-trigger" style="cursor:pointer;" title="Nhấn để sửa"><strong>${escapeHtmlModal(tag)}</strong></span>`;
                chip.innerHTML = `${labelHtml}<button type="button" class="btn-close" style="font-size: 0.55rem;" aria-label="Xóa"></button>`;
                chip.querySelector('.tag-edit-trigger')?.addEventListener('click', () => {
                    const enEl = document.getElementById('collocEnInput');
                    const viEl = document.getElementById('collocViInput');
                    if (enEl) enEl.value = parts[0] || '';
                    if (viEl) viEl.value = parts.length >= 2 ? parts.slice(1).join(' — ') : '';
                    const updated = tags.filter((_, i) => i !== idx);
                    hiddenEl.value = joinTagList(hiddenId, updated);
                    syncTagInputUI(hiddenId);
                    updateLiveModalPreview();
                    enEl?.focus();
                });
            } else {
                chip.className = 'vocab-tag-chip badge bg-primary-subtle text-primary d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill';
                chip.innerHTML = `<span>${escapeHtmlModal(tag)}</span><button type="button" class="btn-close" style="font-size: 0.55rem;" aria-label="Xóa"></button>`;
            }
            chip.querySelector('button').addEventListener('click', () => {
                const updated = tags.filter((_, i) => i !== idx);
                hiddenEl.value = joinTagList(hiddenId, updated);
                syncTagInputUI(hiddenId);
                updateLiveModalPreview();
            });
            if (textInput) container.insertBefore(chip, textInput);
            else container.appendChild(chip);
        });
    }

    function addTagToHidden(hiddenId, rawTag) {
        const hiddenEl = document.getElementById(hiddenId);
        if (!hiddenEl) return;
        const incoming = parseTagList(hiddenId, rawTag);
        if (!incoming.length) return;
        const existing = parseTagList(hiddenId, hiddenEl.value);
        for (const item of incoming) {
            if (!existing.some(e => e.toLowerCase() === item.toLowerCase())) {
                existing.push(item);
            }
        }
        hiddenEl.value = joinTagList(hiddenId, existing);
        syncTagInputUI(hiddenId);
        updateLiveModalPreview();
    }

    function addCollocationPair() {
        const enEl = document.getElementById('collocEnInput');
        const viEl = document.getElementById('collocViInput');
        const en = (enEl?.value || '').trim();
        const vi = (viEl?.value || '').trim();
        if (!en && !vi) return;
        if (!en) {
            showToast('Vui lòng nhập cụm tiếng Anh trước.', 'warning');
            enEl?.focus();
            return;
        }
        const entry = vi ? `${en} — ${vi}` : en;
        addTagToHidden('wordCollocations', entry);
        if (enEl) enEl.value = '';
        if (viEl) viEl.value = '';
        enEl?.focus();
    }

    let extraExamplesList = [];

    function renderExtraExamplesUI() {
        const container = document.getElementById('extraExamplesPreviewList');
        if (!container) return;
        if (!extraExamplesList.length) {
            container.innerHTML = `<div class="text-muted small fst-italic px-1">Chưa có ví dụ bổ sung. Nhập 2 ô trên hoặc bấm <strong>Gợi ý Bài học bằng AI</strong>.</div>`;
            return;
        }
        container.innerHTML = extraExamplesList.map((ex, idx) => `
            <div class="p-3 rounded-4 position-relative" style="border:1px solid #e9d5ff;background:#fbf9fe;">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-2" style="font-size:0.65rem;" aria-label="Xóa" onclick="removeExtraExamplePair(${idx})"></button>
                <div class="extra-ex-edit" style="cursor:pointer;" title="Nhấn để sửa" onclick="editExtraExamplePair(${idx})">
                    <div class="fw-bold text-uppercase mb-1" style="font-size:0.72rem;color:#9333ea;letter-spacing:0.04em;">❞ VÍ DỤ</div>
                    <div class="fw-bold fst-italic text-dark small mb-1">“${escapeHtmlModal(ex.en)}”</div>
                    <div class="text-muted small">${escapeHtmlModal(ex.vi || '(Chưa có bản dịch tiếng Việt)')}</div>
                </div>
            </div>
        `).join('');
    }

    function addExtraExamplePair() {
        const enEl = document.getElementById('extraExEnInput');
        const viEl = document.getElementById('extraExViInput');
        const en = (enEl?.value || '').replace(/\r?\n+/g, ' ').trim();
