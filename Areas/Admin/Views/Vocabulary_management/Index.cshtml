@model VocabManagementViewModel
@{
    ViewData["Title"] = "Quản lý Từ vựng";
}

@section Styles {
<style>
    /* Admin Filter Bar & Search Input (Đồng bộ chuẩn Trang Quản lý Ngữ pháp) */
    .admin-filter-bar .input-group-search {
        display: flex;
        align-items: center;
        background: var(--hr-surface, #fff);
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        border-radius: 12px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        height: 42px;
        overflow: hidden;
    }
    .admin-filter-bar .input-group-search:focus-within {
        border-color: var(--hr-primary, #4f46e5);
        box-shadow: var(--hr-ring, 0 0 0 4px rgba(79, 70, 229, 0.22));
    }
    .admin-filter-bar .input-group-search .search-icon {
        padding: 0 10px 0 14px;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .admin-filter-bar .input-group-search input.form-control {
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
        padding-left: 0 !important;
        height: 100% !important;
        font-size: 0.92rem;
    }
    .admin-filter-bar .form-select {
        height: 42px;
        border-radius: 12px;
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        font-size: 0.92rem;
    }
    .admin-filter-bar .btn-filter-reset {
        height: 42px;
        border-radius: 12px;
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .admin-filter-bar .btn-filter-reset:not(.w-100) {
        width: 42px;
        padding: 0;
    }

    /* Badges & Box icons giống Quản lý Ngữ pháp */
    .category-title-link {
        color: #1e293b;
        transition: color 0.15s ease;
    }
    .category-title-link:hover {
        color: var(--hr-primary, #4f46e5);
    }
    .custom-count-badge {
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
    }
    .topic-icon-box {
        background-color: #eef2ff;
        color: #4f46e5;
        border: 1px solid #e0e7ff;
    }

    /* Dark Mode styles tương thích đồng bộ */
    [data-bs-theme="dark"] .card-header {
        background-color: var(--hr-surface-2, #242247) !important;
        border-bottom-color: var(--hr-line, #2d2a52) !important;
        color: var(--hr-ink, #f2f0fb) !important;
    }
    [data-bs-theme="dark"] .table thead,
    [data-bs-theme="dark"] .table thead th {
        background-color: var(--hr-surface-2, #242247) !important;
        color: var(--hr-ink, #f2f0fb) !important;
        border-bottom-color: var(--hr-line, #2d2a52) !important;
    }
    [data-bs-theme="dark"] .table > :not(caption) > * > * {
        background-color: transparent;
        color: var(--hr-ink, #f2f0fb);
        border-bottom-color: var(--hr-line, #2d2a52);
    }
    [data-bs-theme="dark"] .table-hover > tbody > tr:hover > * {
        background-color: rgba(143, 136, 255, 0.08) !important;
        color: var(--hr-ink, #f2f0fb);
    }
    [data-bs-theme="dark"] .category-title-link,
    [data-bs-theme="dark"] .topic-title-text {
        color: var(--hr-ink, #f2f0fb) !important;
    }
    [data-bs-theme="dark"] .category-title-link:hover {
        color: var(--hr-primary, #8f88ff) !important;
    }
    [data-bs-theme="dark"] .topic-filter-panel {
        background-color: var(--hr-surface, #1b1a37) !important;
        border-bottom-color: var(--hr-line, #2d2a52) !important;
    }
    [data-bs-theme="dark"] .filter-counter-text {
        color: var(--hr-muted, #aaa6cb) !important;
    }
    [data-bs-theme="dark"] .custom-count-badge {
        background-color: var(--hr-surface-2, #242247) !important;
        color: var(--hr-ink-2, #d6d2f0) !important;
        border-color: var(--hr-line-2, #3c3968) !important;
    }
    [data-bs-theme="dark"] .topic-icon-box {
        background-color: rgba(143, 136, 255, 0.16) !important;
        border-color: rgba(143, 136, 255, 0.28) !important;
        color: var(--hr-primary, #8f88ff) !important;
    }
    [data-bs-theme="dark"] .category-stt,
    [data-bs-theme="dark"] .topic-stt {
        color: var(--hr-muted, #aaa6cb) !important;
    }
    [data-bs-theme="dark"] .table-active {
        --bs-table-active-bg: rgba(143, 136, 255, 0.15);
        --bs-table-active-color: var(--hr-ink, #f2f0fb);
    }
</style>
}

<!-- HEADER TRANG ADMIN QUẢN LÝ TỪ VỰNG -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Quản lý Từ vựng</h1>
        <p class="text-muted small mb-0">Quản lý hệ thống thư mục cha (<strong>Nhóm bộ từ</strong>) và thư mục con (<strong>Bộ từ vựng</strong>). Nhấn <strong>Từ vựng</strong> ở mỗi bộ để quản lý <strong>Học thẻ</strong> &amp; <strong>Ghép cụm từ</strong>.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-secondary" onclick="openBulkImportModal()" title="Nhập danh sách từ vựng từ tệp Excel/CSV">
            <i data-lucide="file-spreadsheet" class="me-1"></i>Nhập Excel / CSV
        </button>
        <button type="button" class="btn btn-outline-primary" onclick="openCategoryModal()">
            <i data-lucide="plus" class="me-1"></i>Nhóm bộ từ
        </button>
        <button type="button" class="btn btn-primary" onclick="openTopicModal(@(Model.SelectedCategoryId ?? 0))">
            <i data-lucide="plus" class="me-1"></i>Bộ từ
        </button>
    </div>
</div>

<div id="indexAlertContainer"></div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-lucide="check-circle" class="me-2 text-success"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<!-- ROW THỐNG KÊ KPI CARDS (BORDER-START COLOR THEME) -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Nhóm bộ từ (Cha)</div>
                <div class="display-6 fw-bold text-primary">@Model.Categories.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Bộ từ vựng (Con)</div>
                <div class="display-6 fw-bold text-success">@Model.TotalTopics</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Từ vựng (Học thẻ)</div>
                <div class="display-6 fw-bold text-info">@Model.TotalWords</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Cụm từ ghép</div>
                <div class="display-6 fw-bold text-warning" id="kpiTotalPhrases">@Model.TotalPhrases</div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- [BẢNG 1] NHÓM BỘ TỪ (THƯ MỤC CHA - CATEGORIES)                 -->
<!-- ============================================================== -->
<div class="card shadow-sm mb-4">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-primary"><i data-lucide="layers" class="me-1"></i>Nhóm bộ từ</span>
                <span id="categoryCountBadge" class="badge custom-count-badge">@Model.Categories.Count nhóm</span>
            </div>
            <!-- Bộ lọc tìm kiếm nhóm bộ từ tức thì -->
            <div class="d-flex align-items-center gap-2 flex-nowrap ms-auto admin-filter-bar">
                <div class="input-group-search" style="width: 260px;">
                    <span class="search-icon"><i data-lucide="search"></i></span>
                    <input type="text" id="categorySearchInput" class="form-control" placeholder="Tìm kiếm nhóm bộ từ..." />
                </div>
                <select id="categoryStatusFilter" class="form-select" style="width: 170px; flex-shrink: 0;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Hiển thị</option>
                    <option value="inactive">Ẩn</option>
                </select>
                <button type="button" id="btnResetCategoryFilter" class="btn btn-outline-secondary btn-filter-reset flex-shrink-0" title="Đặt lại bộ lọc nhóm">
                    <i data-lucide="rotate-ccw"></i>
                </button>
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="categoryTable">
            <thead>
                <tr>
                    <th style="width: 60px;" class="text-center">STT</th>
                    <th>Tiêu đề (Thư mục cha)</th>
                    <th class="text-center" style="width: 120px;">Bộ từ con</th>
                    <th class="text-center" style="width: 130px;">Học thẻ</th>
                    <th class="text-center" style="width: 130px;">Ghép cụm từ</th>
                    <th style="width: 130px;">Trạng thái</th>
                    <th class="text-end text-nowrap" style="width: 160px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int catStt = 1; }
                @foreach (var c in Model.Categories)
                {
                    <tr class="category-row @(Model.SelectedCategoryId == c.CategoryId ? "table-active" : "")"
                        id="row-cat-@c.CategoryId"
                        data-id="@c.CategoryId"
                        data-title="@c.Name.ToLower()"
                        data-status="@(c.IsActive ? "active" : "inactive")">
                        <td class="category-stt text-center fw-semibold">@(catStt++)</td>
                        <td>
                            <a asp-action="Index" asp-route-categoryId="@(Model.SelectedCategoryId == c.CategoryId ? null : c.CategoryId)"
                               class="category-title-link fw-semibold text-decoration-none"
                               title="@(Model.SelectedCategoryId == c.CategoryId ? "Bỏ lọc theo nhóm này" : "Lọc các bộ từ con thuộc nhóm này")">
                                @c.Name
                            </a>
                            @if (!string.IsNullOrEmpty(c.Code))
                            {
                                <span class="badge bg-light text-muted border ms-1 font-monospace" style="font-size: 11px;">@c.Code</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill custom-count-badge">@c.TopicCount bộ từ</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill custom-count-badge text-primary">@c.WordCount từ</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill custom-count-badge text-info">@c.PhraseCount cụm</span>
                        </td>
                        <td class="category-status-cell">
                            @if (c.IsActive)
                            {
                                <span class="badge text-bg-success">Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Ẩn</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex align-items-center justify-content-end" style="gap: 6px;">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap"
                                        onclick="editCategory(@c.CategoryId)" title="Chỉnh sửa nhóm">
                                    <i data-lucide="square-pen" class="me-1"></i><span>Sửa</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap"
                                        onclick="deleteCategory(@c.CategoryId, '@c.Name')" title="Xoá nhóm">
                                    <i data-lucide="trash-2" class="me-1"></i><span>Xoá</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Categories.Count == 0)
                {
                    <tr id="emptyCategoryRow"><td colspan="7" class="text-center text-muted py-4">Chưa có nhóm bộ từ nào.</td></tr>
                }
                <tr id="noCategoryMatchRow" style="display: none;">
                    <td colspan="7" class="text-center text-muted py-4"><i data-lucide="filter-x" class="me-2"></i>Không tìm thấy nhóm bộ từ nào phù hợp.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- ============================================================== -->
<!-- [BẢNG 2] BỘ TỪ VỰNG (TOPICS)                                   -->
<!-- ============================================================== -->
<div class="card shadow-sm mb-4">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-success"><i data-lucide="book-marked" class="me-1"></i>Bộ từ vựng</span>
                <span id="topicGroupFilterLabel" class="text-muted small">
                    @(Model.SelectedCategoryId.HasValue ? "(đang lọc theo nhóm)" : "(tất cả)")
                </span>
                <span id="topicCountBadge" class="badge custom-count-badge ms-1">@Model.Topics.Count bộ từ</span>
            </div>
            @if (Model.SelectedCategoryId.HasValue)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index">
                    <i data-lucide="x" class="me-1"></i>Bỏ lọc nhóm URL
                </a>
            }
        </div>
    </div>

    <!-- Bộ lọc & tìm kiếm bộ từ -->
    <div class="p-3 border-bottom topic-filter-panel admin-filter-bar">
        <div class="row g-2 align-items-center">
            <div class="col-lg-4 col-md-5">
                <div class="input-group-search w-100">
                    <span class="search-icon"><i data-lucide="search"></i></span>
                    <input type="text" id="topicSearchInput" class="form-control" placeholder="Tìm kiếm tên bộ từ, nhóm, cấp độ..." />
                </div>
            </div>
            <div class="col-lg-3 col-md-3">
                <select id="topicCategoryFilter" class="form-select">
                    <option value="">-- Tất cả nhóm bộ từ --</option>
                    @foreach (var c in Model.Categories)
                    {
                        <!option value="@c.CategoryId" @(Model.SelectedCategoryId == c.CategoryId ? "selected" : "")>@c.Name@(!c.IsActive ? " (Ẩn)" : "")</!option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-2">
                <select id="topicLevelFilter" class="form-select">
                    <option value="">-- Tất cả cấp độ / kỳ thi --</option>
                    <option value="A1">A1 - Cơ bản</option>
                    <option value="A2">A2 - Sơ cấp</option>
                    <option value="B1">B1 - Trung cấp</option>
                    <option value="B2">B2 - Khá</option>
                    <option value="C1">C1 - Cao cấp</option>
                    <option value="TOEIC">TOEIC</option>
                    <option value="IELTS">IELTS</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-2">
                <select id="topicStatusFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="active">Hiển thị</option>
                    <option value="inactive">Ẩn</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-12">
                <button type="button" id="btnResetTopicFilter" class="btn btn-outline-secondary btn-filter-reset w-100" title="Đặt lại bộ lọc">
                    <i data-lucide="rotate-ccw"></i>
                </button>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small filter-counter-text text-muted">
            <span>Đang hiển thị <strong id="visibleTopicCount" class="text-success">@Model.Topics.Count</strong> trên tổng số <strong>@Model.Topics.Count</strong> bộ từ</span>
        </div>
    </div>

    <!-- Thanh thao tác hàng loạt cho các bộ từ có dấu tích chọn -->
    <div id="bulkTopicActionBar" class="alert alert-info py-2 px-3 mx-3 mt-3 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-sm" style="display: none !important;">
        <div class="d-flex align-items-center gap-2">
            <i data-lucide="check-circle" class="text-primary fs-5"></i>
            <span>Đã chọn <strong id="selectedTopicsBadge" class="text-primary">0</strong> bộ từ</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-success rounded-pill px-3" id="btnBulkShowTopics">
                <i data-lucide="eye" class="me-1"></i>Hiện mục chọn
            </button>
            <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-3" id="btnBulkHideTopics">
                <i data-lucide="eye-off" class="me-1"></i>Ẩn mục chọn
            </button>
            <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" id="btnBulkDeleteTopics">
                <i data-lucide="trash-2" class="me-1"></i>Xoá mục chọn
            </button>
            <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted" id="btnClearTopicSelection">
                Bỏ chọn
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="topicTable">
            <thead>
                <tr>
                    <th style="width: 40px;" class="text-center">
                        <input type="checkbox" id="checkAllTopics" class="form-check-input" title="Chọn tất cả">
                    </th>
                    <th style="width: 60px;" class="text-center">STT</th>
                    <th>Bộ từ vựng (Thư mục con)</th>
                    <th>Nhóm cha</th>
                    <th style="width: 130px;">Cấp độ / Kỳ thi</th>
                    <th class="text-center" style="width: 110px;">Học thẻ</th>
                    <th class="text-center" style="width: 120px;">Ghép cụm từ</th>
                    <th style="width: 110px;">Trạng thái</th>
                    <th class="text-end text-nowrap" style="width: 320px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int topicStt = 1; }
                @foreach (var t in Model.Topics)
                {
                    <tr class="topic-row"
                        id="topic-row-@t.TopicId"
                        data-id="@t.TopicId"
                        data-title="@t.Title.ToLower()"
                        data-category-id="@t.CategoryId"
                        data-category-title="@t.CategoryName.ToLower()"
                        data-level="@(t.Level?.ToLower() ?? "")"
                        data-status="@(t.IsActive ? "active" : "inactive")">
                        <td class="text-center">
                            <input type="checkbox" class="form-check-input topic-row-checkbox" value="@t.TopicId">
                        </td>
                        <td class="topic-stt text-center fw-semibold">@(topicStt++)</td>
                        <td class="fw-semibold">
                            <div class="d-inline-flex align-items-center gap-2">
                                @{
                                    var displayColor = !string.IsNullOrEmpty(t.Color) ? t.Color.ToLower() : (!string.IsNullOrEmpty(t.CategoryColor) ? t.CategoryColor.ToLower() : "primary");
                                    var displayIcon = !string.IsNullOrEmpty(t.Icon) ? t.Icon : "book-open";
                                    var (boxBg, boxFg) = displayColor switch {
                                        "fuchsia" => ("rgba(192, 38, 211, 0.12)", "#c026d3"),
                                        "amber" or "orange" => ("rgba(234, 88, 12, 0.12)", "#ea580c"),
                                        "emerald" or "green" => ("rgba(5, 150, 105, 0.12)", "#059669"),
                                        "rose" or "red" => ("rgba(225, 29, 72, 0.12)", "#e11d48"),
                                        "cyan" => ("rgba(8, 145, 178, 0.12)", "#0891b2"),
                                        "indigo" => ("rgba(79, 70, 229, 0.12)", "#4f46e5"),
                                        "purple" => ("rgba(147, 51, 234, 0.12)", "#9333ea"),
                                        _ => ("rgba(37, 99, 235, 0.12)", "#2563eb")
                                    };
                                }
                                <span class="topic-icon-box d-inline-flex align-items-center justify-content-center rounded-3" style="width: 32px; height: 32px; flex-shrink: 0; background-color: @boxBg; color: @boxFg;" title="Biểu tượng: @displayIcon (@displayColor)">
                                    <i data-lucide="@displayIcon" style="width: 16px; height: 16px;"></i>
                                </span>
                                <span class="topic-title-text">@t.Title</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge custom-count-badge">@t.CategoryName</span>
                        </td>
                        <td>
                            <span class="small text-secondary fw-semibold">@(string.IsNullOrEmpty(t.Level) ? "Mặc định" : t.Level)</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Words" asp-route-topicId="@t.TopicId" asp-route-tab="flashcards" class="badge rounded-pill custom-count-badge text-primary text-decoration-none" title="Quản lý Học thẻ của bộ từ này">
                                @t.WordCount từ
                            </a>
                        </td>
                        <td class="text-center">
                            <a asp-action="Words" asp-route-topicId="@t.TopicId" asp-route-tab="phrases" class="badge rounded-pill custom-count-badge text-info text-decoration-none" title="Quản lý Ghép cụm từ của bộ từ này">
                                @t.PhraseCount cụm
                            </a>
                        </td>
                        <td class="topic-status-cell">
                            @if (t.IsActive)
                            {
                                <span class="badge text-bg-success"><i data-lucide="check-circle" class="me-1"></i>Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary"><i data-lucide="eye-off" class="me-1"></i>Ẩn</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex align-items-center justify-content-end" style="gap: 6px;">
                                <a class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap"
                                   asp-action="Words" asp-route-topicId="@t.TopicId" title="Mở trang Từ vựng (Học thẻ &amp; Ghép cụm từ)">
                                    <i data-lucide="book-open" class="me-1"></i><span>Từ vựng</span>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap"
                                        onclick="openWordModal(@t.TopicId)" title="Thêm từ vựng vào bộ này">
                                    <i data-lucide="plus" class="me-1"></i><span>Thêm từ</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap"
                                        onclick="editTopic(@t.TopicId)" title="Chỉnh sửa bộ từ">
                                    <i data-lucide="square-pen" class="me-1"></i><span>Sửa</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap"
                                        onclick="deleteTopic(@t.TopicId, '@t.Title')" title="Xoá bộ từ">
                                    <i data-lucide="trash-2" class="me-1"></i><span>Xoá</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Topics.Count == 0)
                {
                    <tr id="emptyTopicRow"><td colspan="9" class="text-center text-muted py-4">Chưa có bộ từ nào.</td></tr>
                }
                <tr id="noTopicMatchRow" style="display: none;">
                    <td colspan="9" class="text-center text-muted py-4"><i data-lucide="filter-x" class="me-2"></i>Không tìm thấy bộ từ vựng nào phù hợp.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- ============================================================== -->
<!-- [BẢNG 3] KIỂM DUYỆT CHẤT LƯỢNG (QUALITY CONTROL LOOP)           -->
<!-- ============================================================== -->
<div class="card shadow-sm mb-4" id="qcSection">
    <div class="card-header py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-danger"><i data-lucide="shield-alert" class="me-1"></i>Giám sát Chất lượng &amp; Kiểm duyệt Từ vựng</span>
            <span class="badge bg-danger-subtle text-danger rounded-pill" id="qcSummaryBadge">Đang tải...</span>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="loadQualityControlData()">
            <i data-lucide="refresh-cw" style="width: 14px; height: 14px;" class="me-1"></i>Làm mới dữ liệu
        </button>
    </div>
    <div class="px-3 pt-2 border-bottom bg-light">
        <ul class="nav nav-tabs border-0" id="qcTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active fw-semibold small" data-bs-toggle="tab" data-bs-target="#qc-errors" type="button" role="tab">
                    Hộp thư Báo lỗi <span class="badge bg-danger ms-1" id="qcErrorCount">0</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold small" data-bs-toggle="tab" data-bs-target="#qc-difficult" type="button" role="tab">
                    Cảnh báo Độ khó bất thường <span class="badge bg-warning text-dark ms-1" id="qcDifficultCount">0</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold small" data-bs-toggle="tab" data-bs-target="#qc-integrity" type="button" role="tab">
                    Kiểm tra Tính toàn vẹn <span class="badge bg-info text-dark ms-1" id="qcIntegrityCount">0</span>
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content">
            <!-- TAB QC 1: HỘP THƯ BÁO LỖI -->
            <div class="tab-pane fade show active p-3" id="qc-errors" role="tabpanel">
                <div class="table-responsive" style="max-height: 300px;">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Phân loại</th>
                                <th>Từ vựng</th>
                                <th>Nội dung học viên báo</th>
                                <th>Thời gian</th>
                                <th class="text-end">Xử lý</th>
                            </tr>
                        </thead>
                        <tbody id="qcErrorTableBody" class="small">
                            <tr><td colspan="5" class="text-center text-muted py-3">Đang tải danh sách báo lỗi...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB QC 2: CẢNH BÁO ĐỘ KHÓ BẤT THƯỜNG -->
            <div class="tab-pane fade p-3" id="qc-difficult" role="tabpanel">
                <p class="small text-muted mb-2">Các từ có tỷ lệ học viên chọn <strong>Học lại (Quên) &gt; 70%</strong> hoặc <strong>Gõ sai &ge; 3 lần</strong> để Admin biên tập lại câu ví dụ, đáp án hoặc mẹo nhớ.</p>
                <div class="table-responsive" style="max-height: 300px;">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Từ vựng</th>
                                <th>Bộ từ</th>
                                <th>Lượt ôn</th>
                                <th>Tỷ lệ Học lại</th>
                                <th>Lỗi Gõ</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="qcDifficultTableBody" class="small">
                            <tr><td colspan="6" class="text-center text-muted py-3">Đang phân tích dữ liệu SRS...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB QC 3: KIỂM TRA TÍNH TOÀN VẸN -->
            <div class="tab-pane fade p-3" id="qc-integrity" role="tabpanel">
                <div class="d-flex flex-wrap gap-2 mb-2" id="qcIntegrityFilters">
                    <button type="button" class="btn btn-xs btn-sm btn-primary rounded-pill active" onclick="filterQcIntegrity('all', this)">Tất cả</button>
                    <button type="button" class="btn btn-xs btn-sm btn-outline-secondary rounded-pill" onclick="filterQcIntegrity('audio', this)">Thiếu Audio</button>
                    <button type="button" class="btn btn-xs btn-sm btn-outline-secondary rounded-pill" onclick="filterQcIntegrity('blank', this)">Chưa bọc [...] ô trống</button>
                    <button type="button" class="btn btn-xs btn-sm btn-outline-secondary rounded-pill" onclick="filterQcIntegrity('example', this)">Thiếu câu ví dụ</button>
                    <button type="button" class="btn btn-xs btn-sm btn-outline-secondary rounded-pill" onclick="filterQcIntegrity('tip', this)">Thiếu Mẹo nhớ</button>
                </div>
                <div class="table-responsive" style="max-height: 300px;">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Từ vựng</th>
                                <th>Bộ từ</th>
                                <th>Dữ liệu còn thiếu</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="qcIntegrityTableBody" class="small">
                            <tr><td colspan="4" class="text-center text-muted py-3">Đang quét tính toàn vẹn dữ liệu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODAL THÊM / SỬA TỪ VỰNG (4 TAB TẬP TRUNG) ==================== -->
<div class="modal fade" id="modalWord" tabindex="-1" aria-labelledby="modalWordTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-bottom px-4 pt-4 pb-3 bg-light">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white" style="width: 38px; height: 38px;">
                        <i data-lucide="spell-check" style="width: 20px; height: 20px;"></i>
                    </span>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="modalWordTitle">Thêm Từ Vựng Mới</h5>
                        <small class="text-muted">Cung cấp đầy đủ 12 thành phần ngữ nghĩa học để tối ưu trải nghiệm học sinh</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <!-- 4 Tab điều hướng (Thông tin từ · Bài học · Quiz · Gõ) -->
            <div class="px-4 pt-2 border-bottom bg-light">
                <ul class="nav nav-tabs border-0" id="modalWordTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" id="tab-word-core-tab" data-bs-toggle="tab" data-bs-target="#tab-word-core" type="button" role="tab" onclick="updateLiveModalPreview()">
                            1. Thông tin từ
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="tab-word-lesson-tab" data-bs-toggle="tab" data-bs-target="#tab-word-lesson" type="button" role="tab" onclick="updateLiveModalPreview()">
                            2. Bài học
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="tab-word-quiz-tab" data-bs-toggle="tab" data-bs-target="#tab-word-quiz" type="button" role="tab" onclick="updateLiveModalPreview()">
                            3. Quiz
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold text-primary" id="tab-word-typing-tab" data-bs-toggle="tab" data-bs-target="#tab-word-typing" type="button" role="tab" onclick="updateLiveModalPreview()">
                            4. Gõ
                        </button>
                    </li>
                </ul>
            </div>

            <div class="modal-body px-4 py-3">
                <form id="formWord">
                    <input type="hidden" id="wordId" name="WordId" value="0" />

                    <div class="tab-content" id="modalWordTabsContent">
                        <!-- TAB 1: THÔNG TIN TỪ -->
                        <div class="tab-pane fade show active" id="tab-word-core" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label class="form-label fw-semibold small">Từ tiếng Anh (Headword) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="text" id="wordText" name="Word" class="form-control fw-bold fs-5" placeholder="vd: assurance, contract, abide by..." onblur="if(this.value.trim() && !document.getElementById('wordMeaning').value.trim()) autoFillWordFromApi(true)" required />
                                        <button class="btn btn-primary fw-semibold px-3" type="button" id="btnAutoFillWord" onclick="autoFillWordFromApi(false)" title="Tự động điền từ Từ điển (0 token LLM)">
                                            <i data-lucide="wand-2" style="width: 16px; height: 16px;" class="me-1"></i>Gợi ý tự động
                                        </button>
                                        <button class="btn btn-outline-secondary" type="button" onclick="speakCurrentInput()" title="Nghe phát âm"><i data-lucide="volume-2" style="width: 18px; height: 18px;"></i></button>
                                    </div>
                                    <div id="autoFillStatus" class="form-text text-muted small">Phần 1 (Từ điển · 0 token LLM): Tự điền phiên âm US/UK, loại từ, nghĩa Việt &amp; file phát âm ngay khi nhập từ.</div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold small">Bộ từ vựng (Topic) <span class="text-danger">*</span></label>
                                    <select id="wordTopicId" name="TopicId" class="form-select" required>
                                        <option value="">-- Chọn bộ từ vựng --</option>
                                        @foreach (var top in Model.Topics)
                                        {
                                            <option value="@top.TopicId">@top.Title (@top.CategoryName)</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold small">Loại từ</label>
                                    <select id="wordPos" name="PartOfSpeech" class="form-select">
                                        <option value="noun">Noun</option>
                                        <option value="verb">Verb</option>
                                        <option value="adjective">Adj</option>
                                        <option value="adverb">Adv</option>
                                        <option value="phrase">Phrase</option>
                                        <option value="preposition">Prep</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Nghĩa tiếng Việt <span class="text-danger">*</span></label>
                                    <input type="text" id="wordMeaning" name="Meaning" class="form-control fw-bold" placeholder="vd: sự bảo đảm, lời cam đoan..." required />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold small">Phiên âm US (Mỹ)</label>
                                    <input type="text" id="wordPhoneticUs" name="PhoneticUs" class="form-control font-monospace" placeholder="/əˈʃʊrəns/" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold small">Phiên âm UK (Anh)</label>
                                    <input type="text" id="wordPhoneticUk" name="PhoneticUk" class="form-control font-monospace" placeholder="/əˈʃʊərəns/" />
                                </div>

                                <!-- Audio Upload & TTS -->
                                <div class="col-12">
                                    <div class="card p-3 bg-light border">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                            <label class="form-label fw-semibold small mb-0">
                                                <i data-lucide="music" style="width: 15px; height: 15px;" class="me-1 text-primary"></i>Tệp âm thanh phát âm (Audio MP3 / TTS)
                                            </label>
                                            <div class="d-flex flex-wrap gap-2">
                                                <input type="file" id="wordAudioFileInput" accept=".mp3,.wav,.ogg,.m4a" class="d-none" onchange="uploadWordAudioFile(this)" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="document.getElementById('wordAudioFileInput').click()">
                                                    <i data-lucide="upload" style="width: 14px; height: 14px;" class="me-1"></i>Tải file MP3
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" id="btnGenerateTts" onclick="generateWordTts()">
                                                    <i data-lucide="audio-waveform" style="width: 14px; height: 14px;" class="me-1"></i>Tạo âm thanh TTS
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="playWordAudioUrl()">
                                                    <i data-lucide="play" style="width: 14px; height: 14px;" class="me-1"></i>Nghe thử Audio
                                                </button>
                                            </div>
                                        </div>
                                        <input type="text" id="wordAudioUrl" name="AudioUrl" class="form-control form-control-sm" placeholder="/uploads/vocab-audio/... hoặc https://...mp3" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Link hình ảnh minh họa</label>
                                    <input type="url" id="wordImageUrl" name="ImageUrl" class="form-control" placeholder="https://...jpg" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold small">Thứ tự</label>
                                    <input type="number" id="wordSortOrder" name="SortOrder" class="form-control" value="1" min="1" />
                                </div>

                                <div class="col-md-4 d-flex align-items-center pt-4">
                                    <div class="form-check form-switch form-check-switch">
                                        <input class="form-check-input" type="checkbox" id="wordIsActive" name="IsActive" checked />
                                        <label class="form-check-label fw-semibold small ms-1" for="wordIsActive">Hiển thị cho học viên</label>
                                    </div>
                                </div>

                                <!-- Xem nhanh thẻ Từ -->
                                <div class="col-12">
                                    <div class="p-3 rounded-3 bg-light border d-flex flex-wrap justify-content-between align-items-center gap-3">
                                        <div>
                                            <div class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Xem nhanh thẻ Từ</div>
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <span class="badge bg-secondary-subtle text-secondary" id="prevTermPos">noun</span>
                                                <span class="fw-bold fs-5 text-dark" id="prevTermWord">Headword</span>
                                                <span class="text-muted font-monospace small" id="prevTermPhonetics">/phonetics/</span>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="small text-muted">Nghĩa mặt sau</div>
                                            <div class="fw-bold text-primary" id="prevTermMeaning">Nghĩa tiếng Việt</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: BÀI HỌC (KIẾN THỨC & MẸO NHỚ) -->
                        <div class="tab-pane fade" id="tab-word-lesson" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="card border p-3 bg-light d-flex flex-wrap flex-row justify-content-between align-items-center gap-2">
                                        <div>
                                            <div class="fw-bold small text-dark">Tự động hóa Bài học (JSON Arrays -> Thẻ Tag)</div>
                                            <div id="lessonAiStatus" class="text-muted small">AI sinh định nghĩa Anh, Collocations, Synonyms, Antonyms, Word Family, Lỗi sai &amp; Mẹo nhớ để bạn bấm × chọn lọc.</div>
                                        </div>
                                        <button type="button" id="btnAiLesson" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" onclick="autoFillLessonByAi()">
                                            <i data-lucide="sparkles" style="width: 14px; height: 14px;" class="me-1"></i>Gợi ý Bài học bằng AI
                                        </button>
                                    </div>
                                </div>
                                <!-- CÁC TRƯỜNG ẨN ĐỒNG BỘ NÉT NGHĨA CHÍNH (TƯƠNG THÍCH HỆ THỐNG GỐC) -->
                                <input type="hidden" id="wordEnglishDefinition" name="EnglishDefinition" />
                                <input type="hidden" id="wordCollocations" name="Collocations" />
                                <input type="hidden" id="wordSynonyms" name="Synonyms" />
                                <input type="hidden" id="wordAntonyms" name="Antonyms" />
                                <input type="hidden" id="wordSensesJson" name="SensesJson" />

                                <!-- KHỐI THỐNG NHẤT: NÉT NGHĨA TỪ VỰNG (GỒM ĐỊNH NGHĨA, VÍ DỤ, CỤM TỪ, ĐỒNG/TRÁI NGHĨA) -->
                                <div class="col-12">
                                    <div class="card border border-fuchsia-200 rounded-4 shadow-sm bg-fuchsia-50/10">
                                        <div class="card-header bg-white py-3 px-3 border-bottom border-fuchsia-200 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div>
                                                <h6 class="fw-bold mb-0 text-slate-800 d-flex align-items-center gap-2">
                                                    <span class="badge rounded-circle p-1 d-inline-flex align-items-center justify-content-center text-white" style="width: 22px; height: 22px; background-color: #c026d3; font-size: 11px;">★</span>
                                                    <span>Nét nghĩa từ vựng (Định nghĩa · Ví dụ · Cụm từ · Đồng nghĩa · Trái nghĩa)</span>
                                                </h6>
                                                <small class="text-muted">Mỗi nét nghĩa bao gồm đầy đủ Định nghĩa tiếng Anh, Ví dụ bổ sung ngữ cảnh, Cụm từ đi kèm, Từ đồng nghĩa &amp; Từ trái nghĩa. Bạn có thể <strong>Thêm</strong>, <strong>Sửa</strong> hoặc <strong>Xóa</strong> từng nét nghĩa.</small>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-sm" onclick="addNewSenseModal()">
                                                <i data-lucide="plus" style="width: 14px; height: 14px;" class="me-1"></i>+ Thêm nét nghĩa
                                            </button>
                                        </div>
                                        <div class="card-body p-3">
                                            <!-- Container chứa danh sách các card nét nghĩa -->
                                            <div id="modalSensesContainer" class="d-flex flex-column gap-3"></div>

                                            <div class="mt-3 text-center">
                                                <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-sm" onclick="addNewSenseModal()">
                                                    <i data-lucide="plus-circle" style="width: 16px; height: 16px;"></i>
                                                    <span>+ Thêm nét nghĩa mới</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label fw-semibold small mb-0">
                                            <i data-lucide="layers" style="width: 14px; height: 14px;" class="me-1 text-primary"></i>Họ từ (Word Family)
                                        </label>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary py-0" onclick="insertFamilyTemplate('noun')">+ Noun</button>
                                            <button type="button" class="btn btn-outline-secondary py-0" onclick="insertFamilyTemplate('adjective')">+ Adj</button>
                                            <button type="button" class="btn btn-outline-secondary py-0" onclick="insertFamilyTemplate('adverb')">+ Adv</button>
                                        </div>
                                    </div>
                                    <textarea id="wordFamily" name="WordFamily" class="form-control font-monospace" rows="2" placeholder="assure · verb · cam đoan&#10;assured · adjective · tự tin"></textarea>
                                </div>

                                <div class="col-12">
                                    <div class="card p-3 border-warning-subtle bg-warning-subtle">
                                        <div class="fw-bold text-warning-emphasis small mb-2">
                                            <i data-lucide="alert-triangle" style="width: 15px; height: 15px;" class="me-1"></i>Lỗi thường gặp (Common Mistakes)
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label small text-danger fw-semibold">Cách dùng SAI ✕</label>
                                                <input type="text" id="wordCommonMistakeWrong" name="CommonMistakeWrong" class="form-control text-danger border-danger" placeholder="vd: make an assurance" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small text-success fw-semibold">Cách dùng ĐÚNG ✓</label>
                                                <input type="text" id="wordCommonMistakeRight" name="CommonMistakeRight" class="form-control text-success border-success" placeholder="vd: give an assurance" />
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small text-muted">Giải thích quy tắc</label>
                                                <textarea id="wordCommonMistakeNote" name="CommonMistakeNote" class="form-control" rows="2" placeholder="Giải thích ngắn gọn..."></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card p-3 border-primary-subtle bg-primary-subtle">
                                        <label class="form-label fw-bold text-primary small mb-1">
                                            <i data-lucide="lightbulb" style="width: 15px; height: 15px;" class="me-1"></i>Mẹo ghi nhớ / Nguồn gốc từ (Mnemonic)
                                        </label>
                                        <textarea id="wordMemoryTip" name="MemoryTip" class="form-control" rows="2" placeholder="vd: Gốc 'sure' = chắc chắn -> 'assurance' là mang lại sự chắc chắn."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 3: QUIZ -->
                        <div class="tab-pane fade" id="tab-word-quiz" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="card border p-3 bg-light">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="fw-bold small text-dark">Chế độ tạo đáp án nhiễu Quiz</span>
                                                    <span id="quizPoolStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle">CSDL nội bộ (0 token)</span>
                                                </div>
                                                <div id="quizAiStatus" class="text-muted small">Mặc định tự động bốc 3 từ cùng <strong>Loại từ</strong> &amp; cùng <strong>Chủ đề</strong>, loại bỏ từ đồng nghĩa (tức thì, 0 phí API).</div>
                                            </div>
                                            <div class="d-flex flex-wrap align-items-center gap-3">
                                                <button type="button" id="btnAiQuizTraps" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" onclick="suggestQuizTrapsByAi()">
                                                    <i data-lucide="sparkles" style="width: 14px; height: 14px;" class="me-1"></i>Gợi ý đáp án bẫy bằng AI
                                                </button>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" id="wordUseManualQuiz" name="UseManualQuiz" onchange="toggleManualQuizInputs()" />
                                                    <label class="form-check-label fw-bold text-primary small" for="wordUseManualQuiz">Ghi đè thủ công</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold small">Đáp án ĐÚNG (đồng bộ với Nghĩa tiếng Việt)</label>
                                    <input type="text" id="quizCorrectMeaningSync" class="form-control fw-bold border-success" placeholder="Nhập nghĩa tiếng Việt đúng cho câu hỏi Quiz..." />
                                </div>

                                <div class="col-12" id="manualQuizDistractorsBox" style="display: none;">
                                    <div class="card border-primary-subtle bg-primary-subtle p-3">
                                        <div class="fw-bold small text-primary mb-2">3 Đáp án nhiễu chủ đích</div>
                                        <div class="row g-2">
                                            <div class="col-md-4"><input type="text" id="wordDistractor1" class="form-control form-control-sm" placeholder="Đáp án nhiễu 1..." oninput="updateLiveModalPreview()" /></div>
                                            <div class="col-md-4"><input type="text" id="wordDistractor2" class="form-control form-control-sm" placeholder="Đáp án nhiễu 2..." oninput="updateLiveModalPreview()" /></div>
                                            <div class="col-md-4"><input type="text" id="wordDistractor3" class="form-control form-control-sm" placeholder="Đáp án nhiễu 3..." oninput="updateLiveModalPreview()" /></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card border-0 bg-light p-3" style="border-radius: 14px;">
                                        <div class="small text-uppercase text-muted fw-bold mb-1" style="font-size: 0.7rem;">Xem trước câu hỏi Quiz A / B / C / D</div>
                                        <div class="fw-bold fs-5 text-dark mb-3" id="quizPreviewPrompt">Nghĩa đúng của "Headword" là gì?</div>
                                        <div class="row g-2" id="quizPreviewOptions"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 4: GÕ -->
                        <div class="tab-pane fade" id="tab-word-typing" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12" id="typingMatchAlert"></div>

                                <div class="col-12">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                                        <label class="form-label fw-semibold small mb-0">Câu ví dụ tiếng Anh (bọc từ cần điền bằng <code>[...]</code>)</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" id="btnAiTyping" class="btn btn-sm btn-primary py-0 px-3 rounded-pill fw-semibold" onclick="autoFillTypingByAi()">
                                                <i data-lucide="sparkles" style="width: 13px; height: 13px;" class="me-1"></i>Sinh câu ví dụ TOEIC &amp; dịch bằng AI
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" onclick="wrapSelectedTypingBlank()">
                                                <i data-lucide="brackets" style="width: 13px; height: 13px;" class="me-1"></i>Đặt làm ô trống
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="applySampleTypingSentence()">
                                                <i data-lucide="file-text" style="width: 13px; height: 13px;" class="me-1"></i>Mẫu nhanh
                                            </button>
                                        </div>
                                    </div>
                                    <textarea id="wordExampleSentence" name="ExampleSentence" class="form-control" rows="2" placeholder="vd: The supplier gave us an [assurance] that goods will arrive on time."></textarea>
                                    <div id="typingAiStatus" class="form-text small text-muted">Bấm <strong>Sinh câu ví dụ TOEIC &amp; dịch bằng AI</strong> để tạo câu ngữ cảnh công sở có sẵn <code>[từ_gốc]</code> và bản dịch Việt, hoặc bôi đen từ rồi bấm <strong>Đặt làm ô trống</strong>.</div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold small">Dịch nghĩa tiếng Việt của câu ví dụ</label>
                                    <textarea id="wordExampleMeaning" name="ExampleMeaning" class="form-control" rows="2" placeholder="vd: Nhà cung cấp cam đoan hàng sẽ đến đúng hạn."></textarea>
                                </div>

                                <div class="col-12">
                                    <div class="card border-0 bg-light p-3" style="border-radius: 14px;">
                                        <div class="small text-uppercase text-muted fw-bold mb-2" style="font-size: 0.7rem;">Xem trước bài tập Gõ điền từ</div>
                                        <div class="fs-5 text-dark mb-2" id="typingPreviewSentence">...</div>
                                        <div class="small text-muted" id="typingPreviewTranslation">Gợi ý: ...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary rounded-pill px-3" onclick="nextModalTab()">
                        <span>Tiếp tục</span> <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="saveWord()">
                        <i data-lucide="save" style="width: 16px; height: 16px;" class="me-1"></i> Lưu Từ Vựng
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODAL THÊM / SỬA BỘ TỪ (TOPIC) ==================== -->
<div class="modal fade" id="modalTopic" tabindex="-1" aria-labelledby="modalTopicTitle" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <h5 class="modal-title fw-bold" id="modalTopicTitle">Thêm Bộ Từ Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form id="formTopic">
                    <input type="hidden" id="topicId" name="TopicId" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nhóm bộ từ cha <span class="text-danger">*</span></label>
                        <select id="topicCategoryId" name="CategoryId" class="form-select" required>
                            <option value="">-- Chọn nhóm bộ từ --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tiêu đề Bộ từ <span class="text-danger">*</span></label>
                        <input type="text" id="topicTitle" name="Title" class="form-control fw-bold" placeholder="vd: Contracts, Marketing, Warranties..." required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Cấp độ / Kỳ thi</label>
                            <select id="topicLevel" name="Level" class="form-select">
                                <option value="A1">A1 - Cơ bản</option>
                                <option value="A2">A2 - Sơ cấp</option>
                                <option value="B1" selected>B1 - Trung cấp</option>
                                <option value="B2">B2 - Khá</option>
                                <option value="C1">C1 - Cao cấp</option>
                                <option value="TOEIC">TOEIC</option>
                                <option value="IELTS">IELTS</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Mã Code (tùy chọn)</label>
                            <input type="text" id="topicCode" name="Code" class="form-control" placeholder="vd: contracts, travel..." />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Tông màu sắc</label>
                            <select id="topicColor" name="Color" class="form-select">
                                <option value="">-- Kế thừa từ nhóm cha --</option>
                                <option value="fuchsia">Fuchsia (Tím hồng)</option>
                                <option value="amber">Amber (Cam / Hổ phách)</option>
                                <option value="emerald">Emerald (Xanh lục)</option>
                                <option value="rose">Rose (Đỏ hồng)</option>
                                <option value="cyan">Cyan (Xanh ngọc)</option>
                                <option value="indigo">Indigo (Chàm tím)</option>
                                <option value="primary">Primary (Xanh dương)</option>
                                <option value="purple">Purple (Tím đậm)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Biểu tượng (Icon)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light d-flex align-items-center justify-content-center" id="topicIconPreviewWrapper" style="width: 44px;">
                                    <i id="topicIconPreview" data-lucide="book-open" style="width: 18px; height: 18px;"></i>
                                </span>
                                <select id="topicIcon" name="Icon" class="form-select" onchange="updateTopicIconPreview(this.value)">
                                    <option value="book-open">book-open (Mặc định)</option>
                                    <option value="book">book</option>
                                    <option value="layers">layers</option>
                                    <option value="folder">folder</option>
                                    <option value="file-text">file-text</option>
                                    <option value="briefcase">briefcase</option>
                                    <option value="graduation-cap">graduation-cap</option>
                                    <option value="award">award</option>
                                    <option value="globe">globe</option>
                                    <option value="message-square">message-square</option>
                                    <option value="headphones">headphones</option>
                                    <option value="mic">mic</option>
                                    <option value="sparkles">sparkles</option>
                                    <option value="flame">flame</option>
                                    <option value="heart">heart</option>
                                    <option value="coffee">coffee</option>
                                    <option value="plane">plane</option>
                                    <option value="shopping-bag">shopping-bag</option>
                                    <option value="landmark">landmark</option>
                                    <option value="trending-up">trending-up</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mô tả chi tiết</label>
                        <textarea id="topicDesc" name="Description" class="form-control" rows="2" placeholder="Nội dung tóm tắt chủ đề bài học..."></textarea>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Thứ tự</label>
                            <input type="number" id="topicSortOrder" name="SortOrder" class="form-control" value="1" min="1" />
                        </div>
                        <div class="col-6 d-flex align-items-center pt-4">
                            <div class="form-check form-switch form-check-switch">
                                <input class="form-check-input" type="checkbox" id="topicIsActive" name="IsActive" checked />
                                <label class="form-check-label fw-semibold small ms-1" for="topicIsActive">Kích hoạt</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="saveTopic()">
                    <i data-lucide="save" style="width: 16px; height: 16px;" class="me-1"></i> Lưu Bộ Từ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODAL THÊM / SỬA NHÓM BỘ TỪ ==================== -->
