    function formatAiSourceLabel(source) {
        if (!source) return 'Thông minh';
        if (source === 'llm-gemini') return 'AI Gemini';
        if (source === 'llm-openai') return 'AI OpenAI';
        if (source === 'dictionary+llm-gemini') return 'Từ điển + AI Gemini';
        if (source === 'dictionary+llm-openai') return 'Từ điển + AI OpenAI';
        if (source === 'database-cache' || source === 'DatabaseCache') return 'CSDL nội bộ (0 token)';
        if (source === 'database+dictionary-api') return 'CSDL + Dictionary API (0 token)';
        if (source === 'dictionary-api' || source === 'DictionaryAPI') return 'Dictionary API & Dịch máy (0 token)';
        if (source.includes('no-api-key')) return source.replace(/\s*\(no-api-key\)/, '') + ' · chưa cấu hình AI key';
        return source;
    }

    function getSelectedModalTopicTitle() {
