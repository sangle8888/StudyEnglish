    function insertTextToInput(elementId, text) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const start = el.selectionStart || el.value.length;
        const end = el.selectionEnd || el.value.length;
        const before = el.value.substring(0, start);
        const after = el.value.substring(end);
        el.value = before + text + after;
        el.focus();
        el.selectionStart = el.selectionEnd = start + text.length;
        updateLiveModalPreview();
    }

    function insertFamilyTemplate(pos) {
        const currentWord = document.getElementById('wordText').value.trim() || 'word';
        let sample = '';
        if (pos === 'noun') sample = `\n${currentWord} · noun · nghĩa danh từ`;
        else if (pos === 'adjective') sample = `\n${currentWord}al · adjective · nghĩa tính từ`;
        else if (pos === 'adverb') sample = `\n${currentWord}ly · adverb · nghĩa trạng từ`;
        else sample = `\n${currentWord} · ${pos} · nghĩa`;

        const el = document.getElementById('wordFamily');
        if (el.value.trim().length === 0) {
            sample = sample.trimStart();
        }
        insertTextToInput('wordFamily', sample);
    }

    function wrapSelectedTypingBlank() {
        const el = document.getElementById('wordExampleSentence');
        if (!el) return;
        let text = el.value;
        const start = el.selectionStart ?? 0;
        const end = el.selectionEnd ?? 0;

        if (end > start) {
            const selected = text.substring(start, end).trim().replace(/^\[|\]$/g, '');
            if (!selected) return;
            const before = text.substring(0, start).replace(/\[([^\[\]]+)\]/g, '$1');
            const after = text.substring(end).replace(/\[([^\[\]]+)\]/g, '$1');
            el.value = `${before}[${selected}]${after}`;
            showToast(`Đã đánh dấu [${selected}] làm ô trống!`, 'success');
            updateLiveModalPreview();
            return;
        }

        const word = document.getElementById('wordText').value.trim();
        if (!word) {
            showToast('Hãy bôi đen từ cần điền trong câu ví dụ rồi bấm "Đặt làm ô trống".', 'warning');
            return;
        }
        const stripped = text.replace(/\[([^\[\]]+)\]/g, '$1');
        const re = new RegExp(`\\b(${escapeRegexModal(word)}[a-z]*)\\b`, 'i');
        if (re.test(stripped)) {
            el.value = stripped.replace(re, '[$1]');
            showToast('Đã tự động bọc [...] quanh từ cần điền!', 'success');
        } else {
            showToast('Không tìm thấy từ trong câu. Hãy bôi đen trực tiếp từ cần điền rồi bấm nút này.', 'warning');
        }
        updateLiveModalPreview();
    }

