        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ',') {
                e.preventDefault();
                addTagToHidden(hiddenId, input.value);
                input.value = '';
            }
        });
        input.addEventListener('blur', () => {
            if (input.value.trim()) {
                addTagToHidden(hiddenId, input.value);
                input.value = '';
            }
        });
    });

