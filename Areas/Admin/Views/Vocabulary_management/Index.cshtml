    async function autoFillWordFromApi(silent = false) {
        const word = document.getElementById('wordText').value.trim();
        if (!word) {
            if (!silent) showToast('Nhập từ tiếng Anh trước khi bấm Gợi ý tự động.', 'warning');
            return;
        }
        const btn = document.getElementById('btnAutoFillWord');
        const statusEl = document.getElementById('autoFillStatus');
        if (btn) btn.disabled = true;
        if (statusEl) statusEl.innerText = 'Đang tra cứu từ điển chuẩn US/UK & nghĩa...';

        const posEl = document.getElementById('wordPos');
        const queryPos = (!silent && posEl && posEl.value) ? `&pos=${encodeURIComponent(posEl.value)}` : '';

        try {
            const res = await fetch(`/Admin/Vocabulary_management/AutoFillWord?word=${encodeURIComponent(word)}${queryPos}`);
            const json = await res.json();
            if (!json.success) {
                if (!silent) showToast(json.message || 'Không tra được từ điển.', 'warning');
                return;
            }
            const d = json.data;
            const hasExistingCore = Boolean(
                document.getElementById('wordMeaning').value.trim() ||
                document.getElementById('wordPhoneticUs').value.trim()
            );
            const overwriteCore = !silent && hasExistingCore && confirm('Các ô Phần 1 đã có dữ liệu. Bấm OK để cập nhật lại theo từ loại đang chọn, hoặc Cancel để chỉ điền các ô còn trống.');

            if (d.partOfSpeech && (silent || overwriteCore || !posEl.value)) {
                if ([...posEl.options].some(o => o.value === d.partOfSpeech)) posEl.value = d.partOfSpeech;
            }
            if (d.phoneticUs && (overwriteCore || !document.getElementById('wordPhoneticUs').value.trim())) document.getElementById('wordPhoneticUs').value = d.phoneticUs;
            if (d.phoneticUk && (overwriteCore || !document.getElementById('wordPhoneticUk').value.trim())) document.getElementById('wordPhoneticUk').value = d.phoneticUk;
            if (d.meaning && (overwriteCore || !document.getElementById('wordMeaning').value.trim())) document.getElementById('wordMeaning').value = d.meaning;
            if (d.englishDefinition && (overwriteCore || !document.getElementById('wordEnglishDefinition').value.trim())) document.getElementById('wordEnglishDefinition').value = d.englishDefinition;
            if (d.audioUrl && (overwriteCore || !document.getElementById('wordAudioUrl').value.trim())) document.getElementById('wordAudioUrl').value = d.audioUrl;

            if (statusEl) {
                statusEl.innerHTML = `<span class="text-success fw-semibold">✓ Đã điền Phần 1 từ ${escapeHtmlModal(formatAiSourceLabel(json.source || d.source))}.</span>`;
            }
            updateLiveModalPreview();
            fetchDbQuizPreview(true);
        } catch {
            if (statusEl) statusEl.innerText = 'Không kết nối được máy chủ tra cứu từ điển.';
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    async function autoFillLessonByAi() {
        const word = document.getElementById('wordText').value.trim();
        if (!word) {
            showToast('Vui lòng nhập Từ tiếng Anh (Headword) ở Tab 1 trước.', 'warning');
            switchModalWordTab('tab-word-core-tab');
            return;
        }
        const hasExistingLesson = Boolean(
            document.getElementById('wordEnglishDefinition').value.trim() ||
            document.getElementById('wordFamily').value.trim() ||
            document.getElementById('wordMemoryTip').value.trim()
        );
        const replaceExisting = hasExistingLesson
            ? confirm('Tab Bài học đã có dữ liệu. Bấm OK để GHI ĐÈ bằng gợi ý mới theo Từ loại/Nghĩa hiện tại, hoặc Cancel để chỉ điền bổ sung các ô đang trống.')
            : false;

        const btn = document.getElementById('btnAiLesson');
        const statusEl = document.getElementById('lessonAiStatus');
        if (btn) btn.disabled = true;
        if (statusEl) statusEl.innerText = 'AI đang tạo định nghĩa, Collocations, Synonyms, Word Family & Mẹo nhớ...';

        try {
            const res = await fetch('/Admin/Vocabulary_management/AutoFillLessonByAi', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({
                    Word: word,
                    PartOfSpeech: document.getElementById('wordPos').value,
                    Meaning: document.getElementById('wordMeaning').value.trim(),
                    TopicId: parseInt(document.getElementById('wordTopicId').value) || 0,
                    TopicTitle: getSelectedModalTopicTitle()
                })
            });
            const json = await res.json();
            if (!json.success) {
                showToast(json.message || 'Không tạo được gợi ý bài học.', 'warning');
                return;
            }
            const d = json.data;
            if (!modalSensesData || modalSensesData.length === 0) {
                modalSensesData = [{ partOfSpeech: document.getElementById('wordPos').value, meaning: document.getElementById('wordMeaning').value.trim(), englishDefinition: '', examples: [], collocations: '', synonyms: '', antonyms: '' }];
            }
            const s1 = modalSensesData[0];
            if (d.englishDefinition && (replaceExisting || !s1.englishDefinition)) {
                s1.englishDefinition = d.englishDefinition;
            }
            if (Array.isArray(d.extraExamples) && d.extraExamples.length) {
                if (!s1.examples) s1.examples = [];
                for (const ex of d.extraExamples) {
                    const en = String(ex?.en || '').replace(/\r?\n+/g, ' ').trim();
                    const vi = String(ex?.vi || '').replace(/\r?\n+/g, ' ').trim();
                    if (!en) continue;
                    if (!s1.examples.some(x => x.en.toLowerCase() === en.toLowerCase())) {
                        s1.examples.push({ en, vi });
                    }
                }
            }
            if (Array.isArray(d.collocations) && d.collocations.length) {
                const addStr = d.collocations.join('; ');
                s1.collocations = s1.collocations ? (s1.collocations + '; ' + addStr) : addStr;
            }
            if (Array.isArray(d.synonyms) && d.synonyms.length) {
                const addStr = d.synonyms.join(', ');
                s1.synonyms = s1.synonyms ? (s1.synonyms + ', ' + addStr) : addStr;
            }
            if (Array.isArray(d.antonyms) && d.antonyms.length) {
                const addStr = d.antonyms.join(', ');
                s1.antonyms = s1.antonyms ? (s1.antonyms + ', ' + addStr) : addStr;
            }
            renderModalSensesUI();

            if (Array.isArray(d.wordFamily) && d.wordFamily.length && (replaceExisting || !document.getElementById('wordFamily').value.trim())) {
                document.getElementById('wordFamily').value = d.wordFamily.join('\n');
            }
            if (d.commonMistakeWrong && (replaceExisting || !document.getElementById('wordCommonMistakeWrong').value.trim())) {
                document.getElementById('wordCommonMistakeWrong').value = d.commonMistakeWrong;
            }
            if (d.commonMistakeRight && (replaceExisting || !document.getElementById('wordCommonMistakeRight').value.trim())) {
                document.getElementById('wordCommonMistakeRight').value = d.commonMistakeRight;
            }
            if (d.commonMistakeNote && (replaceExisting || !document.getElementById('wordCommonMistakeNote').value.trim())) {
                document.getElementById('wordCommonMistakeNote').value = d.commonMistakeNote;
            }
            if (d.memoryTip && (replaceExisting || !document.getElementById('wordMemoryTip').value.trim())) {
                document.getElementById('wordMemoryTip').value = d.memoryTip;
            }

            if (statusEl) {
                statusEl.innerHTML = `<span class="text-success fw-semibold">✓ Đã nạp dữ liệu Bài học (${escapeHtmlModal(formatAiSourceLabel(json.source || d.source))}). Bạn có thể bấm × trên từng thẻ tag để lọc bớt.</span>`;
            }
            updateLiveModalPreview();
        } catch {
            if (statusEl) statusEl.innerText = 'Lỗi kết nối khi gợi ý bài học.';
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    function fetchDbQuizPreview(immediate = false) {
        if (dbQuizPreviewTimer) clearTimeout(dbQuizPreviewTimer);
        const run = async () => {
            const wordId = parseInt(document.getElementById('wordId').value) || 0;
            const topicId = parseInt(document.getElementById('wordTopicId').value) || 0;
            const pos = document.getElementById('wordPos').value || '';
            const meaning = document.getElementById('wordMeaning').value.trim() || '';
            try {
                const url = `/Admin/Vocabulary_management/PreviewAutoQuizDistractors?wordId=${wordId}&topicId=${topicId}&pos=${encodeURIComponent(pos)}&meaning=${encodeURIComponent(meaning)}`;
                const res = await fetch(url);
                const json = await res.json();
                if (json.success && json.data) {
                    cachedDbQuizPreview = json.data;
                    const badge = document.getElementById('quizPoolStatusBadge');
                    const statusEl = document.getElementById('quizAiStatus');
                    const isManual = document.getElementById('wordUseManualQuiz')?.checked;
                    if (badge) {
                        if (isManual) {
                            badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle';
                            badge.innerText = 'Ghi đè thủ công / AI Traps';
                        } else if (json.data.isLowTopicPool) {
                            badge.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                            badge.innerText = `CSDL mở rộng (Topic chỉ có ${json.data.sameTopicCount} từ khác)`;
                        } else {
                            badge.className = 'badge bg-success-subtle text-success border border-success-subtle';
                            badge.innerText = `CSDL nội bộ · ${json.data.sameTopicPosCount} từ cùng POS/Topic (0 token)`;
                        }
                    }
                    if (statusEl && !isManual && json.data.isLowTopicPool) {
                        statusEl.innerHTML = `<span class="text-warning-emphasis fw-semibold">Chủ đề hiện tại chưa đủ 4 từ. Hệ thống đang mở rộng CSDL cùng loại từ — bạn có thể bấm <strong>Gợi ý đáp án bẫy bằng AI</strong> để tạo câu hỏi bẫy sắc bén hơn.</span>`;
                    }
                    updateLiveModalPreview();
                }
            } catch { /* Silent */ }
        };
        if (immediate) run();
        else dbQuizPreviewTimer = setTimeout(run, 300);
    }

