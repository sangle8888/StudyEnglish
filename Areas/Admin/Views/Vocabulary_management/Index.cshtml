    // ===== NHẬP HÀNG LOẠT EXCEL/CSV & KIỂM TRA LỖI TRƯỚC KHI LƯU =====
    function openBulkImportModal() {
        document.getElementById('formBulk').reset();
        const wrap = document.getElementById('bulkPreviewWrap');
        if (wrap) wrap.style.display = 'none';
        new bootstrap.Modal(document.getElementById('modalBulk')).show();
        if (window.lucide) lucide.createIcons();
    }

    function handleBulkCsvUpload(input) {
        const file = input?.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            document.getElementById('bulkRawData').value = e.target?.result || '';
            previewBulkImport();
        };
        reader.readAsText(file, 'UTF-8');
    }

    async function previewBulkImport() {
        const topicId = parseInt(document.getElementById('bulkTopicId').value) || 0;
        const rawData = document.getElementById('bulkRawData').value.trim();

        if (topicId <= 0) {
            showToast('Vui lòng chọn Bộ từ đích trước khi kiểm tra.', 'warning');
            return;
        }
        if (!rawData) {
            showToast('Vui lòng chọn tệp CSV hoặc dán dữ liệu trước khi kiểm tra.', 'warning');
            return;
        }
        try {
            const res = await fetch('/Admin/Vocabulary_management/PreviewBulkImport', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({ TopicId: topicId, RawData: rawData })
            });
            const json = await res.json();
            if (!json.success) {
                showToast(json.message || 'Không phân tích được dữ liệu.', 'danger');
                return;
            }
            const wrap = document.getElementById('bulkPreviewWrap');
            const summary = document.getElementById('bulkPreviewSummary');
            const tbody = document.getElementById('bulkPreviewBody');
            wrap.style.display = 'block';
            summary.innerHTML = `Tổng ${json.totalRows} dòng (${escapeHtmlModal(json.topicTitle)}): <span class="text-success">${json.validCount} hợp lệ</span> · <span class="text-warning">${json.warningCount} cảnh báo</span> · <span class="text-danger">${json.errorCount} lỗi (sẽ bỏ qua)</span>`;
            tbody.innerHTML = (json.rows || []).map(r => {
                const badgeClass = r.status === 'error'
                    ? 'bg-danger-subtle text-danger'
                    : (r.status === 'warning' ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success');
                const statusText = (r.issues && r.issues.length) ? r.issues.join('; ') : 'Hợp lệ ✓';
                return `
                    <tr class="${r.status === 'error' ? 'table-danger' : ''}">
                        <td>${r.rowNumber}</td>
                        <td class="fw-bold">${escapeHtmlModal(r.word || '(trống)')}</td>
                        <td>${escapeHtmlModal(r.partOfSpeech || 'noun')}</td>
                        <td>${escapeHtmlModal(r.meaning || '(trống)')}</td>
                        <td>${escapeHtmlModal(r.exampleSentence || '-')}</td>
                        <td><span class="badge ${badgeClass}">${escapeHtmlModal(statusText)}</span></td>
                    </tr>`;
            }).join('');
        } catch {
            showToast('Lỗi kết nối khi kiểm tra CSV.', 'danger');
        }
    }

    async function commitBulkImport() {
        const topicId = parseInt(document.getElementById('bulkTopicId').value) || 0;
        const rawData = document.getElementById('bulkRawData').value.trim();

        if (topicId <= 0) {
            showToast('Vui lòng chọn Bộ từ đích để nhập dữ liệu.', 'warning');
            return;
        }
        if (!rawData) {
            showToast('Vui lòng dán dữ liệu từ vựng hoặc chọn tệp CSV.', 'warning');
            return;
        }

        try {
            const res = await fetch('/Admin/Vocabulary_management/CommitBulkImport', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({ TopicId: topicId, RawData: rawData })
            });
            const json = await res.json();
            if (json.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalBulk'))?.hide();
                showToast(json.message || 'Nhập hàng loạt thành công!');
                setTimeout(() => location.reload(), 900);
            } else {
                showToast(json.message || 'Lỗi nhập dữ liệu.', 'danger');
            }
        } catch {
            showToast('Lỗi máy chủ khi nhập dữ liệu.', 'danger');
        }
    }
</script>
