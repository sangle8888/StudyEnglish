    async function autoGenerateExtraExamples() {
        const word = document.getElementById('wordText').value.trim();
        if (!word) {
            showToast('Vui lòng nhập Từ tiếng Anh (Headword) ở Tab 1 trước.', 'warning');
            switchModalWordTab('tab-word-core-tab');
            return;
        }
        const btn = document.getElementById('btnAutoGenExtraExamples');
        const statusEl = document.getElementById('extraExAiStatus');
        if (btn) btn.disabled = true;
        if (statusEl) statusEl.innerText = 'Đang tự sinh câu ví dụ ngữ cảnh & bản dịch tiếng Việt...';

        const existingList = [];
        const primary = (document.getElementById('wordExampleSentence').value || '').trim();
        if (primary) existingList.push(primary);
        for (const item of extraExamplesList) {
            if (item.en) existingList.push(item.en);
        }

        try {
            const res = await fetch('/Admin/Vocabulary_management/SuggestExtraExamplesByAi', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({
                    Word: word,
                    PartOfSpeech: document.getElementById('wordPos').value,
                    Meaning: document.getElementById('wordMeaning').value.trim(),
                    TopicId: parseInt(document.getElementById('wordTopicId').value) || 0,
                    TopicTitle: getSelectedModalTopicTitle(),
                    ExistingExamples: existingList
                })
            });
            const json = await res.json();
            if (!json.success) {
                showToast(json.message || 'Không tự sinh được ví dụ.', 'warning');
                return;
            }
            const items = json.data?.examples || [];
            let addedCount = 0;
            const primaryNorm = primary.replace(/\[([^\[\]]+)\]/g, '$1').trim().toLowerCase();
            for (const ex of items) {
                const en = String(ex?.en || '').replace(/\r?\n+/g, ' ').trim();
                const vi = String(ex?.vi || '').replace(/\r?\n+/g, ' ').trim();
                if (!en) continue;
                const enNorm = en.replace(/\[([^\[\]]+)\]/g, '$1').toLowerCase();
                if (enNorm === primaryNorm) continue;
                if (!extraExamplesList.some(x => x.en.replace(/\[([^\[\]]+)\]/g, '$1').toLowerCase() === enNorm)) {
                    extraExamplesList.push({ en, vi });
                    addedCount++;
                }
            }
            renderExtraExamplesUI();
            if (statusEl) {
                statusEl.innerHTML = addedCount > 0
                    ? `<span class="text-success fw-semibold">✓ Đã thêm ${addedCount} ví dụ mới (${escapeHtmlModal(formatAiSourceLabel(json.source || json.data?.source))}). Bạn có thể bấm vào thẻ để sửa hoặc bấm tiếp <strong>Tự sinh ví dụ</strong>.</span>`
                    : `<span class="text-muted">Các ví dụ gợi ý đều đã có trong danh sách hiện tại.</span>`;
            }
        } catch {
            if (statusEl) statusEl.innerText = 'Lỗi kết nối khi tự sinh ví dụ.';
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    ['wordCollocations', 'wordSynonyms', 'wordAntonyms'].forEach(hiddenId => {
        const input = document.querySelector(`[data-tag-input="${hiddenId}"]`);
