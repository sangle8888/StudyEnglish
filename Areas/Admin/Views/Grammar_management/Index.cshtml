@model GrammarIndexViewModel
@{
    ViewData["Title"] = "Quản lý Ngữ pháp";
}

@section Styles {
<style>
    .admin-filter-bar .input-group-search {
        display: flex;
        align-items: center;
        background: var(--hr-surface, #fff);
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        border-radius: 12px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        height: 42px;
        overflow: hidden;
    }
    .admin-filter-bar .input-group-search:focus-within {
        border-color: var(--hr-primary, #4f46e5);
        box-shadow: var(--hr-ring, 0 0 0 4px rgba(79, 70, 229, 0.22));
    }
    .admin-filter-bar .input-group-search .search-icon {
        padding: 0 10px 0 14px;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .admin-filter-bar .input-group-search input.form-control {
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
        padding-left: 0 !important;
        height: 100% !important;
        font-size: 0.92rem;
    }
    .admin-filter-bar .form-select {
        height: 42px;
        border-radius: 12px;
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        font-size: 0.92rem;
    }
    .admin-filter-bar .btn-filter-reset {
        height: 42px;
        border-radius: 12px;
        border: 1.5px solid var(--hr-line-2, #d1d5db);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .admin-filter-bar .btn-filter-reset:not(.w-100) {
        width: 42px;
        padding: 0;
    }

    /* Styles tương thích cả Light Mode & Dark Mode */
    .category-title-link {
        color: #1e293b;
        transition: color 0.15s ease;
    }
    .category-title-link:hover {
        color: var(--hr-primary, #4f46e5);
    }
    .custom-count-badge {
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
    }
    .topic-icon-box {
        background-color: #eef2ff;
        color: #4f46e5;
        border: 1px solid #e0e7ff;
    }

    [data-bs-theme="dark"] .card-header {
        background-color: var(--hr-surface-2, #242247) !important;
        border-bottom-color: var(--hr-line, #2d2a52) !important;
        color: var(--hr-ink, #f2f0fb) !important;
    }
    [data-bs-theme="dark"] .table thead,
    [data-bs-theme="dark"] .table thead th {
        background-color: var(--hr-surface-2, #242247) !important;
        color: var(--hr-ink, #f2f0fb) !important;
        border-bottom-color: var(--hr-line, #2d2a52) !important;
    }
    [data-bs-theme="dark"] .table > :not(caption) > * > * {
        background-color: transparent;
        color: var(--hr-ink, #f2f0fb);
        border-bottom-color: var(--hr-line, #2d2a52);
    }
    [data-bs-theme="dark"] .table-hover > tbody > tr:hover > * {
        background-color: rgba(143, 136, 255, 0.08) !important;
        color: var(--hr-ink, #f2f0fb);
    }
    [data-bs-theme="dark"] .category-title-link,
    [data-bs-theme="dark"] .topic-title-text {
        color: var(--hr-ink, #f2f0fb) !important;
    }
    [data-bs-theme="dark"] .category-title-link:hover {
        color: var(--hr-primary, #8f88ff) !important;
    }
    [data-bs-theme="dark"] .topic-filter-panel {
        background-color: var(--hr-surface, #1b1a37) !important;
        border-bottom-color: var(--hr-line, #2d2a52) !important;
    }
    [data-bs-theme="dark"] .filter-counter-text {
        color: var(--hr-muted, #aaa6cb) !important;
    }
    [data-bs-theme="dark"] .custom-count-badge {
        background-color: var(--hr-surface-2, #242247) !important;
        color: var(--hr-ink-2, #d6d2f0) !important;
        border-color: var(--hr-line-2, #3c3968) !important;
    }
    [data-bs-theme="dark"] .topic-icon-box {
        background-color: rgba(143, 136, 255, 0.16) !important;
        border-color: rgba(143, 136, 255, 0.28) !important;
        color: var(--hr-primary, #8f88ff) !important;
    }
    [data-bs-theme="dark"] .topic-stt,
    [data-bs-theme="dark"] .category-stt {
        color: var(--hr-muted, #aaa6cb) !important;
    }
    [data-bs-theme="dark"] .table-active {
        --bs-table-active-bg: rgba(143, 136, 255, 0.15);
        --bs-table-active-color: var(--hr-ink, #f2f0fb);
    }
    .modal-preview-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
    }
    [data-bs-theme="dark"] .modal-preview-box {
        background-color: var(--hr-surface-2, #242247) !important;
        border-color: var(--hr-line-2, #3c3968) !important;
    }
</style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Quản lý Ngữ pháp</h1>
        <p class="text-muted small mb-0">Quản lý cấu trúc danh mục, chủ đề ngữ pháp và hệ thống câu hỏi luyện tập.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Reports">
            <i data-lucide="flag" class="me-1"></i>Báo lỗi câu hỏi
            @if (Model.OpenReports > 0)
            {
                <span class="badge text-bg-danger ms-1">@Model.OpenReports</span>
            }
        </a>
        <a class="btn btn-outline-primary" asp-action="CreateCategory">
            <i data-lucide="plus" class="me-1"></i>Nhóm chủ đề
        </a>
        <a class="btn btn-primary" asp-action="CreateTopic" asp-route-categoryId="@Model.SelectedCategoryId">
            <i data-lucide="plus" class="me-1"></i>Chủ đề
        </a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-lucide="check-circle" class="me-2 text-success"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div id="indexAlertContainer"></div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Nhóm chủ đề</div>
                <div class="display-6 fw-bold text-primary">@Model.Categories.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Chủ đề</div>
                <div class="display-6 fw-bold text-success">@Model.TotalTopics</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Câu hỏi</div>
                <div class="display-6 fw-bold text-info">@Model.TotalQuestions</div>
            </div>
        </div>
    </div>
</div>

<!-- [BẢNG 1] NHÓM CHỦ ĐỀ -->
<div class="card shadow-sm mb-4">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-primary"><i data-lucide="layers" class="me-1"></i>Nhóm chủ đề</span>
                <span id="categoryCountBadge" class="badge custom-count-badge">@Model.Categories.Count nhóm</span>
            </div>
            <!-- Bộ lọc tìm kiếm nhóm chủ đề -->
            <div class="d-flex align-items-center gap-2 flex-nowrap ms-auto admin-filter-bar">
                <div class="input-group-search" style="width: 260px;">
                    <span class="search-icon"><i data-lucide="search"></i></span>
                    <input type="text" id="categorySearchInput" class="form-control" placeholder="Tìm kiếm nhóm chủ đề..." />
                </div>
                <select id="categoryStatusFilter" class="form-select" style="width: 170px; flex-shrink: 0;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Hiển thị</option>
                    <option value="inactive">Ẩn</option>
                </select>
                <button type="button" id="btnResetCategoryFilter" class="btn btn-outline-secondary btn-filter-reset flex-shrink-0" title="Đặt lại bộ lọc nhóm">
                    <i data-lucide="rotate-ccw"></i>
                </button>
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="categoryTable">
            <thead>
                <tr>
                    <th style="width: 60px;" class="text-center">STT</th>
                    <th>Tiêu đề</th>
                    <th class="text-center" style="width: 130px;">Số chủ đề</th>
                    <th style="width: 130px;">Trạng thái</th>
                    <th class="text-end text-nowrap" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int catStt = 1; }
                @foreach (var c in Model.Categories)
                {
                    <tr class="category-row @(Model.SelectedCategoryId == c.Id ? "table-active" : "")"
                        data-id="@c.Id"
                        data-title="@c.Title.ToLower()"
                        data-status="@(c.IsActive ? "active" : "inactive")">
                        <td class="category-stt text-center fw-semibold">@(catStt++)</td>
                        <td>
                            <a asp-action="Index" asp-route-categoryId="@(Model.SelectedCategoryId == c.Id ? null : c.Id)" class="category-title-link fw-semibold text-decoration-none" title="@(Model.SelectedCategoryId == c.Id ? "Bỏ lọc theo nhóm này" : "Lọc các chủ đề thuộc nhóm này")">
                                @c.Title
                            </a>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill custom-count-badge">@c.TopicCount chủ đề</span>
                        </td>
                        <td class="category-status-cell">
                            @if (c.IsActive)
                            {
                                <span class="badge text-bg-success">Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Ẩn</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex align-items-center justify-content-end" style="gap: 6px;">
                                <a class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap" asp-action="EditCategory" asp-route-id="@c.Id" title="Chỉnh sửa nhóm">
                                    <i data-lucide="square-pen" class="me-1"></i><span>Sửa</span>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap btn-delete-category" 
                                        data-bs-toggle="modal" data-bs-target="#deleteCategoryModal" 
                                        data-id="@c.Id" data-title="@c.Title" data-count="@c.TopicCount" title="Xoá nhóm">
                                    <i data-lucide="trash-2" class="me-1"></i><span>Xoá</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Categories.Count == 0)
                {
                    <tr id="emptyCategoryRow"><td colspan="5" class="text-center text-muted py-4">Chưa có nhóm chủ đề nào.</td></tr>
                }
                <tr id="noCategoryMatchRow" style="display: none;">
                    <td colspan="5" class="text-center text-muted py-4"><i data-lucide="filter-x" class="me-2"></i>Không tìm thấy nhóm chủ đề nào phù hợp.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- [BẢNG 2] CHỦ ĐỀ -->
<div class="card shadow-sm">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-success"><i data-lucide="book-marked" class="me-1"></i>Chủ đề</span>
                <span id="topicGroupFilterLabel" class="text-muted small">
                    @(Model.SelectedCategoryId.HasValue ? "(đang lọc theo nhóm)" : "(tất cả)")
                </span>
                <span id="topicCountBadge" class="badge custom-count-badge ms-1">@Model.Topics.Count chủ đề</span>
            </div>
            @if (Model.SelectedCategoryId.HasValue)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index">
                    <i data-lucide="x" class="me-1"></i>Bỏ lọc nhóm URL
                </a>
            }
        </div>
    </div>

    <!-- Bộ lọc & tìm kiếm chủ đề -->
    <div class="p-3 border-bottom topic-filter-panel admin-filter-bar">
        <div class="row g-2 align-items-center">
            <div class="col-lg-4 col-md-5">
                <div class="input-group-search w-100">
                    <span class="search-icon"><i data-lucide="search"></i></span>
                    <input type="text" id="topicSearchInput" class="form-control" placeholder="Tìm kiếm tên chủ đề, nhóm, kỳ thi..." />
                </div>
            </div>
            <div class="col-lg-3 col-md-3">
                <select id="topicCategoryFilter" class="form-select">
                    <option value="">-- Tất cả nhóm chủ đề --</option>
                    @foreach (var c in Model.Categories)
                    {
                        <!option value="@c.Id" @(Model.SelectedCategoryId == c.Id ? "selected" : "")>@c.Title@(!c.IsActive ? " (Ẩn)" : "")</!option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-2">
                <select id="topicExamFilter" class="form-select">
                    <option value="">-- Tất cả kỳ thi --</option>
                    <option value="TOEIC">TOEIC</option>
                    <option value="VSTEP">VSTEP</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-2">
                <select id="topicStatusFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="active">Hiển thị</option>
                    <option value="inactive">Ẩn</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-12">
                <button type="button" id="btnResetTopicFilter" class="btn btn-outline-secondary btn-filter-reset w-100" title="Đặt lại bộ lọc">
                    <i data-lucide="rotate-ccw"></i>
                </button>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small filter-counter-text text-muted">
            <span>Đang hiển thị <strong id="visibleTopicCount" class="text-success">@Model.Topics.Count</strong> trên tổng số <strong>@Model.Topics.Count</strong> chủ đề</span>
        </div>
    </div>

    <!-- Thanh thao tác hàng loạt cho các chủ đề có dấu tích chọn -->
    <div id="bulkTopicActionBar" class="alert alert-info py-2 px-3 mx-3 mt-3 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-sm" style="display: none !important;">
        <div class="d-flex align-items-center gap-2">
            <i data-lucide="check-circle" class="text-primary fs-5"></i>
            <span>Đã chọn <strong id="selectedTopicsBadge" class="text-primary">0</strong> chủ đề</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-success rounded-pill px-3" id="btnBulkShowTopics">
                <i data-lucide="eye" class="me-1"></i>Hiện mục chọn
            </button>
            <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-3" id="btnBulkHideTopics">
                <i data-lucide="eye-off" class="me-1"></i>Ẩn mục chọn
            </button>
            <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" id="btnBulkDeleteTopics">
                <i data-lucide="trash-2" class="me-1"></i>Xoá mục chọn
            </button>
            <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted" id="btnClearTopicSelection">
                Bỏ chọn
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="topicTable">
            <thead>
                <tr>
                    <th style="width: 40px;" class="text-center">
                        <input type="checkbox" id="checkAllTopics" class="form-check-input" title="Chọn tất cả">
                    </th>
                    <th style="width: 60px;" class="text-center">STT</th>
                    <th>Chủ đề</th>
                    <th>Nhóm</th>
                    <th style="width: 140px;">Kỳ thi</th>
                    <th class="text-center" style="width: 110px;">Câu hỏi</th>
                    <th style="width: 120px;">Trạng thái</th>
                    <th class="text-end text-nowrap" style="width: 360px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int topicStt = 1; }
                @foreach (var t in Model.Topics)
                {
                    <tr class="topic-row"
                        data-id="@t.Id"
                        data-title="@t.Title.ToLower()"
                        data-category-id="@t.CategoryId"
                        data-category="@t.CategoryTitle.ToLower()"
                        data-exam="@t.ExamLabel.ToLower()"
                        data-status="@(t.IsActive ? "active" : "inactive")">
                        <td class="text-center">
                            <input type="checkbox" class="form-check-input topic-row-checkbox" value="@t.Id">
                        </td>
                        <td class="topic-stt text-center fw-semibold">@(topicStt++)</td>
                        <td class="fw-semibold">
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="topic-icon-box d-inline-flex align-items-center justify-content-center rounded" style="width: 30px; height: 30px; flex-shrink: 0;" title="Biểu tượng: @(string.IsNullOrWhiteSpace(t.Icon) ? "book-open" : t.Icon)">
                                    <i data-lucide="@(string.IsNullOrWhiteSpace(t.Icon) ? "book-open" : t.Icon)" style="width: 16px; height: 16px;"></i>
                                </span>
                                <span class="topic-title-text">@t.Title</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge custom-count-badge">@t.CategoryTitle</span>
                        </td>
                        <td>
                            <span class="small text-secondary">@t.ExamLabel</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill custom-count-badge text-primary">@t.QuestionCount câu</span>
                        </td>
                        <td class="topic-status-cell">
                            @if (t.IsActive)
                            {
                                <span class="badge text-bg-success"><i data-lucide="check-circle" class="me-1"></i>Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary"><i data-lucide="eye-off" class="me-1"></i>Ẩn</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex align-items-center justify-content-end" style="gap: 6px;">
                                <a class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap" asp-action="EditTheory" asp-route-topicId="@t.Id" title="Quản lý lý thuyết">
                                    <i data-lucide="book-open" class="me-1"></i><span>Lý thuyết</span>
                                </a>
                                <a class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap" asp-action="Questions" asp-route-topicId="@t.Id" title="Quản lý câu hỏi">
                                    <i data-lucide="list-checks" class="me-1"></i><span>Câu hỏi</span>
                                </a>
                                <a class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap" asp-action="EditTopic" asp-route-id="@t.Id" title="Chỉnh sửa chủ đề">
                                    <i data-lucide="square-pen" class="me-1"></i><span>Sửa</span>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap btn-delete-topic" 
                                        data-bs-toggle="modal" data-bs-target="#deleteTopicModal" 
                                        data-id="@t.Id" data-title="@t.Title" data-questions="@t.QuestionCount" title="Xoá chủ đề">
                                    <i data-lucide="trash-2" class="me-1"></i><span>Xoá</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Topics.Count == 0)
                {
                    <tr id="emptyTopicRow"><td colspan="8" class="text-center text-muted py-4">Chưa có chủ đề nào.</td></tr>
                }
                <tr id="noTopicMatchRow" style="display: none;">
                    <td colspan="8" class="text-center text-muted py-4"><i data-lucide="filter-x" class="me-2"></i>Không tìm thấy chủ đề nào phù hợp với bộ lọc.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal xác nhận xoá Nhóm chủ đề -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 60px; height: 60px;">
                        <i data-lucide="trash-2" class="fs-3"></i>
                    </span>
                </div>
                <h5 class="modal-title fw-bold mb-2" id="deleteCategoryModalTitle">Xác nhận xoá nhóm chủ đề</h5>
                <p class="text-secondary small mb-3">Bạn có chắc chắn muốn xoá nhóm chủ đề này không? Các chủ đề thuộc nhóm có thể bị ảnh hưởng.</p>

                <div class="p-3 modal-preview-box rounded-3 text-start mb-3">
                    <div class="small text-muted mb-1">Tên nhóm chủ đề:</div>
                    <div class="fw-bold text-break fs-6" id="modalCategoryTitle"></div>
                    <div class="small text-danger mt-1 fw-semibold" id="modalCategoryWarning"></div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Huỷ</button>
                    <form id="deleteCategoryForm" method="post" asp-action="DeleteCategory">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deleteCategoryIdInput" value="" />
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i data-lucide="trash-2" class="me-1"></i>Xác nhận xoá
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận xoá Chủ đề -->
<div class="modal fade" id="deleteTopicModal" tabindex="-1" aria-labelledby="deleteTopicModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 60px; height: 60px;">
                        <i data-lucide="trash-2" class="fs-3"></i>
                    </span>
                </div>
                <h5 class="modal-title fw-bold mb-2" id="deleteTopicModalTitle">Xác nhận xoá chủ đề</h5>
                <p class="text-secondary small mb-3">Bạn có chắc chắn muốn xoá chủ đề này không? Chủ đề sẽ được chuyển sang danh sách ẩn.</p>

                <div class="p-3 modal-preview-box rounded-3 text-start mb-3">
                    <div class="small text-muted mb-1">Tên chủ đề:</div>
                    <div class="fw-bold text-break fs-6" id="modalTopicTitle"></div>
                    <div class="small text-muted mt-1" id="modalTopicQuestions"></div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Huỷ</button>
                    <form id="deleteTopicForm" method="post" asp-action="DeleteTopic">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deleteTopicIdInput" value="" />
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i data-lucide="trash-2" class="me-1"></i>Xác nhận xoá
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận xoá hàng loạt chủ đề -->
<div class="modal fade" id="bulkDeleteTopicModal" tabindex="-1" aria-labelledby="bulkDeleteTopicModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 60px; height: 60px;">
                        <i data-lucide="alert-triangle" class="fs-3"></i>
                    </span>
                </div>
                <h5 class="modal-title fw-bold mb-2" id="bulkDeleteTopicModalTitle">Xác nhận xoá các chủ đề đã chọn</h5>
                <p class="text-secondary small mb-3">
                    Bạn đang chọn <strong id="modalBulkDeleteTopicCount" class="text-danger">0</strong> chủ đề. Bạn có chắc chắn muốn xoá tất cả các chủ đề này không?
                </p>

                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Huỷ</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" id="btnConfirmBulkDeleteTopics">
                        <i data-lucide="trash-2" class="me-1"></i>Xác nhận xoá
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="antiforgeryForm" hidden>@Html.AntiForgeryToken()</form>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const token = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]')?.value || "";

        // ==========================================
        // 1. BỘ LỌC & TÌM KIẾM NHÓM CHỦ ĐỀ
        // ==========================================
        const categorySearchInput = document.getElementById("categorySearchInput");
        const categoryStatusFilter = document.getElementById("categoryStatusFilter");
        const btnResetCategoryFilter = document.getElementById("btnResetCategoryFilter");
        const categoryRows = Array.from(document.querySelectorAll("#categoryTable tbody tr.category-row"));
        const noCategoryMatchRow = document.getElementById("noCategoryMatchRow");
        const categoryCountBadge = document.getElementById("categoryCountBadge");

        function filterCategories() {
            const query = (categorySearchInput?.value || "").trim().toLowerCase();
            const status = categoryStatusFilter?.value || "";

            let visibleCount = 0;
            categoryRows.forEach(row => {
                const title = row.getAttribute("data-title") || "";
                const rowStatus = row.getAttribute("data-status") || "";

                const matchQuery = !query || title.includes(query);
                const matchStatus = !status || rowStatus === status;

                if (matchQuery && matchStatus) {
                    row.style.display = "";
                    visibleCount++;
                    const sttCell = row.querySelector(".category-stt");
                    if (sttCell) sttCell.textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            if (noCategoryMatchRow) {
                noCategoryMatchRow.style.display = (visibleCount === 0 && categoryRows.length > 0) ? "" : "none";
            }
            if (categoryCountBadge) {
                categoryCountBadge.textContent = `${visibleCount}/${categoryRows.length} nhóm`;
            }
        }

        if (categorySearchInput) categorySearchInput.addEventListener("input", filterCategories);
        if (categoryStatusFilter) categoryStatusFilter.addEventListener("change", filterCategories);
        if (btnResetCategoryFilter) {
            btnResetCategoryFilter.addEventListener("click", function () {
                if (categorySearchInput) categorySearchInput.value = "";
                if (categoryStatusFilter) categoryStatusFilter.value = "";
                filterCategories();
            });
        }

        // ==========================================
        // 2. BỘ LỌC, TÌM KIẾM & CHỌN NHIỀU CHỦ ĐỀ
        // ==========================================
        const topicSearchInput = document.getElementById("topicSearchInput");
        const topicCategoryFilter = document.getElementById("topicCategoryFilter");
        const topicExamFilter = document.getElementById("topicExamFilter");
        const topicStatusFilter = document.getElementById("topicStatusFilter");
        const btnResetTopicFilter = document.getElementById("btnResetTopicFilter");
        const topicRows = Array.from(document.querySelectorAll("#topicTable tbody tr.topic-row"));
        const noTopicMatchRow = document.getElementById("noTopicMatchRow");
        const visibleTopicCount = document.getElementById("visibleTopicCount");
        const checkAllTopics = document.getElementById("checkAllTopics");
        const bulkTopicActionBar = document.getElementById("bulkTopicActionBar");
        const selectedTopicsBadge = document.getElementById("selectedTopicsBadge");
        const btnClearTopicSelection = document.getElementById("btnClearTopicSelection");
        const btnBulkShowTopics = document.getElementById("btnBulkShowTopics");
        const btnBulkHideTopics = document.getElementById("btnBulkHideTopics");
        const btnBulkDeleteTopics = document.getElementById("btnBulkDeleteTopics");

        function filterTopics() {
            const query = (topicSearchInput?.value || "").trim().toLowerCase();
            const categoryId = topicCategoryFilter?.value || "";
            const exam = (topicExamFilter?.value || "").trim().toLowerCase();
            const status = topicStatusFilter?.value || "";

            let visibleCount = 0;
            topicRows.forEach(row => {
                const title = row.getAttribute("data-title") || "";
                const rowCatId = row.getAttribute("data-category-id") || "";
                const rowCatTitle = row.getAttribute("data-category-title") || "";
                const rowExam = row.getAttribute("data-exam") || "";
                const rowStatus = row.getAttribute("data-status") || "";

                const matchQuery = !query || title.includes(query) || rowCatTitle.includes(query) || rowExam.includes(query);
                const matchCategory = !categoryId || rowCatId === categoryId;
                const matchExam = !exam || rowExam.includes(exam);
                const matchStatus = !status || rowStatus === status;

                if (matchQuery && matchCategory && matchExam && matchStatus) {
                    row.style.display = "";
                    visibleCount++;
                    // Đánh số thứ tự tăng dần liên tục cho các dòng hiển thị
                    const sttCell = row.querySelector(".topic-stt");
                    if (sttCell) sttCell.textContent = visibleCount;
                } else {
                    row.style.display = "none";
                    const cb = row.querySelector("input.topic-row-checkbox");
                    if (cb) cb.checked = false;
                    row.classList.remove("table-active");
                }
            });

            if (noTopicMatchRow) {
                noTopicMatchRow.style.display = (visibleCount === 0 && topicRows.length > 0) ? "" : "none";
            }
            if (visibleTopicCount) {
                visibleTopicCount.textContent = visibleCount;
            }

            updateSelectedTopicsState();
        }

        if (topicSearchInput) topicSearchInput.addEventListener("input", filterTopics);
        if (topicCategoryFilter) topicCategoryFilter.addEventListener("change", filterTopics);
        if (topicExamFilter) topicExamFilter.addEventListener("change", filterTopics);
        if (topicStatusFilter) topicStatusFilter.addEventListener("change", filterTopics);

        if (btnResetTopicFilter) {
            btnResetTopicFilter.addEventListener("click", function () {
                if (topicSearchInput) topicSearchInput.value = "";
                if (topicCategoryFilter) topicCategoryFilter.value = "";
                if (topicExamFilter) topicExamFilter.value = "";
                if (topicStatusFilter) topicStatusFilter.value = "";
                filterTopics();
            });
        }

        // ==========================================
        // 3. XỬ LÝ DẤU TÍCH CHỌN VÀ THAO TÁC HÀNG LOẠT
        // ==========================================
        function getSelectedTopicIds() {
            return Array.from(document.querySelectorAll("#topicTable tbody tr.topic-row input.topic-row-checkbox:checked"))
                .map(cb => parseInt(cb.value, 10))
                .filter(id => !isNaN(id));
        }

        function updateSelectedTopicsState() {
            const checkedBoxes = document.querySelectorAll("#topicTable tbody tr.topic-row:not([style*='display: none']) input.topic-row-checkbox:checked");
            const visibleBoxes = document.querySelectorAll("#topicTable tbody tr.topic-row:not([style*='display: none']) input.topic-row-checkbox");
            const count = checkedBoxes.length;

            if (selectedTopicsBadge) selectedTopicsBadge.textContent = count;

            if (bulkTopicActionBar) {
                if (count > 0) {
                    bulkTopicActionBar.style.setProperty("display", "flex", "important");
                } else {
                    bulkTopicActionBar.style.setProperty("display", "none", "important");
                }
            }

            if (checkAllTopics) {
                checkAllTopics.checked = visibleBoxes.length > 0 && checkedBoxes.length === visibleBoxes.length;
                checkAllTopics.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < visibleBoxes.length;
            }
        }

        // Chọn tất cả
        if (checkAllTopics) {
            checkAllTopics.addEventListener("change", function () {
                const isChecked = checkAllTopics.checked;
                topicRows.forEach(row => {
                    if (row.style.display !== "none") {
                        const cb = row.querySelector("input.topic-row-checkbox");
                        if (cb) {
                            cb.checked = isChecked;
                            if (isChecked) row.classList.add("table-active");
                            else row.classList.remove("table-active");
                        }
                    }
                });
                updateSelectedTopicsState();
            });
        }

        // Chọn từng ô
        document.getElementById("topicTable")?.addEventListener("change", function (e) {
            if (e.target && e.target.classList.contains("topic-row-checkbox")) {
                const row = e.target.closest("tr");
                if (row) {
                    if (e.target.checked) row.classList.add("table-active");
                    else row.classList.remove("table-active");
                }
                updateSelectedTopicsState();
            }
        });

        // Nút bỏ chọn
        if (btnClearTopicSelection) {
            btnClearTopicSelection.addEventListener("click", function () {
                topicRows.forEach(r => {
                    const cb = r.querySelector("input.topic-row-checkbox");
                    if (cb) cb.checked = false;
                    r.classList.remove("table-active");
                });
                updateSelectedTopicsState();
            });
        }

        // Thực hiện thao tác hàng loạt qua AJAX
        async function executeBulkTopicAction(action, confirmMsg) {
            const ids = getSelectedTopicIds();
            if (ids.length === 0) {
                alert("Vui lòng chọn ít nhất một chủ đề.");
                return;
            }
            if (confirmMsg && !confirm(confirmMsg)) {
                return;
            }

            try {
                const response = await fetch('@Url.Action("BulkUpdateTopics", "Grammar_management", new { area = "Admin" })', {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify({ ids: ids, action: action })
                });

                const data = await response.json();
                if (data && data.success) {
                    window.location.reload();
                } else {
                    alert(data?.message || "Có lỗi xảy ra khi thực hiện.");
                }
            } catch (err) {
                alert("Lỗi kết nối máy chủ. Vui lòng thử lại.");
            }
        }

        if (btnBulkShowTopics) {
            btnBulkShowTopics.addEventListener("click", () => executeBulkTopicAction("show", "Hiển thị các chủ đề đã chọn?"));
        }
        if (btnBulkHideTopics) {
            btnBulkHideTopics.addEventListener("click", () => executeBulkTopicAction("hide", "Ẩn các chủ đề đã chọn?"));
        }

        // ==========================================
        // 4. XỬ LÝ CÁC MODAL XOÁ
        // ==========================================
        // Modal xoá nhóm chủ đề
        const deleteCategoryModalEl = document.getElementById("deleteCategoryModal");
        if (deleteCategoryModalEl) {
            deleteCategoryModalEl.addEventListener("show.bs.modal", function (event) {
                const btn = event.relatedTarget || document.activeElement;
                if (btn && btn.classList && btn.classList.contains("btn-delete-category")) {
                    const id = btn.getAttribute("data-id");
                    const title = btn.getAttribute("data-title") || "";
                    const count = parseInt(btn.getAttribute("data-count") || "0", 10);
                    
                    const titleEl = document.getElementById("modalCategoryTitle");
                    if (titleEl) titleEl.textContent = title;

                    const warningEl = document.getElementById("modalCategoryWarning");
                    if (warningEl) {
                        warningEl.textContent = count > 0 
                            ? `Chú ý: Nhóm này hiện đang chứa ${count} chủ đề bên trong.` 
                            : "";
                    }

                    const inputId = document.getElementById("deleteCategoryIdInput");
                    if (inputId) inputId.value = id;
                }
            });
        }

        // Modal xoá chủ đề đơn
        const deleteTopicModalEl = document.getElementById("deleteTopicModal");
        if (deleteTopicModalEl) {
            deleteTopicModalEl.addEventListener("show.bs.modal", function (event) {
                const btn = event.relatedTarget || document.activeElement;
                if (btn && btn.classList && btn.classList.contains("btn-delete-topic")) {
                    const id = btn.getAttribute("data-id");
                    const title = btn.getAttribute("data-title") || "";
                    const questions = parseInt(btn.getAttribute("data-questions") || "0", 10);

                    const titleEl = document.getElementById("modalTopicTitle");
                    if (titleEl) titleEl.textContent = title;

                    const questionsEl = document.getElementById("modalTopicQuestions");
                    if (questionsEl) {
                        questionsEl.textContent = `Chủ đề này có ${questions} câu hỏi.`;
                    }

                    const inputId = document.getElementById("deleteTopicIdInput");
                    if (inputId) inputId.value = id;
                }
            });
        }

        // Modal xoá nhiều chủ đề
        const bulkDeleteTopicModalEl = document.getElementById("bulkDeleteTopicModal");
        const bulkDeleteTopicModal = bulkDeleteTopicModalEl ? new bootstrap.Modal(bulkDeleteTopicModalEl) : null;
        const modalBulkDeleteTopicCount = document.getElementById("modalBulkDeleteTopicCount");
        const btnConfirmBulkDeleteTopics = document.getElementById("btnConfirmBulkDeleteTopics");

        if (btnBulkDeleteTopics) {
            btnBulkDeleteTopics.addEventListener("click", function () {
                const ids = getSelectedTopicIds();
                if (ids.length === 0) {
                    alert("Vui lòng chọn ít nhất một chủ đề.");
                    return;
                }
                if (modalBulkDeleteTopicCount) {
                    modalBulkDeleteTopicCount.textContent = ids.length;
                }
                if (bulkDeleteTopicModal) {
                    bulkDeleteTopicModal.show();
                }
            });
        }

        if (btnConfirmBulkDeleteTopics) {
            btnConfirmBulkDeleteTopics.addEventListener("click", function () {
                if (bulkDeleteTopicModal) {
                    bulkDeleteTopicModal.hide();
                }
                executeBulkTopicAction("delete");
            });
        }

        // Khởi tạo chạy lọc nếu trang nạp có sẵn selectedCategoryId
        if (topicCategoryFilter && topicCategoryFilter.value) {
            filterTopics();
        }

        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>
}
