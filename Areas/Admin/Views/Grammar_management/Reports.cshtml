@model List<GrammarReportRow>
@{
    var showResolved = (bool)(ViewBag.ShowResolved ?? false);
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">&larr; Quay lại</a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
        <h1 class="h3 mb-0">Báo lỗi câu hỏi</h1>
        <a class="btn btn-outline-secondary" asp-action="Reports" asp-route-showResolved="@(!showResolved)">
            @(showResolved ? "Chỉ hiện chưa xử lý" : "Hiện cả đã xử lý")
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Thời gian</th><th>Học viên</th><th>Câu hỏi</th><th>Nội dung báo lỗi</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="text-nowrap">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@r.UserName</td>
                        <td>
                            <div class="small text-muted">@r.TopicTitle</div>
                            <div>@r.QuestionContent</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(r.ReportType) && r.ReportType != "UserGrammarReport")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-1">@r.ReportType</span>
                            }
                            <span>@r.Details</span>
                        </td>
                        <td>@if (r.IsResolved) { <span class="badge text-bg-success">Đã xử lý</span> } else { <span class="badge text-bg-warning">Mới</span> }</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditQuestion" asp-route-id="@r.QuestionId">Sửa câu</a>
                            @if (!r.IsResolved)
                            {
                                <form method="post" asp-action="ResolveReport" asp-route-id="@r.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Đã xử lý</button>
                                </form>
                            }
                            <form method="post" asp-action="DeleteReport" asp-route-id="@r.Id" class="d-inline" onsubmit="return confirm('Xoá báo lỗi này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Không có báo lỗi nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
